<%- include('partials/head-meta', {
    title: 'El Club · Área de miembros',
    description: 'Tu área de miembros del Club de Oficios Circulares.',
    canonical: '/club/dentro',
    noindex: true
}) %>

<link rel="stylesheet" href="/assets/css/club-area.css?v=20260731b">
<%
  var featured = pieces.find(function(p){ return p.group === 'empieza'; });
  var rest = pieces.filter(function(p){ return p.group !== 'empieza'; });
  var localPart = (email || '').split('@')[0];
  var nombre = (member && member.name) ? member.name
             : (localPart ? localPart.charAt(0).toUpperCase() + localPart.slice(1) : '');
  // Mapa slug -> portada (las portadas llevan el título integrado; ratio 16:10)
  var covers = {
    'guia-primera-victoria': 'guia-primera-victoria.jpg',
    'leccion-01-foto-de-producto': 'leccion-01.jpg',
    'leccion-02-tu-primer-reel': 'leccion-02.jpg',
    'leccion-03-precios-con-margen': 'leccion-03.jpg',
    'leccion-04-la-bio-que-vende': 'leccion-04.jpg',
    'biblioteca-plantillas': 'biblioteca.jpg',
    'reto-01-doce-reels': 'reto-01.jpg',
    'radar-ayudas': 'radar.jpg',
    'mapa-del-contenido': 'mapa.jpg'
  };
  var videoBienvenida = config && config.video_bienvenida_url;
  var fechaDirecto = config && config.proximo_directo_fecha;
%>

<main class="club-area">
  <header class="ca-top">
    <a class="ca-brand" href="/club/dentro">
      <img src="/assets/images/logodegraoscuro.png" alt="Oficios Circulares">
      <span>El Club</span>
    </a>
    <div class="ca-top-actions">
      <span style="color:var(--tinta-suave);"><%= email %></span>
      <a class="ca-salir" href="/club/salir">Salir</a>
    </div>
  </header>

  <!-- 1. Hero de bienvenida -->
  <section class="ca-hero">
    <div class="ca-hero-bg" style="background-image:url('/assets/images/club/hero-2.jpg')"></div>
    <div class="ca-hero-veil"></div>
    <div class="ca-hero-inner">
      <span class="ca-eyebrow">El Club de Oficios Circulares · Tu taller</span>
      <h1>Bienvenido/a al taller<em><%= nombre %></em></h1>
      <p class="ca-hero-ctx">Máximo dos horas a la semana. El Club trabaja para tu taller, no al revés.</p>
      <% if (member && member.founder_number) { %>
        <div class="ca-placa">
          <img src="/assets/images/logodegraoscuro.png" alt="">
          <span>Fundador · Plaza Nº <%= member.founder_number %> de <%= config.plazas_totales %></span>
        </div>
      <% } %>
      <% if (videoBienvenida) { %>
        <div class="ca-bienvenida" data-video="<%= videoBienvenida %>" style="background-image:url('/assets/images/club/hero-4.jpg')" role="button" tabindex="0" aria-label="Reproducir el vídeo de bienvenida">
          <div class="ca-play"><span class="ca-play-btn" aria-hidden="true"></span></div>
          <span class="ca-play-label">Un minuto de bienvenida</span>
        </div>
      <% } %>
    </div>
  </section>

  <div class="ca-wrap">
    <!-- 2. Tu primera victoria -->
    <% if (featured) { %>
      <div class="ca-featured wow" id="victoria">
        <div class="ca-featured-body">
          <!-- Estado en progreso -->
          <div class="ca-victoria-progress">
            <span class="ca-kicker">Empieza aquí</span>
            <h2><%= featured.title %></h2>
            <p class="ca-featured-lead"><%= featured.desc %></p>
            <ul class="ca-check" id="victoriaCheck">
              <li><label class="ca-check-item"><input type="checkbox" data-victoria="0"><span class="ca-check-box" aria-hidden="true"></span><span class="ca-check-txt">Me he presentado en el chat con una foto de mi taller</span></label></li>
              <li><label class="ca-check-item"><input type="checkbox" data-victoria="1"><span class="ca-check-box" aria-hidden="true"></span><span class="ca-check-txt">Tengo apuntado el primer directo</span></label></li>
              <li><label class="ca-check-item"><input type="checkbox" data-victoria="2"><span class="ca-check-box" aria-hidden="true"></span><span class="ca-check-txt">Leí la guía y elegí mi ruta</span></label></li>
              <li><label class="ca-check-item"><input type="checkbox" data-victoria="3"><span class="ca-check-box" aria-hidden="true"></span><span class="ca-check-txt">Hice mis 3 fotos (lección 01)</span></label></li>
              <li><label class="ca-check-item"><input type="checkbox" data-victoria="4"><span class="ca-check-box" aria-hidden="true"></span><span class="ca-check-txt">Publiqué mi primera pieza contada</span></label></li>
            </ul>
            <div class="ca-progress">
              <div class="ca-progress-track"><div class="ca-progress-fill" id="victoriaFill"></div></div>
              <span class="ca-progress-num" id="victoriaNum">0 de 5</span>
            </div>
            <a class="ca-featured-link" href="/club/dentro/lecciones/<%= featured.slug %>">Abrir la guía completa →</a>
          </div>
          <!-- Estado conseguido (reencuadre hacia constancia) -->
          <div class="ca-victoria-done">
            <span class="ca-kicker"><span class="ca-done-sello" aria-hidden="true">✓</span> Primera victoria conseguida</span>
            <h2>Ya sabes hacerlo. Ahora viene lo que cambia el taller.</h2>
            <p class="ca-featured-lead">Publicar una pieza bien contada era el arranque, no la meta. Lo que mueve un taller de verdad es la constancia — y eso no se hace solo.</p>
            <p class="ca-featured-lead">Tu siguiente paso: el reto del trimestre y el directo de este mes. Ahí es donde esto se convierte en oficio.</p>
            <div class="ca-done-cta">
              <a class="ca-btn ca-btn--arena" href="/club/dentro/lecciones/reto-01-doce-reels">Ver el reto →</a>
              <a class="ca-btn ca-btn--ghost-arena" href="#este-mes">El directo de este mes →</a>
            </div>
          </div>
        </div>
        <div class="ca-featured-cover" style="background-image:url('/assets/images/club/covers/<%= covers[featured.slug] %>')"></div>
      </div>
    <% } %>

    <!-- 3. La estantería -->
    <h2 class="ca-section-title wow">La estantería</h2>
    <div class="ca-shelf">
      <% rest.forEach(function(p, i){ %>
        <a class="ca-book wow" href="/club/dentro/lecciones/<%= p.slug %>">
          <div class="ca-book-cover"><img src="/assets/images/club/covers/<%= covers[p.slug] %>" alt="<%= p.title %>"<% if (i > 1) { %> loading="lazy"<% } %>></div>
          <div class="ca-book-band">
            <p><%= p.desc %></p>
            <span class="ca-go">Abrir →</span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>

  <!-- 4. Este mes en el Club -->
  <section class="ca-mes-band" id="este-mes">
    <div class="ca-wrap">
      <h2 class="ca-section-title wow">Este mes en el Club</h2>
      <div class="ca-mes">
        <div class="ca-mes-card wow">
          <h3>El directo del mes</h3>
          <span class="ca-fecha"><%= (config && config.proximo_directo) || 'Por anunciar' %></span>
          <% if (fechaDirecto) { %><div class="ca-count" data-fecha="<%= fechaDirecto %>"></div><% } %>
          <p>Revisión en vivo de perfiles y tiendas. Pide tu turno con <span class="ca-hash">#revisión</span> en el chat.</p>
        </div>
        <div class="ca-mes-card wow">
          <h3>El chat del Club</h3>
          <% if (config && config.telegram_invite_url) { %>
            <p>Preguntas a las diez de la noche y te contesta alguien que ha pasado por lo mismo.</p>
            <a class="ca-btn ca-btn--arena" href="<%= config.telegram_invite_url %>" target="_blank" rel="noopener">Unirme al grupo →</a>
          <% } else { %>
            <p>El grupo se estrena con la primera hornada — te llegará el enlace por correo.</p>
          <% } %>
        </div>
        <div class="ca-mes-card wow">
          <h3>Se vota la próxima lección</h3>
          <ul class="ca-vota">
            <li>WhatsApp Business</li>
            <li>Etsy vs tienda propia</li>
            <li>Ferias que venden</li>
            <li>Email básico</li>
          </ul>
          <p>Vota con <span class="ca-hash">#pido</span> en el chat.</p>
        </div>
      </div>
      <div class="ca-radar-nota wow">
        <p>Cada trimestre revisamos las ayudas de tu comunidad por ti — es lo que no vas a encontrar en ningún otro sitio. <a href="/club/dentro/lecciones/radar-ayudas">Ver el radar de ayudas →</a></p>
      </div>
      <div class="ca-foot">
        <span>¿Necesitas gestionar tu suscripción? <a href="<%= billingPortal %>" target="_blank" rel="noopener">Abrir el portal</a>.</span>
        <a href="/club/salir">Cerrar sesión</a>
      </div>
    </div>
  </section>
</main>

<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Entrada escalonada
  var wow = Array.prototype.slice.call(document.querySelectorAll('.wow'));
  if (reduce || !('IntersectionObserver' in window)) {
    wow.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    }, {threshold: 0.08});
    wow.forEach(function(el, i){ el.style.transitionDelay = Math.min(i, 6) * 80 + 'ms'; io.observe(el); });
  }

  // Checklist "primera victoria" (localStorage)
  var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-victoria]'));
  var fill = document.getElementById('victoriaFill');
  var num = document.getElementById('victoriaNum');
  var card = document.getElementById('victoria');
  // Clave nueva: el checklist cambió de orden/significado; no reutilizar el progreso viejo.
  var KEY = 'clubPrimeraVictoria2';
  function loadState(){ try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch(e){ return {}; } }
  function saveState(s){ try { localStorage.setItem(KEY, JSON.stringify(s)); } catch(e){} }
  function render(){
    var done = boxes.filter(function(b){ return b.checked; }).length;
    if (fill) fill.style.width = (boxes.length ? (done / boxes.length * 100) : 0) + '%';
    if (num) num.textContent = done + ' de ' + boxes.length;
    var complete = boxes.length > 0 && done === boxes.length;
    if (card) card.classList.toggle('is-done', complete);
  }
  if (boxes.length) {
    var state = loadState();
    boxes.forEach(function(b){
      var i = b.getAttribute('data-victoria');
      if (state[i]) b.checked = true;
      b.addEventListener('change', function(){ state[i] = b.checked; saveState(state); render(); });
    });
    render();
  }

  // Cuenta atrás del directo
  var cnt = document.querySelector('[data-fecha]');
  if (cnt) {
    var target = new Date(cnt.getAttribute('data-fecha'));
    if (!isNaN(target.getTime())) {
      var now = new Date();
      var days = Math.round((new Date(target.getFullYear(), target.getMonth(), target.getDate())
                 - new Date(now.getFullYear(), now.getMonth(), now.getDate())) / 86400000);
      cnt.textContent = days > 1 ? ('Faltan ' + days + ' días') : (days === 1 ? 'Es mañana' : (days === 0 ? 'Es hoy' : ''));
    }
  }

  // Vídeo de bienvenida (click-to-play)
  var biv = document.querySelector('.ca-bienvenida');
  if (biv) {
    var playVideo = function(){
      var url = biv.getAttribute('data-video');
      if (!url) return;
      var v = document.createElement('video');
      v.src = url; v.controls = true; v.autoplay = true; v.setAttribute('playsinline', '');
      v.style.width = '100%'; v.style.height = '100%';
      biv.innerHTML = ''; biv.appendChild(v); biv.style.cursor = 'default';
    };
    biv.addEventListener('click', playVideo);
    biv.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); playVideo(); } });
  }
})();
</script>
