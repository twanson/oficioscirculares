<%#
  /servicios/sprint-3d — plantilla «directa» del sistema oc-landing (docs/sistema-landing.md).
  Textos: los que ya tenía la página. Sin precio todavía: «Cómo se llega al precio».
  La garantía sigue pendiente de decisión de Jose (docs/encargo-nov-2026.md, punto 12).
%>
<%
  const IMG = '/assets/images/landing/sprint/';
  const contacto = c => '/contacto?service=sprint-3d&oc_source=site&oc_medium=organic&oc_campaign=oc-sprint-3d&oc_content=' + c + '&page_path=/servicios/sprint-3d';
  const minicaso = '/downloads/mini-caso-sprint-3d.pdf';
%>
<%- include('partials/head-meta', {
    title: 'Sprint 3D · Piloto circular en 4 semanas | Oficios Circulares',
    description: 'Ejecutamos un piloto circular y lo convertimos en caso publicable con landing, ficha, creativos y email. KPIs operativos y de mercado, sin greenwashing.',
    canonical: '/servicios/sprint-3d',
    ogImage: 'https://www.oficioscirculares.com/img/servicios/sprint3d-hero.png',
    ogImageAlt: 'Sprint 3D de Oficios Circulares: piloto y kit comercial en 3–4 semanas',
    precargaImagen: IMG + 'hero-sprint-ilustracion.webp'
}) %>
<link rel="stylesheet" href="/assets/css/oc-landing.css?v=20261125a">
<%- include('partials/header') %>

<main class="oc-landing" id="maincontent">
  <%- include('partials/landing-hero', {
      img: IMG + 'hero-sprint-ilustracion.webp', ancho: 1000, alto: 1000, partida: true, alt: 'Tablero de un piloto con notas de ficha, landing y caso, y una mano que marca el lanzamiento',
      badge: 'Sprint 3D · Implementación + comunicación',
      titulo: 'Lo hacemos realidad <em>y te ayudamos a contarlo</em>',
      sub: 'En 4 semanas tu mejora circular está funcionando, documentada con datos reales y con todo preparado para que el mundo lo sepa.',
      ctas: [
        { href: contacto('hero'), texto: 'Reservar Sprint 3D →', clase: 'terracota', id: 'cta-hero', label: 'sprint3d-hero' },
        { href: minicaso, texto: 'Ver un ejemplo', clase: 'ghost', id: 'cta-hero-case' }
      ],
      datos: 'En 4 semanas · Piloto con datos reales · Precio cerrado tras el Diagnóstico'
  }) %>

  <!-- Qué te llevas en 4 semanas: cajas con imagen -->
  <section class="cajas" id="incluye">
    <div class="cab">
      <span class="eyebrow">Entregables</span>
      <h2>Qué te llevas <em>en 4 semanas</em></h2>
    </div>
    <div class="wrap">
      <div class="cajas-grid cajas-grid--dos">
        <div class="caja caja--dark reveal">
          <div class="caja-foto caja-foto--doc"><img loading="lazy" src="<%= IMG %>caja-operacion-piloto.webp" alt="Los cinco pasos del piloto en el ejemplo ilustrativo, del acopio a la pieza final" width="900" height="562"></div>
          <div class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <span class="num">Operación</span>
          <h3>Tu mejora circular funcionando</h3>
          <ul>
            <li>Mejora puesta en marcha y medida (ej: recuperación de recortes, servicio de reparación)</li>
            <li>Datos reales: kg recuperados, dinero ahorrado, clientes satisfechos</li>
            <li>Proceso documentado para poder replicarlo</li>
            <li>Proveedor y proceso validado y funcionando</li>
          </ul>
        </div>
        <div class="caja caja--light reveal">
          <div class="caja-foto caja-foto--doc"><img loading="lazy" src="<%= IMG %>caja-comunicacion-kit.webp" alt="Las piezas del kit comercial en el ejemplo ilustrativo: landing, ficha, email, caso y reel" width="900" height="562"></div>
          <div class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg></div>
          <span class="num">Comunicación</span>
          <h3>Todo lo que necesitas para contarlo</h3>
          <ul>
            <li>Landing page con tu caso y datos reales</li>
            <li>Ficha técnica con especificaciones y datos clave</li>
            <li>Kit de prescripción técnica para profesionales (si aplica)</li>
            <li>Contenido para redes: tu caso contado en 5 posts + 1 reel</li>
            <li>Email para anunciar la novedad a tus contactos</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos en 4 semanas -->
  <section class="pasos pasos--oscuro" id="metodologia">
    <div class="cab">
      <span class="eyebrow">Metodología</span>
      <h2>Cómo trabajamos <em>en 4 semanas</em></h2>
    </div>
    <div class="wrap">
      <div class="pasos-grid">
        <div class="paso reveal"><div class="bola">1</div><div class="cuando">Semana 1</div><h3>Arrancamos</h3><p>Ponemos en marcha la mejora en tu taller · Configuramos cómo medir los resultados · Resolvemos lo que surja sobre la marcha · Primeros datos y ajustes</p></div>
        <div class="paso reveal"><div class="bola">2</div><div class="cuando">Semana 2</div><h3>Ajustamos</h3><p>Refinamos el proceso con los primeros resultados · Documentamos lo que funciona para que puedas replicarlo · Preparamos todo para escalar si decides hacerlo · Calculamos los resultados del piloto</p></div>
        <div class="paso reveal"><div class="bola">3</div><div class="cuando">Semana 3</div><h3>Creamos los materiales</h3><p>Desarrollamos tu landing con el caso documentado · Creamos la ficha técnica y materiales profesionales · Diseñamos el contenido para redes · Preparamos el email de lanzamiento</p></div>
        <div class="paso reveal"><div class="bola">4</div><div class="cuando">Semana 4</div><h3>Lanzamos</h3><p>Publicamos todo · Lanzamos la comunicación · Te enseñamos a usar los materiales · Te entregamos el sistema completo funcionando</p></div>
      </div>
    </div>
  </section>

  <!-- Tiene sentido si… (como lista, no como relato) -->
  <section class="oc-encaje" id="encaje">
    <div class="wrap">
      <h2>Tiene sentido <em>si…</em></h2>
      <div class="quien-grid">
        <div class="quien-col si reveal">
          <h3>Tiene sentido si…</h3>
          <ul>
            <li><strong>Ya sabes qué quieres implementar</strong> y necesitas que funcione seguro</li>
            <li><strong>Quieres tener un caso documentado</strong> para diferenciarte de la competencia</li>
            <li><strong>Necesitas contenido y materiales</strong> profesionales para comunicarlo</li>
            <li><strong>Prefieres delegar la implementación</strong> a expertos mientras tú sigues produciendo</li>
          </ul>
        </div>
        <div class="caja caja--accent caja--sinfoto reveal">
          <span class="num">Para no confundirlos</span>
          <h3>¿En qué se diferencia?</h3>
          <p><strong>Diagnóstico</strong> — Descubrimos qué puedes hacer</p>
          <p><strong>Roadmap</strong> — Diseñamos cómo hacerlo (2 semanas)</p>
          <p><strong>Sprint</strong> — Lo ponemos en marcha y creamos todo para contarlo (4 semanas)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- El entregable, con la imagen del documento -->
  <section class="oc-documento" id="entregable">
    <div class="wrap">
      <div class="oc-documento-img reveal"><img loading="lazy" src="<%= IMG %>documento-portada.webp" alt="Portada del ejemplo ilustrativo de Sprint 3D" width="700" height="991"></div>
      <div class="reveal">
        <span class="eyebrow eyebrow--arena">Detalle</span>
        <h2>Todo lo que <em>recibes</em></h2>
        <ul>
          <li>Tu mejora funcionando con datos reales</li>
          <li>Landing page con tu caso y fotos del proceso</li>
          <li>Ficha técnica con especificaciones y datos clave</li>
          <li>Kit de prescripción técnica (planos si aplica)</li>
          <li>Caso documentado: antes, después y resultados</li>
          <li>Reel de 30s mostrando el proceso</li>
          <li>5 posts para redes con el lanzamiento</li>
          <li>Email para anunciar la novedad a tus contactos</li>
          <li>Guía para que tu equipo sepa usar los materiales</li>
        </ul>
        <a id="cta-entregable-case" class="club-btn club-btn--arena" href="<%= minicaso %>" data-event="file_download" data-label="sprint3d-entregable-caso">Ver un ejemplo</a>
      </div>
    </div>
  </section>

  <!-- Prueba: cifras de la red, con su fecha -->
  <%- include('partials/landing-cifras', { impacto, ids: ['altas_conecta_lana', 'emparejamientos', 'material_con_salida'], titulo: 'La red, con fecha', claro: true }) %>

  <!-- Cómo se llega al precio -->
  <section class="precios" id="precio">
    <div class="cab">
      <span class="eyebrow">Inversión</span>
      <h2>Cómo se llega <em>al precio</em></h2>
    </div>
    <div class="wrap oc-camino-wrap">
      <div class="oc-camino-foto reveal"><img loading="lazy" src="<%= IMG %>precio-alcance.webp" alt="Página del ejemplo ilustrativo con lo que incluye el Sprint y lo que no" width="900" height="720"></div>
      <ol class="oc-camino oc-camino--lista">
        <li class="reveal"><span class="n">1</span><b>Diagnóstico</b><span>Detectamos las oportunidades y cuál conviene hacer primero.</span></li>
        <li class="reveal"><span class="n">2</span><b>Propuesta cerrada</b><span>Te enviamos alcance, plazo y precio cerrados para el Sprint.</span></li>
        <li class="reveal"><span class="n">3</span><b>Decides</b><span>Solo entonces decides si seguimos.</span></li>
      </ol>
    </div>
    <p class="oc-camino-nota"><strong>Qué recibes a cambio:</strong> nos encargamos de la implementación contigo, los materiales de comunicación listados arriba y un caso documentado que puedes usar a largo plazo. <strong>Garantía:</strong> si el piloto no funciona como esperado, seguimos trabajando hasta que funcione. Sin coste adicional.</p>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="faq" id="faq">
    <div class="wrap-n">
      <h2>Preguntas <em>frecuentes</em></h2>
      <details><summary>¿Y si durante la implementación surgen problemas?</summary><p class="resp">Es normal. Por eso lo hacemos contigo: los resolvemos juntos durante las cuatro semanas.</p></details>
      <details><summary>¿Podemos hacer el Sprint sin Roadmap previo?</summary><p class="resp">Sí, incluimos una fase de planificación intensiva en la primera semana.</p></details>
      <details><summary>¿Qué pasa después de las 4 semanas?</summary><p class="resp">Tienes todo funcionando y documentado para seguir tú. Opcionalmente ofrecemos acompañamiento mensual para escalar.</p></details>
    </div>
  </section>

  <%- include('partials/landing-final', {
      img: IMG + 'cierre-baldosa.webp',
      eyebrow: 'Siguiente paso',
      titulo: '¿Damos el paso? <em>En 4 semanas, funcionando</em>',
      texto: 'En 4 semanas tendrás tu mejora funcionando, datos reales y todo preparado para contarlo.',
      cta: { href: contacto('footer'), texto: 'Reservar Sprint 3D →', id: 'cta-footer', label: 'sprint3d-footer' },
      pd: '<a id="cta-footer-question" href="https://tally.so/r/nPxWM0?utm_source=site&utm_medium=organic&utm_campaign=oc-sprint-3d&utm_content=footer-question&page_path=/servicios/sprint-3d" target="_blank" rel="noopener">Tengo una pregunta</a>'
  }) %>
</main>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Sprint 3D",
  "provider": { "@type": "Organization", "name": "Oficios Circulares" },
  "areaServed": "ES",
  "serviceType": "Consulting",
  "offers": precios.pendiente('sprint_3d') ? undefined : { "@type": "Offer", "price": String(precios.num('sprint_3d')), "priceCurrency": "EUR" },
  "url": "https://www.oficioscirculares.com/servicios/sprint-3d"
}, null, 2) %>
</script>

<%- include('partials/footer') %>
<script src="/assets/js/oc-landing.js?v=20261122" defer></script>
<%- include('partials/landing-tracking', { campaign: 'oc-sprint-3d', offer: 'sprint-3d', ids: { 'cta-hero': 'hero', 'cta-hero-case': 'hero', 'cta-entregable-case': 'entregable', 'cta-footer': 'footer' } }) %>
</body>
</html>
