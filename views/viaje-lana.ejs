<%
/* ===================================================================
   EL VIAJE DE LA LANA — página-hub de la experiencia guiada (/viaje/lana)
   Copys aprobados: Redes/Instagram/Carruseles/2026-08_viaje-de-la-lana/
                    guion_viaje-de-la-lana_v01.md
   Patrón visual: views/conecta-lana.ejs (foto a sangre + degradado teñido)
                  views/club.ejs (reveals al scroll)
   =================================================================== */

// URL del post de Instagram del viaje. PENDIENTE: pegarla aquí al publicar.
// Mientras esté vacía, el CTA "Vuelve al post" no se renderiza.
const POST_URL = '';
%>
<%- include('partials/head-meta', {
    title: 'El Viaje de la Lana | Oficios Circulares',
    description: 'Una experiencia guiada de 15-20 minutos: de la mejor lana de Europa pagada a céntimos al jersey de lujo de 1.500 €. Descubre qué pasa por el camino.',
    canonical: '/viaje/lana',
    ogImage: 'https://www.oficioscirculares.com/assets/images/viaje-lana/og-viaje-lana.jpg',
    ogImageAlt: 'Esquila a tijera de una oveja — El Viaje de la Lana, Oficios Circulares'
}) %>

<style>
/* ===================================================================
   EL VIAJE DE LA LANA — página inmersiva standalone.
   CSS 100% scoped bajo .vj para aislarlo del CSS global del sitio.
   Mobile-first: ~95% del tráfico llega desde el link de la bio de IG.
   =================================================================== */

/* position:sticky se rompe si un ancestro es contenedor de scroll. El body
   global usa overflow-x:hidden; clip recorta el desbordamiento horizontal
   SIN crear contenedor de scroll (mismo fix que en conecta-lana.ejs). */
html,body{overflow-x:clip}
body{background:#fbf9f8}

.vj{
  --primary:#023429;--primary-2:#1F4B3F;--verde-hoja:#3E7C59;
  --secondary:#934a1c;--secondary-claro:#e0885a;--marron:#7d573c;--marron-2:#9a5530;--oro:#f6c98a;
  --crema:#fbf6ec;--arena:#E8D5B7;--surface:#fbf9f8;
  --on:#1b1c1c;--on-var:#414845;
  --f-head:'Newsreader',Georgia,serif;--f-body:'Manrope',sans-serif;--f-ui:'Nunito',sans-serif;
  --bar:56px;--cab:56px;
  /* Tokens calcados de home-v2.css para que el viaje y la home sean el mismo sistema */
  --glass:rgba(251,249,248,.88);--r-card:16px;--r-quote:14px;
  --sombra-card:0 24px 64px rgba(0,0,0,.12);--sombra-quote:0 12px 32px rgba(0,0,0,.2);
  font-family:var(--f-body);color:var(--on);line-height:1.62;-webkit-font-smoothing:antialiased;background:var(--surface)
}
/* :where() deja el reset con especificidad 0 en la parte del tipo, así que
   cualquier regla de una sola clase (.vj-cierre, .vj-nota…) puede recuperar
   sus márgenes. Con `.vj p{margin:0}` ganaba el reset y los bloques perdían
   el `margin:auto` — se pegaban al margen izquierdo. */
.vj :where(h1,h2,h3,h4,p){margin:0}
/* Los enlaces sin clase heredan color; los que llevan clase mandan sobre su
   propio color (si no, `.vj a` gana por especificidad y los deja ilegibles). */
.vj a{text-decoration:none}
.vj a:not([class]){color:inherit}
.vj img{display:block}
.vj :focus-visible{outline:3px solid var(--oro);outline-offset:3px;border-radius:6px}

/* Ancho de lectura editorial */
.vj-w{max-width:68ch;margin:0 auto}

/* ============ CABECERA STICKY (chrome mínimo + progreso) ============ */
/* La barra va por encima de TODO el contenido: además del z-index alto,
   `main` abre su propio contexto de apilamiento (z-index:0), así que ningún
   z-index ni transform de dentro puede escalar por encima de ella. */
.vj-bar{position:sticky;top:0;z-index:100;background:#03231b;border-bottom:1px solid rgba(246,201,138,.2);box-shadow:0 6px 22px rgba(2,32,25,.34)}
.vj-main{position:relative;z-index:0}
.vj-bar-in{display:flex;align-items:center;justify-content:space-between;gap:12px;height:var(--bar);padding:0 14px;max-width:1100px;margin:0 auto}
.vj-brand{display:flex;align-items:center;gap:9px;min-width:0}
.vj-brand img{height:26px;width:auto;filter:drop-shadow(0 2px 8px rgba(0,0,0,.5))}
.vj-brand b{font-family:var(--f-ui);font-weight:800;font-size:.8rem;color:var(--crema);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vj-bar-est{font-family:var(--f-ui);font-weight:800;font-size:.72rem;letter-spacing:.04em;color:var(--oro);white-space:nowrap}
.vj-track{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(246,201,138,.16)}
.vj-fill{height:100%;width:0;background:linear-gradient(90deg,#3E7C59,#f6c98a);transition:width .55s cubic-bezier(.4,0,.2,1)}
@media(max-width:359px){.vj-brand b{display:none}}
@media(min-width:640px){
  .vj-bar-in{padding:0 24px}
  .vj-brand img{height:32px}.vj-brand b{font-size:.94rem}
  .vj-bar-est{font-size:.84rem}
}


/* ── Heros al patrón de la home: foto a sangre + tarjeta glass. El lado
      alterna por parada (izq-dcha-izq-dcha): asimetría y sensación de camino. ── */
.vj-est-hero-in{position:relative;z-index:2;width:100%;max-width:1100px;margin:0 auto;display:flex}
.vj-est-hero--izq .vj-est-hero-in{justify-content:flex-start}
.vj-est-hero--dcha .vj-est-hero-in{justify-content:flex-end}
.vj-herocard{position:relative;max-width:30rem;padding:30px 28px;border-radius:var(--r-card);background:rgba(251,249,248,.95);border:1px solid rgba(255,255,255,.2);box-shadow:var(--sombra-card)}
.vj-heroline{margin-top:12px!important;font-family:var(--f-ui);font-weight:700;font-size:1.02rem;letter-spacing:.01em;color:var(--on-var)}
.vj-herochip{display:inline-flex;align-items:center;gap:8px;margin-top:20px;padding:8px 16px;border-radius:100px;background:rgba(2,52,41,.07);font-family:var(--f-ui);font-weight:700;font-size:.86rem;color:var(--primary)}
.vj-herochip b{font-family:var(--f-head);font-weight:600;font-size:1.06rem;color:var(--secondary)}
/* Sobre cristal claro el titular va en verde, no en blanco */
.vj-est-hero .vj-herocard h2{color:var(--primary);text-shadow:none;font-size:clamp(2.4rem,9vw,3.8rem)}
.vj-est-hero .vj-herocard h2 em{color:var(--secondary)}
/* El degradado se suaviza: ya no hace de fondo del texto, solo asienta la foto */
.vj-est-hero::after{background:linear-gradient(180deg,rgba(2,40,31,.18) 0%,rgba(2,40,31,.1) 45%,rgba(2,40,31,.42) 100%)!important}
.vj-est--noche .vj-est-hero::after{background:linear-gradient(180deg,rgba(8,24,44,.28) 0%,rgba(8,24,44,.16) 45%,rgba(5,16,32,.5) 100%)!important}
.vj-est--ocre .vj-est-hero::after,.vj-est--final .vj-est-hero::after{background:linear-gradient(180deg,rgba(58,28,10,.22) 0%,rgba(58,28,10,.12) 45%,rgba(52,24,8,.48) 100%)!important}
/* El blur de verdad, solo donde compensa: pantallas grandes */
@media(min-width:760px){
  .vj-herocard{padding:44px 46px;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
  .vj-kilo{background:rgba(2,32,25,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
}
@media(max-width:600px){.vj-heroline{font-size:.98rem}}

/* ═══════════════ ESCENAS SCROLL-DRIVEN (E1-E3) ═══════════════
   Doble contrato: SIN .vj-gsap (sin JS, sin GSAP o reduced-motion) las
   escenas son columnas estáticas, todo visible. CON .vj-gsap, GSAP toma el
   mando: pin + scrub, y los estados iniciales los fija el propio motor. */

/* ── E1 · Apertura ── */
.vj-e1{position:relative;background:#04130f;color:var(--crema)}
.vj-e1-pin{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;overflow:hidden}
.vj-e1-media{position:absolute;inset:0}
.vj-e1-foto{width:100%;height:100%;object-fit:cover}
.vj-e1-velo{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,19,15,.55),rgba(4,19,15,.68) 60%,rgba(4,19,15,.86))}
.vj-e1-textos{position:relative;z-index:2;width:100%;max-width:660px;margin:0 auto;padding:96px 26px 72px;text-align:center}
.vj-e1-t{font-family:var(--f-head);font-weight:600;font-size:clamp(1.7rem,6.4vw,2.9rem);line-height:1.22;letter-spacing:-.015em;color:#fff;text-shadow:0 3px 30px rgba(0,0,0,.5);max-width:19ch;margin:0 auto}
.vj-e1-t em{font-style:italic;color:var(--secondary-claro)}
.vj-e1-titulo h1{font-family:var(--f-head);font-size:clamp(3.2rem,13vw,5.6rem);font-weight:700;color:#fff;line-height:.96;letter-spacing:-.025em;text-shadow:0 3px 30px rgba(0,0,0,.45);margin:18px 0 0}
.vj-e1-titulo h1 em{font-style:italic;font-weight:600;color:var(--secondary-claro)}
.vj-e1-sub{margin:18px auto 0!important;max-width:38ch;font-size:1.15rem;line-height:1.55;color:rgba(255,255,255,.93);text-shadow:0 2px 14px rgba(0,0,0,.5)}
.vj-e1-titulo .vj-tip{margin-top:18px}
.vj-e1-titulo .vj-start{margin-top:24px}
.vj-e1-hilo{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:min(390px,80vw);height:200px;z-index:1;pointer-events:none}
.vj-e1-hilo .vj-hilo-draw{stroke:var(--secondary-claro);stroke-width:2.5;filter:drop-shadow(0 0 6px rgba(224,136,90,.35))}
/* estático: las frases fluyen una bajo otra con aire */
.vj-e1-t + .vj-e1-t{margin-top:26px}
.vj-e1-titulo{margin-top:34px}
/* modo escena: todas apiladas en el mismo sitio, GSAP las turna */
/* En modo escena, cada pin mide EXACTAMENTE un viewport: si el contenido es
   más alto (el embed real del reel), se recorta — nunca estira la escena. */
.vj-gsap .vj-e1-pin,.vj-gsap .vj-e2-pin,.vj-gsap .vj-tr-pin,.vj-gsap .vj-e5-pin,.vj-gsap .vj-e6-pin,.vj-gsap .vj-e7-pin,.vj-gsap .vj-e9-pin{height:100svh;min-height:0;overflow:hidden}
.vj-gsap .vj-e1-textos{display:grid;place-items:center;min-height:100svh;padding:56px 26px}
.vj-gsap .vj-e1-textos>*{grid-area:1/1;margin:0 auto}
/* estados iniciales sin destello: el CSS deja la escena como GSAP la va a
   encontrar; cuando el motor arranca, sus estilos inline toman el relevo */
.vj-gsap .vj-e1-foto{opacity:0;transform:scale(1.15)}
.vj-gsap .vj-e1-t[data-e1="2"],.vj-gsap .vj-e1-t[data-e1="3"],.vj-gsap .vj-e1-titulo{opacity:0;visibility:hidden}
.vj-gsap .vj-e2-cinewrap{opacity:0;visibility:hidden}
.vj-gsap .vj-e2-nota{opacity:0;visibility:hidden}

/* ── E2 · La nave ── */
.vj-e2{position:relative;background:#062018}
.vj-e2-pin{position:relative;min-height:100svh;overflow:hidden;display:flex;align-items:center}
.vj-e2-bg{position:absolute;inset:-6% 0}
.vj-e2-bg img{width:100%;height:100%;object-fit:cover}
.vj-e2-grad{position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,32,25,.62),rgba(2,32,25,.78) 55%,rgba(2,25,19,.92))}
.vj-e2-in{position:relative;z-index:2;width:100%;max-width:1100px;margin:0 auto;padding:88px 22px 56px;display:flex;flex-direction:column;align-items:center;gap:26px}
.vj-e2-cinewrap{text-align:center;max-width:540px}
.vj-e2-cinewrap .vj-cine-lead{margin-bottom:22px!important}
.vj-e2-cinewrap .vj-cine-badge{margin-bottom:20px}
.vj-e2-nota{max-width:420px}
.vj-e2-nota .vj-nota{margin:0;background:rgba(246,201,138,.12);color:rgba(251,246,236,.9);border-left-color:var(--oro)}
@media(max-width:1023.98px){
  .vj-e2 .vj-media{max-width:min(320px,38vh)}
  .vj-e2-cinewrap .vj-cine-lead{font-size:clamp(1.15rem,4vw,1.3rem)}
  /* en modo escena la nota es un panel inferior sólido que entra al final.
     El contenedor interior deja de ser containing block: el panel ancla a la
     ESCENA (100svh), no al contenido, que es más alto que el viewport. */
  .vj-gsap .vj-e2-in{position:static}
  .vj-gsap .vj-e2-cinewrap{position:relative;z-index:2}
  .vj-gsap .vj-e2-nota{position:absolute;left:0;right:0;bottom:0;max-width:none;padding:30px 22px 84px;background:linear-gradient(180deg,rgba(2,25,19,0),rgba(2,25,19,.96) 16%);z-index:3}
  .vj-gsap .vj-e2-nota .vj-nota{max-width:540px;margin:0 auto;font-size:.99rem}
}
@media(min-width:1024px){
  .vj-e2-in{flex-direction:row;justify-content:center;align-items:center;gap:56px}
  .vj-e2-cinewrap{flex:0 0 auto}
  .vj-e2-nota{flex:0 1 34rem}
  .vj-e2-nota .vj-nota{font-size:1.18rem;line-height:1.7;padding:24px 28px}
}
/* ── E3 · Profundiza ── */
.vj-e3{background:var(--surface);padding:clamp(56px,9vh,88px) 22px}
.vj-e3 .vj-est-body{padding:0}

/* ═══════════════ ESCENAS E4-E9 ═══════════════
   Mismo contrato: sin .vj-gsap todo es columna estática legible. */
.vj-ey--luz{background:rgba(251,246,236,.14);color:var(--crema)}

/* E4/E8 · transiciones */
.vj-tr-pin{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:64px 22px;text-align:center}
.vj-tr-fondo{position:absolute;inset:0}
.vj-tr-fondo--a{background:var(--crema)}
.vj-tr--seva .vj-tr-fondo--b{background:linear-gradient(180deg,#0a1c33,#050f1f)}
.vj-tr--regreso .vj-tr-fondo--b{background:linear-gradient(180deg,#3a1c0a,#241105)}
.vj-tr-hilo{position:absolute;left:50%;top:0;transform:translateX(-50%);height:100%;width:min(300px,60vw);pointer-events:none}
.vj-hilo-draw{stroke:var(--secondary-claro);stroke-width:2.5;filter:drop-shadow(0 0 6px rgba(224,136,90,.3))}
.vj-tr-frase{position:relative;z-index:2;max-width:17ch;margin:0 auto;font-family:var(--f-head);font-weight:600;font-size:clamp(1.9rem,7vw,3rem);line-height:1.2;color:#fff;letter-spacing:-.015em;text-shadow:0 3px 30px rgba(0,0,0,.55)}
.vj-tr-frase em{font-style:italic;color:var(--secondary-claro)}

/* E5 · el puerto */
.vj-e5{background:#050f1f}
.vj-e5-pin{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden}
.vj-e5-bg{position:absolute;inset:0}
.vj-e5-bg img{width:106%;height:100%;object-fit:cover}
.vj-e5-velo{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,12,26,.3),rgba(5,12,26,.44) 55%,rgba(4,10,22,.88))}
.vj-e5-in{position:relative;z-index:2;width:100%;max-width:720px;margin:0 auto;padding:0 26px clamp(56px,10vh,96px);text-align:center}
.vj-e5-texto{margin-top:16px!important;font-family:var(--f-head);font-weight:600;font-size:clamp(1.35rem,4.8vw,2rem);line-height:1.36;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.55)}

/* E6 · Ramón */
.vj-e6{background:#050e1c}
.vj-e6-pin{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:76px 24px}
.vj-e6-bg{position:absolute;inset:0;opacity:.18}
.vj-e6-bg img{width:100%;height:100%;object-fit:cover}
.vj-e6-in{position:relative;z-index:2;width:100%;max-width:640px;margin:0 auto;text-align:center}
.vj-e6-in>*+*{margin-top:38px}
.vj-gsap .vj-e6-in{display:grid;place-items:center}
.vj-gsap .vj-e6-in>*{grid-area:1/1;margin:0}
.vj-e6-cabecera h2{font-family:var(--f-head);font-size:clamp(2.2rem,8.4vw,3.6rem);color:#fff;font-weight:700;line-height:1.02;margin:10px 0 14px}
.vj-e6-cabecera h2 em{font-style:italic;color:var(--secondary-claro)}
.vj-e6-byline{color:rgba(251,246,236,.8);font-size:1.08rem;line-height:1.5;max-width:44ch;margin:0 auto 18px!important}
.vj-e6 .vj-ramon-fuente{background:rgba(246,201,138,.1);border-color:rgba(246,201,138,.3);color:rgba(251,246,236,.85)!important;max-width:46ch;margin-left:auto!important;margin-right:auto!important}
.vj-e6 .vj-ramon-fuente b{color:var(--oro)}
.vj-e6-beat{max-width:560px;margin-left:auto;margin-right:auto}
.vj-e6-n{display:inline-flex;width:40px;height:40px;border-radius:50%;background:rgba(224,136,90,.16);border:1px solid rgba(224,136,90,.45);color:var(--secondary-claro);font-family:var(--f-head);font-style:italic;align-items:center;justify-content:center;font-size:1.25rem;margin-bottom:16px}
.vj-e6-beat h3{font-family:var(--f-head);font-style:italic;font-size:clamp(1.5rem,5.8vw,2.2rem);color:#fff;font-weight:600;line-height:1.22;margin:0 0 14px}
.vj-e6-beat p{color:rgba(251,246,236,.86);font-size:1.14rem;line-height:1.62}
.vj-e6-cita blockquote{font-family:var(--f-head);font-style:italic;font-weight:500;font-size:clamp(1.55rem,6vw,2.5rem);line-height:1.28;color:#fff;margin:0}
.vj-e6-cita .vj-firma{margin-top:18px!important;color:rgba(251,246,236,.72)!important}
.vj-e6-remate{background:#050e1c;padding:0 24px clamp(48px,8vh,72px);text-align:center}
.vj-e6-remate .vj-ramon-remate{max-width:56ch;margin:0 auto!important;color:rgba(251,246,236,.93)!important}
.vj-e6-remate .vj-ramon-remate strong{color:#fff}

/* E7 · la escalera, parte 1 */
.vj-e7{background:var(--surface)}
.vj-e7-pin{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:center;overflow:hidden;padding:80px 24px}
.vj-e7-cab{text-align:center;margin-bottom:8px}
.vj-e7-peldanos{position:relative;z-index:2;display:flex;flex-direction:column;gap:18px;max-width:1000px;margin:18px auto 0;width:100%}
.vj-e7-peldano{background:#fff;border:1px solid rgba(2,52,41,.08);border-left:4px solid var(--secondary);border-radius:var(--r-card);box-shadow:var(--sombra-card);padding:26px 24px;max-width:520px}
.vj-e7-peldano[data-paso="2"]{align-self:flex-end}
.vj-e7-cifra{display:block;font-family:var(--f-head);font-weight:600;font-size:clamp(2.2rem,8vw,3.4rem);color:var(--secondary);line-height:1;margin-bottom:6px}
.vj-e7-cifra small{font-size:.42em;opacity:.85}
.vj-e7-cifra--txt{font-style:italic;font-size:clamp(1.8rem,6vw,2.6rem)}
.vj-e7-peldano h3{font-family:var(--f-ui);font-weight:800;font-size:1.2rem;color:var(--primary);margin:0 0 10px}
.vj-e7-peldano p{color:var(--on-var);font-size:1.1rem;line-height:1.6;margin:0}
.vj-e7-hilo{position:absolute;right:8%;top:10%;height:80%;width:min(120px,18vw);pointer-events:none;z-index:1}
@media(min-width:900px){
  .vj-e7-peldano[data-paso="2"]{margin-top:-56px;margin-right:4%}
  .vj-e7-peldano[data-paso="1"]{margin-left:4%}
}

/* E9 · el escaparate, la vitrina */
.vj-e9{background:#241105}
.vj-e9-pin{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;padding:76px 22px 40px;text-align:center}
.vj-e9-bg{position:absolute;inset:0}
.vj-e9-bg img{width:100%;height:100%;object-fit:cover}
.vj-e9-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(38,20,8,.62),rgba(30,15,6,.72) 55%,rgba(24,12,5,.9))}
.vj-e9-puerta{position:absolute;top:0;bottom:0;width:51%;z-index:2;background:linear-gradient(180deg,#2c1407,#1c0c04)}
.vj-e9-puerta--izq{left:0;box-shadow:inset -40px 0 60px rgba(0,0,0,.4)}
.vj-e9-puerta--dcha{right:0;box-shadow:inset 40px 0 60px rgba(0,0,0,.4)}
.vj-e9-in{position:relative;z-index:3;max-width:680px;padding:26px 24px;border-radius:24px;background:radial-gradient(90% 100% at 50% 50%,rgba(24,12,5,.5),rgba(24,12,5,0))}
.vj-e9-contador{margin:16px 0 20px}
.vj-e9-contador b{font-family:var(--f-head);font-weight:700;font-size:clamp(3rem,14vw,6.4rem);color:#fff;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;text-shadow:0 4px 40px rgba(0,0,0,.55)}
.vj-e9 .vj-salto-q{color:#fff!important;font-size:clamp(1.2rem,4.4vw,1.5rem)!important;text-shadow:0 2px 14px rgba(0,0,0,.5)}
.vj-e9 .vj-salto-q em{color:var(--secondary-claro)}
.vj-e9 .vj-salto-n{color:rgba(251,246,236,.78)!important;max-width:46ch;margin:12px auto 0!important;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.vj-e9-peldanos{position:relative;z-index:3;display:flex;gap:14px;margin-top:30px;flex-wrap:wrap;justify-content:center}
.vj-e9-peldano{background:rgba(251,249,248,.96);border-radius:var(--r-card);box-shadow:var(--sombra-card);padding:18px 20px;max-width:310px;text-align:left;border-left:4px solid var(--secondary)}
.vj-e9-peldano b{font-family:var(--f-head);font-weight:600;font-size:1.7rem;color:var(--secondary);line-height:1}
.vj-e9-peldano b small{font-size:.55em;opacity:.85}
.vj-e9-peldano h3{font-family:var(--f-ui);font-weight:800;font-size:1.06rem;color:var(--primary);margin:6px 0 8px}
.vj-e9-peldano p{font-size:.98rem;color:var(--on-var);line-height:1.52;margin:0}
@media(max-width:600px){.vj-e9-peldano p{font-size:.92rem}.vj-e9-peldano{padding:14px 16px}}

/* E2 · segmento de hilo que cose la costura con E1 */
.vj-e2-hilo{position:absolute;left:50%;top:0;transform:translateX(-50%);width:60px;height:clamp(110px,16vh,150px);z-index:1;pointer-events:none}

/* ============= EL MARCADOR DEL KILO (píldora flotante) =============
   Fuera la segunda barra: robaba altura y aplanaba la cabecera. Ahora es una
   píldora discreta abajo-izquierda, con el mismo cristal que la home. */
.vj-kilo{position:fixed;left:16px;bottom:16px;z-index:80;display:flex;align-items:center;gap:10px;padding:10px 16px 10px 13px;border-radius:100px;background:rgba(2,32,25,.94);border:1px solid rgba(246,201,138,.3);box-shadow:0 12px 32px rgba(0,0,0,.28);font-family:var(--f-ui);opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease}
.vj-kilo.vj-kilo--on{opacity:1;transform:none}
.vj-kilo[hidden]{display:none}
.vj-kilo-ic{font-size:1.05rem;line-height:1}
.vj-kilo-txt{display:flex;align-items:baseline;gap:7px;white-space:nowrap}
.vj-kilo-k{font-weight:800;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(251,246,236,.6)}
.vj-kilo-v{font-family:var(--f-head);font-weight:600;font-size:1.06rem;color:var(--oro);font-variant-numeric:tabular-nums;transition:transform .3s ease}
.vj-kilo--late .vj-kilo-v{transform:scale(1.14)}
.vj-kilo-n{display:none}
@media(min-width:760px){
  .vj-kilo{left:24px;bottom:24px;padding:12px 20px 12px 16px}
  .vj-kilo-v{font-size:1.2rem}
  .vj-kilo-n{display:block;max-width:22ch;font-size:.72rem;line-height:1.35;color:rgba(251,246,236,.55);white-space:normal}
  .vj-kilo-n:empty{display:none}
}
@media(prefers-reduced-motion:reduce){.vj-kilo,.vj-kilo-v{transition:none}}

/* ============= INTERLUDIOS (foto a sangre + una frase) ============= */
.vj-inter{position:relative;min-height:74svh;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:clamp(64px,10vh,96px) 22px;text-align:center}
.vj-inter>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.vj-inter::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(2,32,25,.72),rgba(2,32,25,.82))}
.vj-inter--noche::after{background:linear-gradient(180deg,rgba(8,24,44,.74),rgba(6,18,36,.86))}
.vj-inter--ocre::after{background:linear-gradient(180deg,rgba(58,28,10,.7),rgba(44,20,7,.86))}
.vj-inter-in{position:relative;z-index:2}
.vj-inter-frase{max-width:min(100%,17ch);margin:0 auto!important;font-family:var(--f-head);font-size:clamp(1.7rem,6vw,2.8rem);font-weight:600;line-height:1.2;color:#fff;letter-spacing:-.015em;text-shadow:0 3px 30px rgba(0,0,0,.5)}
.vj-inter-frase em{font-style:italic;color:var(--secondary-claro)}
.vj-inter-btn{margin-top:34px;white-space:nowrap;background:rgba(251,246,236,.14);border:1px solid rgba(246,201,138,.5);color:var(--crema)}
.vj-inter-btn:hover{background:rgba(251,246,236,.18)}
.vj-inter-btn.vj-hecho{background:linear-gradient(135deg,#3E7C59,#1F4B3F);border-color:transparent}

/* Foto de apoyo dentro de un tramo */
.vj-figura{margin:26px auto 0;max-width:540px}
.vj-figura img{width:100%;height:auto;border-radius:20px;box-shadow:0 18px 44px rgba(2,52,41,.2)}
.vj-figura figcaption{margin-top:12px;font-size:.98rem;line-height:1.5;color:var(--on-var);text-align:center}

/* ===================== INTRO (above the fold) ===================== */
.vj-intro{position:relative;min-height:calc(100svh - var(--cab));display:flex;align-items:flex-end;overflow:hidden;padding:72px 22px 36px}
.vj-intro-media{position:absolute;inset:0;z-index:0}
.vj-intro-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.vj-intro-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,40,31,.42) 0%,rgba(2,40,31,.24) 34%,rgba(2,40,31,.82) 76%,rgba(2,40,31,.95) 100%)}
.vj-intro-in{position:relative;z-index:2;width:100%;max-width:660px;margin:0 auto}
.vj-kicker{display:inline-flex;align-items:center;gap:9px;padding:6px 15px 6px 7px;border-radius:100px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.2);margin-bottom:20px}
.vj-kicker img{height:22px;width:auto;filter:drop-shadow(0 2px 8px rgba(0,0,0,.5))}
.vj-kicker span{color:#fff;font-family:var(--f-ui);font-weight:800;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase}
.vj-intro h1{font-family:var(--f-head);font-size:clamp(3.4rem,14vw,6rem);font-weight:700;color:#fff;line-height:.94;letter-spacing:-.025em;text-shadow:0 3px 30px rgba(0,0,0,.45)}
.vj-intro h1 em{font-style:italic;font-weight:600;color:var(--secondary-claro)}
.vj-intro .vj-hook{margin-top:16px;font-family:var(--f-ui);font-weight:800;font-size:clamp(1.25rem,5vw,1.7rem);line-height:1.3;color:#fff;text-shadow:0 2px 16px rgba(0,0,0,.5)}
.vj-intro .vj-sub{margin-top:16px;color:rgba(255,255,255,.93);font-size:1.15rem;line-height:1.55;text-shadow:0 2px 14px rgba(0,0,0,.5)}
.vj-tip{display:inline-flex;align-items:flex-start;gap:9px;margin-top:18px;padding:11px 16px;border-radius:14px;background:rgba(2,40,31,.72);border:1px solid rgba(246,201,138,.34);color:var(--crema);font-size:.92rem;line-height:1.45}
.vj-tip b{color:var(--oro)}
.vj-start{display:inline-flex;align-items:center;gap:9px;margin-top:26px;padding:16px 28px;border-radius:100px;background:var(--secondary);color:#fff;box-shadow:0 6px 20px rgba(147,74,28,.4);font-family:var(--f-ui);font-weight:800;font-size:1.06rem;box-shadow:0 14px 34px rgba(0,0,0,.34);transition:transform .22s ease,filter .22s ease}
.vj-start:hover{transform:translateY(-2px);filter:brightness(1.05)}

/* ======================= EL CAMINO (ruta) ======================= */
.vj-camino{position:relative;height:clamp(84px,11vh,116px);background:var(--surface)}
.vj-linea{position:absolute;inset:0;width:100%;height:100%}
.vj-linea path{fill:none;stroke-linecap:round;vector-effect:non-scaling-stroke}
.vj-linea-base{stroke:rgba(2,52,41,.22);stroke-width:2.4;stroke-dasharray:1.6 6}
/* dasharray/dashoffset los fija el JS con la altura real del tramo: con
   vector-effect:non-scaling-stroke el patrón se mide en píxeles de pantalla,
   no en unidades del viewBox. Sin JS, la línea sale dibujada del todo. */
.vj-linea-draw{stroke:var(--verde-hoja);stroke-width:2.6;transition:stroke-dashoffset 1.15s cubic-bezier(.4,0,.2,1),stroke .6s ease}
.vj-hito{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:var(--surface);border:2px solid rgba(2,52,41,.24);display:flex;align-items:center;justify-content:center;color:var(--primary-2);box-shadow:0 4px 16px rgba(2,52,41,.1);transition:background .45s ease,color .45s ease,border-color .45s ease,box-shadow .45s ease}
.vj-hito svg{width:26px;height:26px;display:block}
.vj-hito.vj-done{background:var(--primary);border-color:var(--primary);color:var(--oro);box-shadow:0 8px 24px rgba(2,52,41,.32);animation:vj-pop .45s cubic-bezier(.34,1.56,.64,1)}
@keyframes vj-pop{0%{transform:translate(-50%,-50%) scale(1)}45%{transform:translate(-50%,-50%) scale(1.22)}100%{transform:translate(-50%,-50%) scale(1)}}
/* Microcelebración: al completar las 4, toda la ruta se ilumina en oro */
.vj.vj-fin .vj-linea-draw{stroke:var(--oro);stroke-width:3}
.vj.vj-fin .vj-hito.vj-done{background:linear-gradient(140deg,#3E7C59,#023429);border-color:var(--oro);box-shadow:0 0 0 5px rgba(246,201,138,.28),0 8px 26px rgba(2,52,41,.3)}

/* ======================== ESTACIONES ======================== */
.vj-est,.vj-inter,.vj-final{scroll-margin-top:calc(var(--cab) + 18px)}
.vj-camino{scroll-margin-top:calc(var(--cab) + 18px)}
.vj-est-hero{position:relative;min-height:47vh;display:flex;align-items:flex-end;overflow:hidden;padding:78px 22px 26px}
.vj-est-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0}
.vj-est-hero::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(2,40,31,.3) 0%,rgba(2,40,31,.18) 30%,rgba(2,40,31,.86) 82%,rgba(2,40,31,.96) 100%)}
.vj-est--verde .vj-est-hero::after{background:linear-gradient(180deg,rgba(2,40,31,.32) 0%,rgba(2,40,31,.2) 30%,rgba(2,40,31,.86) 82%,rgba(2,40,31,.96) 100%)}
.vj-est--noche .vj-est-hero::after{background:linear-gradient(180deg,rgba(8,24,44,.42) 0%,rgba(8,24,44,.3) 28%,rgba(5,16,32,.88) 80%,rgba(4,12,26,.97) 100%)}
.vj-est--ocre .vj-est-hero::after{background:linear-gradient(180deg,rgba(58,30,12,.34) 0%,rgba(58,30,12,.2) 30%,rgba(74,38,15,.86) 82%,rgba(74,38,15,.96) 100%)}
/* Estación 4: teñido más denso y cálido. La foto de atardecer llega lavada y
   el final tiene que sentirse distinto del principio, no una repetición. */
.vj-est--final .vj-est-hero img{filter:saturate(1.12) contrast(1.06)}
.vj-est--final .vj-est-hero::after{background:linear-gradient(180deg,rgba(96,44,12,.5) 0%,rgba(112,54,16,.42) 26%,rgba(66,30,10,.9) 76%,rgba(48,21,7,.98) 100%)}
.vj-est-hero-in{position:relative;z-index:2;width:100%;max-width:660px;margin:0 auto}
.vj-ey{display:inline-block;padding:6px 16px;border-radius:100px;background:rgba(147,74,28,.14);font-family:var(--f-ui);font-weight:700;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--secondary);margin-bottom:14px}
.vj-est-hero h2{font-family:var(--f-head);font-size:clamp(2.8rem,11vw,4.8rem);font-weight:700;color:#fff;line-height:.98;letter-spacing:-.02em;text-shadow:0 3px 26px rgba(0,0,0,.45)}
.vj-est-hero h2 em{font-style:italic;color:var(--secondary-claro)}
.vj-est-body{padding:34px 22px 0;background:var(--surface)}
.vj-est-body p{font-size:1.19rem;color:var(--on-var);line-height:1.7}
.vj-est-body p+p{margin-top:16px}
.vj-est-body .vj-lead{font-size:clamp(1.3rem,4.5vw,1.5rem);color:var(--on);line-height:1.5}
.vj-est-body .vj-lead em{font-style:italic;color:var(--secondary);font-weight:600}
.vj-est-body h3{font-family:var(--f-ui);font-weight:800;font-size:1.35rem;color:var(--primary);margin:30px 0 12px}

/* Botón "siguiente estación" (cierra cada bloque) */
.vj-next-wrap{padding:32px 22px 34px;text-align:center;background:var(--surface)}
.vj-next{display:inline-flex;align-items:center;gap:10px;padding:16px 30px;border:0;cursor:pointer;border-radius:100px;background:var(--primary);color:#f6ecd9;font-family:var(--f-ui);font-weight:800;font-size:1.04rem;box-shadow:0 12px 30px rgba(2,52,41,.24);transition:transform .22s ease,box-shadow .22s ease,background .3s ease}
.vj-next:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(2,52,41,.3)}
.vj-next.vj-hecho{background:linear-gradient(135deg,#3E7C59,#1F4B3F)}
.vj-next--oro{background:var(--secondary);color:#fff;box-shadow:0 6px 20px rgba(147,74,28,.4)}
.vj-next--oro.vj-hecho{background:var(--secondary)}

/* ---------- Estación 1: la sala de cine ----------
   Banda oscura a todo el ancho: el reel es el momento cumbre del viaje y
   necesita escenario, no una tarjeta suelta sobre fondo claro. */
.vj-cine{background:radial-gradient(120% 80% at 50% 0%,#0a3327 0%,#052018 62%,#03150f 100%);padding:clamp(40px,6vh,60px) 22px 44px;text-align:center}
.vj-cine-lead{max-width:34ch;margin:0 auto 30px!important;font-size:clamp(1.3rem,4.5vw,1.5rem);line-height:1.5;color:var(--crema)}
.vj-cine-lead em{font-style:italic;color:var(--oro);font-weight:600}
.vj-cine-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;border-radius:100px;background:rgba(246,201,138,.14);border:1px solid rgba(246,201,138,.42);color:var(--oro);font-family:var(--f-ui);font-weight:800;font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:22px}
/* El tope en vh evita que el cartel 9:16 (o el propio reel) se coma la
   pantalla en viewports bajos — y mantiene el cartel del mismo tamaño que su
   contenedor, sin marco vacío alrededor. */
.vj-media{margin:0 auto;max-width:min(420px,44vh)}
/* Rejilla de una sola celda: el cartel y el embed se apilan ahí. La altura de
   la fila es siempre la del más alto, así que el contenedor NUNCA puede quedar
   más bajo que el cartel. Esta es la garantía de que no se ve una caja vacía:
   está en el layout, no en un callback de JS que pueda congelarse. */
.vj-ig{position:relative;display:grid;border-radius:22px;box-shadow:0 30px 70px rgba(0,0,0,.55),0 0 0 1px rgba(246,201,138,.16)}
/* embed.js sustituye el blockquote por un iframe conservando la clase: el
   selector cubre los dos estados para que nunca desborde en 375 px. */
.vj-ig .instagram-media{margin:0 auto!important;max-width:100%!important;min-width:0!important;width:100%!important;border-radius:22px!important}
/* El embed vive superpuesto e invisible hasta que PINTA de verdad: así tiene
   ancho real para medirse, pero nunca deja un hueco blanco en la página. */
/* Mientras no manda, el embed va fuera de flujo: así no estira la caja antes
   de tiempo. Al ceder el sitio entra en la celda y la fila crece con él. */
.vj-ig-embed{position:absolute;inset:0;opacity:0;pointer-events:none;overflow:hidden;border-radius:22px;transition:opacity .3s ease}
.vj-ig.vj-ig-ok .vj-ig-embed{position:relative;grid-area:1/1;z-index:1;opacity:1;pointer-events:auto;overflow:visible}
/* El cartel NUNCA se borra: se queda debajo, marcando el alto mínimo y
   tapando cualquier hueco si el iframe pintara transparente o se cayera.
   Solo se retira su enlace, para no dejar foco atrapado tras el embed. */
.vj-ig-card{grid-area:1/1;z-index:0}
.vj-ig.vj-ig-ok .vj-ig-card a{display:none}
/* Cartel del reel: es el estado por defecto, no un plan B feo. */
.vj-ig-card{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;aspect-ratio:9/16;padding:28px 22px;border-radius:22px;overflow:hidden;background:#06251c}
.vj-ig-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5}
.vj-ig-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,25,19,.6),rgba(3,25,19,.9))}
.vj-ig-card>*{position:relative;z-index:2}
.vj-ig-play{flex:0 0 auto;width:72px;height:72px;border-radius:50%;background:var(--secondary);color:#fff!important;display:flex;align-items:center;justify-content:center;color:#023429;font-size:1.6rem;box-shadow:0 14px 34px rgba(0,0,0,.45)}
.vj-ig-card b{font-family:var(--f-head);font-size:clamp(1.15rem,4.4vw,1.5rem);font-weight:600;color:#fff;line-height:1.2;max-width:16ch}
.vj-ig-card small{color:rgba(251,246,236,.76);font-size:.9rem;line-height:1.45;max-width:26ch}
.vj .vj-ig-card a{display:inline-flex;align-items:center;gap:8px;margin-top:2px;padding:13px 22px;border-radius:100px;background:var(--secondary);color:#fff;font-family:var(--f-ui);font-weight:800;font-size:.95rem;white-space:nowrap}
.vj-cine .vj-nota{margin-top:24px;border-left-color:var(--oro);background:rgba(246,201,138,.1);color:rgba(251,246,236,.86);text-align:left;max-width:460px}
.vj-nota{margin:20px auto 0;max-width:540px;padding:18px 22px;border-left:3px solid var(--oro);background:rgba(246,201,138,.14);border-radius:0 14px 14px 0;font-size:1.05rem;line-height:1.6;color:var(--on-var)}
.vj-det{margin:26px auto 0;max-width:540px;border:1px solid rgba(2,52,41,.14);border-radius:16px;background:#fff;overflow:hidden}
.vj-det summary{cursor:pointer;list-style:none;padding:19px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-family:var(--f-ui);font-weight:800;font-size:1.1rem;color:var(--primary)}
.vj-det summary::-webkit-details-marker{display:none}
.vj-det summary::after{content:"↓";color:var(--secondary);font-size:1.1rem;transition:transform .25s ease}
.vj-det[open] summary::after{transform:rotate(180deg)}
.vj-det-in{padding:0 16px 18px}
.vj-yt{position:relative;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#0d0d0d}
.vj-yt iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vj-det-in p{font-size:1.05rem!important;color:var(--on-var);margin-top:16px!important;line-height:1.6}
/* Especificidad de 2 clases para ganar a `.vj a{text-decoration:none}` */
.vj .vj-det-link{display:inline-block;margin-top:14px;font-family:var(--f-ui);font-weight:700;font-size:.98rem;line-height:1.45;color:var(--secondary);text-decoration:underline;text-underline-offset:3px}
.vj .vj-det-link:hover{color:var(--marron-2)}

/* ---------- Estación 2: paseo detective ---------- */
.vj-marcas{display:flex;flex-direction:column;gap:12px;margin:24px auto 0;max-width:540px}
.vj-marca{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:19px 24px;border-radius:16px;background:linear-gradient(150deg,#0a2a21,#03201a);color:var(--crema);font-family:var(--f-ui);font-weight:800;font-size:1.16rem;box-shadow:0 12px 30px rgba(2,52,41,.2);transition:transform .22s ease,box-shadow .22s ease}
.vj-marca:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(2,52,41,.28)}
.vj-marca span{color:var(--oro);font-size:.9rem;font-weight:700;white-space:nowrap}
.vj-check{margin:26px auto 0;max-width:540px;padding:22px 22px 10px;border-radius:var(--r-card);background:#fff;border:1px solid rgba(2,52,41,.08);box-shadow:var(--sombra-card)}
.vj-check-t{font-family:var(--f-ui);font-weight:800;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--secondary);margin-bottom:14px}
.vj-check label{display:flex;align-items:flex-start;gap:13px;padding:14px 0;border-top:1px solid rgba(2,52,41,.08);cursor:pointer;font-size:1.1rem;line-height:1.45;color:var(--on)}
.vj-check label:first-of-type{border-top:0}
.vj-check input{appearance:none;-webkit-appearance:none;flex:0 0 auto;width:24px;height:24px;margin-top:1px;border:2px solid rgba(2,52,41,.3);border-radius:7px;background:#fff;cursor:pointer;position:relative;transition:background .2s ease,border-color .2s ease}
.vj-check input:checked{background:var(--primary);border-color:var(--primary)}
.vj-check input:checked::after{content:"";position:absolute;left:7px;top:2.5px;width:5px;height:11px;border:solid var(--oro);border-width:0 2.5px 2.5px 0;transform:rotate(45deg)}
.vj-check input:checked+span{color:var(--on-var);text-decoration:line-through;text-decoration-color:rgba(2,52,41,.35)}
.vj-cierre{margin:4px 0 0;padding:22px 0 14px;border-top:1px solid rgba(2,52,41,.08);font-family:var(--f-head);font-size:1.5rem;font-style:italic;line-height:1.35;color:var(--primary);text-align:center}

/* ---------- Estación 3: el test ---------- */
.vj-q{margin:24px auto 0;max-width:540px;padding:24px 22px;border-radius:var(--r-card);background:#fff;border:1px solid rgba(2,52,41,.08);box-shadow:var(--sombra-card)}
.vj-q-n{font-family:var(--f-ui);font-weight:800;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--secondary)}
.vj-q-t{margin:8px 0 16px!important;font-family:var(--f-ui);font-weight:800;font-size:1.3rem!important;line-height:1.32;color:var(--primary)!important}
.vj-opts{display:flex;flex-direction:column;gap:9px}
.vj-opt{width:100%;text-align:left;padding:17px 20px;border:2px solid rgba(2,52,41,.14);border-radius:14px;background:#fdfbf6;cursor:pointer;font-family:var(--f-body);font-weight:600;font-size:1.1rem;color:var(--on);transition:border-color .2s ease,background .2s ease,transform .15s ease}
.vj-opt:hover:not(:disabled){border-color:var(--verde-hoja);transform:translateX(3px)}
.vj-opt:disabled{cursor:default}
.vj-opt.vj-ok{border-color:var(--verde-hoja);background:rgba(62,124,89,.12)}
.vj-opt.vj-ko{border-color:rgba(154,85,48,.45);background:rgba(154,85,48,.08);opacity:.75}
.vj-opt .vj-mark{float:right;font-weight:800;color:var(--verde-hoja)}
.vj-r{margin-top:18px;padding:18px 18px 16px;border-radius:14px;background:linear-gradient(155deg,#06291f,#03201a);color:var(--crema)}
.vj-r-badge{display:inline-block;padding:5px 13px;border-radius:100px;background:rgba(246,201,138,.18);border:1px solid rgba(246,201,138,.4);color:var(--oro);font-family:var(--f-ui);font-weight:800;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}
.vj-r p{color:rgba(251,246,236,.92)!important;font-size:1.12rem!important;line-height:1.55}
.vj-r p strong{color:var(--oro)}
.vj-fuente{display:block;margin-top:12px;font-size:.8rem;color:rgba(251,246,236,.6)}
.vj-uso{margin:32px auto 0;max-width:540px;padding:26px 22px;border-radius:20px;background:linear-gradient(150deg,#fbf6ec,#f0e4cf);border:1px solid rgba(147,74,28,.16)}
.vj-uso .vj-uso-k{font-family:var(--f-ui);font-weight:800;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--secondary);margin-bottom:10px}
.vj-uso .vj-uso-big{font-family:var(--f-head);font-size:clamp(2.4rem,9.5vw,3.4rem);font-weight:600;line-height:1.02;color:var(--primary);letter-spacing:-.02em}
.vj-uso p{margin-top:14px!important;color:#5d5746!important;font-size:1.14rem!important;line-height:1.6}

/* ---------- Estación 4: final ---------- */
.vj-doble{display:flex;flex-direction:column;gap:16px;margin:24px auto 0;max-width:540px}
.vj-concl{padding:24px 22px;border-radius:20px;position:relative;overflow:hidden}
.vj-concl--consumidor{background:linear-gradient(155deg,#06291f,#03201a);color:var(--crema);box-shadow:0 16px 40px rgba(2,52,41,.24)}
.vj-concl--artesano{background:linear-gradient(150deg,#fbf6ec,#f0e4cf);border:1px solid rgba(147,74,28,.18)}
.vj-concl-k{display:block;font-family:var(--f-ui);font-weight:800;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:12px}
.vj-concl--consumidor .vj-concl-k{color:var(--oro)}
.vj-concl--artesano .vj-concl-k{color:var(--secondary)}
.vj-concl--consumidor p{color:rgba(251,246,236,.92)!important;font-size:1.14rem!important;line-height:1.6}
.vj-concl--artesano p{color:#4a4335!important;font-size:1.14rem!important;line-height:1.6}
.vj-concl--artesano p strong{color:var(--primary)}
.vj-cita{margin:32px auto 0;max-width:560px;text-align:center;padding:0 4px}
.vj-cita blockquote{font-family:var(--f-head);font-style:italic;font-weight:500;font-size:clamp(1.6rem,6vw,2.3rem);line-height:1.28;color:var(--primary);margin:0}
.vj-cita .vj-firma{margin-top:16px!important;font-size:.92rem!important;color:var(--on-var)!important}
.vj .vj-cita .vj-firma a{color:var(--secondary);text-decoration:underline;text-underline-offset:3px}

/* ---------- Bloque final de CTAs ---------- */
.vj-final{position:relative;overflow:hidden;padding:clamp(64px,11vh,110px) 22px;background:#06241c;text-align:center}
.vj-final-foto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.vj-final::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(168deg,rgba(6,36,28,.88) 0%,rgba(2,52,41,.9) 55%,rgba(6,40,31,.95) 100%)}
.vj-final>*:not(.vj-final-foto){position:relative;z-index:2}
.vj-final img.vj-sello{height:52px;width:auto;margin:0 auto 18px;filter:drop-shadow(0 2px 10px rgba(0,0,0,.5))}
.vj-final h2{font-family:var(--f-head);font-size:clamp(2.4rem,8vw,3.6rem);font-weight:700;color:var(--crema);line-height:1.12;margin-bottom:14px}
.vj-final h2 em{font-style:italic;color:var(--secondary-claro)}
.vj-final p{color:rgba(251,246,236,.8);font-size:1.15rem;max-width:520px;margin:0 auto}
.vj-ctas{display:flex;flex-direction:column;align-items:stretch;gap:12px;max-width:400px;margin:30px auto 0}
.vj-cta{display:flex;align-items:center;justify-content:center;gap:9px;padding:18px 26px;border-radius:100px;font-family:var(--f-ui);font-weight:800;font-size:1.06rem;transition:transform .22s ease,filter .22s ease,box-shadow .22s ease}
.vj-cta--1{background:var(--secondary);color:#fff;box-shadow:0 6px 20px rgba(147,74,28,.4)}
.vj-cta--2{background:rgba(251,246,236,.07);border:1px solid rgba(246,201,138,.42);color:var(--crema)}
.vj-cta--3{background:transparent;color:rgba(251,246,236,.82);font-size:.96rem;padding:12px}
.vj-cta--3 span{text-decoration:underline;text-underline-offset:4px}
.vj-cta:hover{transform:translateY(-2px);filter:brightness(1.06)}

/* ======================= FOOTER LIGERO ======================= */
.vj-foot{padding:34px 22px 40px;background:#03231b;text-align:center}
.vj-foot img{height:38px;width:auto;margin:0 auto 14px;filter:drop-shadow(0 2px 9px rgba(0,0,0,.5))}
.vj-foot p{color:rgba(251,246,236,.6);font-size:.84rem;line-height:1.6}
.vj .vj-foot a{color:rgba(251,246,236,.82);text-decoration:underline;text-underline-offset:3px}
.vj-foot .vj-foot-links{margin-top:8px;display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:center;font-size:.84rem}

.vj-esc{list-style:none;margin:26px auto 0;max-width:540px;padding:0;display:flex;flex-direction:column;gap:12px}
.vj-esc-item{position:relative;padding-left:calc((var(--i) - 1) * 9px)}
.vj-esc-btn{width:100%;display:flex;align-items:center;gap:14px;text-align:left;cursor:pointer;padding:18px 18px;border:1px solid rgba(2,52,41,.12);border-left:4px solid var(--secondary);border-radius:16px;background:#fff;color:var(--on);font-family:inherit;box-shadow:0 10px 26px rgba(2,52,41,.06);transition:background .2s ease,box-shadow .2s ease}
.vj-esc-btn:hover{background:#fffdf8;box-shadow:0 14px 32px rgba(2,52,41,.1)}
.vj-esc-item[data-abierto] .vj-esc-btn{background:#fffdf8;border-radius:16px 16px 0 0;box-shadow:none}
.vj-esc-n{flex:0 0 auto;width:32px;height:32px;border-radius:50%;background:rgba(147,74,28,.1);border:1px solid rgba(147,74,28,.28);color:var(--secondary);font-family:var(--f-head);font-style:italic;font-size:1.05rem;display:flex;align-items:center;justify-content:center}
.vj-esc-t{flex:1 1 auto;font-family:var(--f-ui);font-weight:800;font-size:1.12rem;line-height:1.25;color:var(--primary)}
.vj-esc-c{flex:0 0 auto;font-family:var(--f-head);font-size:clamp(1.5rem,6vw,2.1rem);font-weight:600;color:var(--secondary);line-height:1;white-space:nowrap}
.vj-esc-c small{font-size:.5em;font-weight:400;opacity:.8}
.vj-esc-c--txt{font-style:italic;font-size:1.25rem}
.vj-esc-mas{flex:0 0 auto;color:var(--secondary);font-size:1rem;transition:transform .25s ease}
.vj-esc-item[data-abierto] .vj-esc-mas{transform:rotate(180deg)}
.vj-esc-p{margin-top:-6px;padding:4px 18px 20px;border:1px solid rgba(2,52,41,.12);border-top:0;border-left:4px solid var(--secondary);border-radius:0 0 16px 16px;background:#fffdf8}
.vj-esc-p p{color:var(--on-var)!important;font-size:1.14rem!important;line-height:1.65}
.vj-casc-remate{max-width:560px;margin:36px auto 0!important;padding-top:30px;border-top:1px solid rgba(147,74,28,.22);font-family:var(--f-head);font-style:italic;font-size:clamp(1.6rem,6vw,2.2rem);line-height:1.28;color:var(--primary);text-align:center}
.vj-casc-remate em{color:var(--secondary);font-style:italic}

/* ============= BLOQUE "¿Y POR QUÉ NO SE HACE AQUÍ?" =============
   Testimonio de Ramón Cobo (Wooldreamers). Va sobre crema para respirar
   después de la cascada oscura, y sin foto nueva: manda el titular.
   Los beats van en Newsreader cursiva porque son SUS palabras, no datos. */
.vj-ramon{background:linear-gradient(178deg,var(--crema) 0%,#f5efe2 100%);padding:clamp(56px,9vh,88px) 22px}
.vj-ramon-in{max-width:660px;margin:0 auto}
.vj-ramon .vj-ey{color:var(--secondary)}
.vj-ramon h2{font-family:var(--f-head);font-size:clamp(2.8rem,11vw,4.4rem);font-weight:700;color:var(--primary);line-height:.98;letter-spacing:-.02em}
.vj-ramon h2 em{font-style:italic;color:var(--secondary)}
.vj-ramon-lead{margin-top:20px!important;font-size:clamp(1.3rem,4.5vw,1.5rem);line-height:1.5;color:var(--on)}
.vj-ramon-fuente{margin-top:26px!important;padding:13px 18px;border-radius:12px;background:rgba(147,74,28,.09);border:1px solid rgba(147,74,28,.2);font-size:1rem!important;line-height:1.5;color:#5d5746!important}
.vj-ramon-fuente b{color:var(--secondary)}
.vj-beats{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
.vj-beat-btn{width:100%;display:flex;align-items:flex-start;gap:14px;text-align:left;cursor:pointer;padding:20px 20px;border:1px solid rgba(2,52,41,.12);border-left:4px solid var(--secondary);border-radius:16px;background:#fff;font-family:inherit;box-shadow:0 10px 26px rgba(2,52,41,.06);transition:background .2s ease,box-shadow .2s ease}
.vj-beat-btn:hover{background:#fffdf8;box-shadow:0 14px 32px rgba(2,52,41,.1)}
.vj-beat[data-abierto] .vj-beat-btn{border-radius:16px 16px 0 0;background:#fffdf8;padding-bottom:14px;box-shadow:none}
.vj-beat-n{flex:0 0 auto;width:32px;height:32px;border-radius:50%;background:rgba(147,74,28,.1);border:1px solid rgba(147,74,28,.28);color:var(--secondary);font-family:var(--f-head);font-style:italic;font-size:1.1rem;display:flex;align-items:center;justify-content:center}
.vj-beat-t{flex:1 1 auto;font-family:var(--f-head);font-style:italic;font-size:1.34rem;font-weight:600;line-height:1.28;color:var(--primary)}
.vj-beat-mas{flex:0 0 auto;margin-top:6px;color:var(--secondary);font-size:1rem;transition:transform .25s ease}
.vj-beat[data-abierto] .vj-beat-mas{transform:rotate(180deg)}
.vj-beat-p{margin-top:-6px;padding:2px 20px 20px 20px;border:1px solid rgba(2,52,41,.12);border-top:0;border-left:4px solid var(--secondary);border-radius:0 0 16px 16px;background:#fffdf8}
.vj-beat-p p{font-size:1.14rem!important;line-height:1.65;color:var(--on-var)!important}
.vj-cita--ramon{margin-top:34px!important;padding-top:30px;border-top:1px solid rgba(147,74,28,.22)}
.vj-ramon-remate{margin-top:32px!important;font-size:1.19rem!important;line-height:1.7;color:var(--on-var)!important}
.vj-ramon-remate strong{color:var(--primary)}

.vj-salto{margin:24px auto 0;max-width:540px;padding:20px 22px;border-radius:18px;background:linear-gradient(150deg,#fbf6ec,#f0e4cf);border:1px solid rgba(147,74,28,.18)}
.vj-salto-q{font-family:var(--f-head);font-style:italic;font-size:1.34rem!important;line-height:1.35;color:var(--primary)!important}
.vj-salto-q em{color:var(--secondary)}
.vj-salto-n{margin-top:12px!important;font-size:.94rem!important;line-height:1.5;color:#6b6354!important}

/* ============= LOS DOS ESCAPARATES (parada 3) =============
   Dos tarjetas al patrón de la home: una oscura (lujo), una clara (low cost).
   Lado a lado en escritorio, apiladas en móvil. */
.vj-dos{max-width:1000px;margin:0 auto}
.vj-dos-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:26px}
.vj-dos-card{position:relative;padding:28px 26px;border-radius:var(--r-card);overflow:hidden}
.vj-dos-card h3{font-family:var(--f-head)!important;font-size:1.7rem!important;font-weight:600;line-height:1.15;margin:0 0 14px!important}
.vj-dos-card p{font-size:1.12rem!important;line-height:1.62}
.vj-dos-card--lujo{background:linear-gradient(155deg,#06291f,#03201a);box-shadow:var(--sombra-card)}
.vj-dos-card--lujo h3{color:#fff!important}
.vj-dos-card--lujo p{color:rgba(251,246,236,.88)!important}
.vj-dos-card--lujo em{color:var(--oro);font-style:italic}
.vj-dos-card--low{background:#fff;border:1px solid rgba(2,52,41,.08);box-shadow:var(--sombra-card)}
.vj-dos-card--low h3{color:var(--primary)!important}
.vj-dos-card--low p{color:var(--on-var)!important}
.vj-dos-remate{max-width:68ch;margin:26px auto 0!important;font-size:1.14rem!important;line-height:1.68;color:var(--on-var)!important}
@media(min-width:760px){
  .vj-dos-grid{grid-template-columns:1fr 1fr;gap:22px}
  .vj-dos-card{padding:34px 32px}
  .vj-dos-remate{text-align:center}
}

/* ============= CALCULADORA DE COSTE POR USO ============= */
.vj-calc{margin:26px auto 0;max-width:540px;padding:26px 22px;border-radius:20px;background:linear-gradient(155deg,#06291f,#03201a);color:var(--crema)}
.vj-calc h3{font-family:var(--f-head)!important;font-size:1.7rem!important;font-weight:600;color:var(--crema)!important;margin:0 0 6px!important}
.vj-calc .vj-calc-sub{color:rgba(251,246,236,.7)!important;font-size:1rem!important;margin-bottom:22px}
.vj-calc-campo{margin-bottom:20px}
.vj-calc-campo label{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-family:var(--f-ui);font-weight:800;font-size:.94rem;color:rgba(251,246,236,.84);margin-bottom:10px}
.vj-calc-campo label b{color:var(--oro);font-size:1.24rem;font-family:var(--f-head);font-weight:600}
.vj-calc input[type=range]{width:100%;height:26px;background:transparent;appearance:none;-webkit-appearance:none;cursor:pointer}
.vj-calc input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:100px;background:rgba(251,246,236,.18)}
.vj-calc input[type=range]::-moz-range-track{height:6px;border-radius:100px;background:rgba(251,246,236,.18)}
.vj-calc input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;margin-top:-10px;border-radius:50%;background:linear-gradient(135deg,#f6c98a,#e0a965);border:0;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.vj-calc input[type=range]::-moz-range-thumb{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#f6c98a,#e0a965);border:0}
.vj-calc-res{margin-top:24px;padding:22px 18px;border-radius:16px;background:rgba(246,201,138,.12);border:1px solid rgba(246,201,138,.34);text-align:center}
.vj-calc-big{font-family:var(--f-head);font-size:clamp(2.8rem,12vw,4rem);font-weight:600;color:var(--oro);line-height:1}
.vj-calc-big .vj-calc-un{display:block;margin-top:8px;font-size:.26em;font-family:var(--f-ui);font-weight:800;color:rgba(251,246,236,.78);letter-spacing:.08em;text-transform:uppercase}
.vj-calc-res p{color:rgba(251,246,236,.82)!important;font-size:1.02rem!important;margin-top:12px!important}
.vj-calc-comp{margin-top:16px!important;font-size:.96rem!important;color:rgba(251,246,236,.62)!important;text-align:center}
.vj-calc-pie{margin-top:18px!important;font-family:var(--f-head);font-style:italic;font-size:1.3rem!important;color:var(--crema)!important;text-align:center}

/* ============= HISTORIA HUMANA (cierre estación 3) ============= */
.vj-historia{margin:26px auto 0;max-width:540px;padding:26px 24px;border-radius:20px;background:linear-gradient(150deg,#fbf6ec,#f0e4cf);border:1px solid rgba(147,74,28,.18)}
.vj-historia .vj-hist-k{font-family:var(--f-ui);font-weight:800;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--secondary);margin-bottom:14px}
.vj-historia p{color:#4a4335!important;font-size:1.14rem!important;line-height:1.62}
.vj-historia p+p{margin-top:14px!important}
.vj-hist-cifras{display:flex;align-items:center;justify-content:center;gap:18px;margin:20px 0}
.vj-hist-cifra{text-align:center}
.vj-hist-cifra b{display:block;font-family:var(--f-head);font-size:clamp(1.9rem,8vw,2.6rem);font-weight:600;line-height:1}
.vj-hist-cifra--merc b{color:#8a8070}
.vj-hist-cifra--real b{color:var(--primary)}
.vj-hist-cifra span{display:block;margin-top:6px;font-size:.86rem;color:#6b6354;font-weight:600}
.vj-hist-flecha{color:var(--secondary);font-size:1.5rem;flex:0 0 auto}

/* ============= FRASES PARA COPIAR (estación 4) ============= */
.vj-frases{margin:30px auto 0;max-width:560px}
.vj-frases-k{font-family:var(--f-ui);font-weight:800;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--secondary);text-align:center;margin-bottom:8px}
.vj-frases h3{text-align:center;font-family:var(--f-head)!important;font-size:1.9rem!important;color:var(--primary)!important;font-weight:700;margin:0 0 20px!important}
.vj-frase{display:flex;align-items:flex-start;gap:14px;padding:20px;border-radius:var(--r-card);background:#fff;border:1px solid rgba(2,52,41,.08);box-shadow:var(--sombra-card)}
.vj-frase+.vj-frase{margin-top:12px}
.vj-frase q{flex:1 1 auto;font-family:var(--f-head);font-style:italic;font-size:1.24rem;line-height:1.4;color:var(--primary);quotes:'"' '"'}
.vj-copiar{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;padding:11px 15px;border:0;cursor:pointer;border-radius:100px;background:rgba(2,52,41,.08);color:var(--primary);font-family:var(--f-ui);font-weight:800;font-size:.86rem;transition:background .2s ease,color .2s ease}
.vj-copiar:hover{background:rgba(2,52,41,.16)}
.vj-copiar.vj-copiado{background:var(--primary);color:var(--oro)}

/* ======================= REVEALS / MOTION =======================
   Corto (250 ms) y de recorrido mínimo: el texto tiene que estar legible en
   cuanto entra en pantalla, no "aparecer" durante medio segundo.
   El estado oculto SOLO existe bajo .vj-js, que pone el propio script: si el
   JS no llega a ejecutarse, todo se ve — nunca un bloque fantasma. */
.vj-js .vj-rev{opacity:0;transform:translateY(14px);transition:opacity .25s ease-out,transform .25s ease-out}
.vj-js .vj-rev.vj-in{opacity:1;transform:none}
/* Lo que ya está en pantalla al cargar entra sin animación ninguna. */
.vj-js .vj-rev.vj-in--now{transition:none}
@media(prefers-reduced-motion:reduce){
  .vj-js .vj-rev{opacity:1;transform:none;transition:none}
  .vj-linea-draw{transition:none;stroke-dashoffset:0}
  .vj-hito.vj-done{animation:none}
  .vj-fill{transition:none}
}

/* ======================= ESCRITORIO ======================= */
@media(min-width:760px){
  .vj-intro{padding:120px 46px 64px}
  .vj-est-hero{min-height:56vh;padding:110px 46px 40px}
