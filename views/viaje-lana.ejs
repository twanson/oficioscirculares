  /* ═══════════ ESCENAS E1-E3: GSAP + ScrollTrigger ═══════════
     Progresivo de verdad: la página nace estática y legible; solo cuando GSAP
     ha cargado se añade .vj-gsap y las escenas toman el mando. Si el CDN no
     llega, no pasa nada: columna estática. reduced-motion: ni se intenta. */
  var escenasListas = false;
  function initScenes(){
    if (escenasListas || !window.gsap || !window.ScrollTrigger) return;
    escenasListas = true;
    gsap.registerPlugin(ScrollTrigger);
    root.classList.add('vj-gsap');

    /* ── E1 · Apertura ── */
    var e1 = document.getElementById('apertura');
    var q1 = function(sel){ return e1.querySelector(sel); };
    gsap.set(q1('.vj-e1-foto'), {opacity: .36, scale: 1.12});
    // Drift lento e independiente del scroll: la escena respira aunque el
    // lector aún no haya movido el dedo. Sobre el wrapper, no sobre la foto,
    // para no pelearse con el scrub.
    gsap.to(q1('.vj-e1-media'), {scale: 1.045, yPercent: 1.6, duration: 16, ease: 'sine.inOut', yoyo: true, repeat: -1});
    gsap.set([q1('[data-e1="2"]'), q1('[data-e1="3"]'), q1('.vj-e1-titulo')], {autoAlpha: 0, y: 14});

    var tl1 = gsap.timeline({
      defaults: {ease: 'none'},
      scrollTrigger: {
        trigger: e1, start: 'top top', end: '+=250%', pin: true, scrub: true,
        onUpdate: function(st){
          // la píldora del kilo nace con el título, una sola vez
          if (st.progress > 0.72 && !e1.dataset.pill){ e1.dataset.pill = '1'; pintarKilo(1); }
        }
      }
    });
    tl1.to(q1('.vj-e1-foto'), {opacity: 1, scale: 1, duration: 38}, 0)
       .to(q1('[data-e1="1"]'), {autoAlpha: 0, y: -14, duration: 6, ease: 'power2.in'}, 16)
       .to(q1('[data-e1="2"]'), {autoAlpha: 1, y: 0, duration: 6, ease: 'power2.out'}, 22)
       .to(q1('[data-e1="2"]'), {autoAlpha: 0, y: -14, duration: 6, ease: 'power2.in'}, 40)
       .to(q1('[data-e1="3"]'), {autoAlpha: 1, y: 0, duration: 6, ease: 'power2.out'}, 46)
       .to(q1('[data-e1="3"]'), {autoAlpha: 0, y: -14, duration: 6, ease: 'power2.in'}, 64)
       .to(q1('.vj-e1-titulo'), {autoAlpha: 1, y: 0, duration: 10, ease: 'power2.out'}, 71)
;
    // subrayado a mano de "céntimos", dibujado cuando la frase 2 está en meseta
    var sub1 = q1('.vj-sub-trazo');
    if (sub1){
      var sl1 = sub1.getTotalLength();
      gsap.set(sub1, {strokeDasharray: sl1, strokeDashoffset: sl1});
      tl1.to(sub1, {strokeDashoffset: 0, duration: 6, ease: 'none'}, 30);
    }

    /* ── E2 · La nave ── */
    var e2 = document.getElementById('nave');
    var mm = gsap.matchMedia();
    mm.add({escritorio: '(min-width: 1024px)', movil: '(max-width: 1023.98px)'}, function(ctx){
      var desk = ctx.conditions.escritorio;
      var q2 = function(sel){ return e2.querySelector(sel); };
      gsap.set(q2('.vj-e2-cinewrap'), {autoAlpha: 0, y: '9vh'});
      gsap.set(q2('.vj-e2-nota'), desk ? {autoAlpha: 0, x: 70} : {autoAlpha: 0, y: 46});
      gsap.set(q2('.vj-e2-bg img'), {yPercent: -6, scale: 1.06});

      var tl2 = gsap.timeline({
        defaults: {ease: 'none'},
        scrollTrigger: {trigger: e2, start: 'top top', end: '+=170%', pin: true, scrub: true}
      });
      tl2.to(q2('.vj-e2-bg img'), {yPercent: 6, duration: 100}, 0)          // parallax lento
         .to(q2('.vj-e2-cinewrap'), {autoAlpha: 1, y: 0, duration: 22}, 4)  // el cine sube
         .to(q2('#vjBadge'), {scale: 1.12, duration: 5}, 30)                // el rótulo late una vez
         .to(q2('#vjBadge'), {scale: 1, duration: 5}, 35);
      if (desk){
        tl2.to(q2('.vj-e2-cinewrap'), {xPercent: -14, scale: .95, duration: 18}, 58)
           .to(q2('.vj-e2-nota'), {autoAlpha: 1, x: 0, duration: 16}, 62);
      } else {
        tl2.to(q2('.vj-cine-lead'), {autoAlpha: 0, y: -20, duration: 10}, 56)
           .to(q2('.vj-e2-cinewrap'), {y: '-9vh', scale: .97, duration: 18}, 58)
           .to(q2('.vj-e2-nota'), {autoAlpha: 1, y: 0, duration: 16}, 64);
      }
      return function(){ tl2.scrollTrigger && tl2.scrollTrigger.kill(); tl2.kill(); };
    });

    /* ══ hiloDeLana — PORTADO de public/hilo-demo.html ══
       Dos hebras retorcidas en fase, fibrillas sueltas, nudo de hito y cabo
       deshilachado. Igual que la demo salvo el driver: aquí el draw-on lo
       lleva el scrub de ScrollTrigger, no una transición CSS. */
    function hiloDeLana(svg, spineD, opts){
      var o = Object.assign({
        color: '#b45817', colorClaro: '#d98a4f', grosor: 2.6,
        vueltas: 26, fibras: 0.5, nudoFin: false, deshilachado: false
      }, opts || {});
      var NS = 'http://www.w3.org/2000/svg';
      var spine = document.createElementNS(NS, 'path');
      spine.setAttribute('d', spineD);
      svg.appendChild(spine);
      var L = spine.getTotalLength();
      var paso = 3;
      var g = document.createElementNS(NS, 'g');
      var hebras = [[], []];
      for (var l = 0; l <= L; l += paso){
        var pt = spine.getPointAtLength(l);
        var pt2 = spine.getPointAtLength(Math.min(l + 1, L));
        var tx = pt2.x - pt.x, ty = pt2.y - pt.y;
        var n = Math.hypot(tx, ty) || 1;
        var nx = -ty / n, ny = tx / n;
        var fase = (l / L) * o.vueltas * Math.PI * 2;
        var amp = o.grosor * 0.85;
        var damp = Math.min(1, l / 40, (L - l) / 40);
        var off = Math.sin(fase) * amp * damp;
        hebras[0].push([pt.x + nx * off, pt.y + ny * off]);
        hebras[1].push([pt.x - nx * off, pt.y - ny * off]);
      }
      var hebrasEl = [];
      [[hebras[0], o.color], [hebras[1], o.colorClaro]].forEach(function(par){
        var path = document.createElementNS(NS, 'path');
        path.setAttribute('d', 'M' + par[0].map(function(q){ return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join(' L'));
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', par[1]);
        path.setAttribute('stroke-width', o.grosor);
        path.setAttribute('stroke-linecap', 'round');
        path.setAttribute('vector-effect', 'non-scaling-stroke');
        g.appendChild(path);
        hebrasEl.push(path);
      });
      var fibrasEl = [];
      var nF = Math.floor(o.vueltas * o.fibras);
      for (var i = 0; i < nF; i++){
        var lf = 30 + Math.random() * (L - 60);
        var pf = spine.getPointAtLength(lf);
        var pf2 = spine.getPointAtLength(lf + 1);
        var ftx = pf2.x - pf.x, fty = pf2.y - pf.y;
        var fn = Math.hypot(ftx, fty) || 1;
        var fnx = -fty / fn, fny = ftx / fn;
        var lado = Math.random() > .5 ? 1 : -1;
        var len = 5 + Math.random() * 8;
        var curl = (Math.random() - .5) * 6;
        var f = document.createElementNS(NS, 'path');
        f.setAttribute('d', 'M' + pf.x + ',' + pf.y + ' q' + (fnx*lado*len*.6 + ftx/fn*2) + ',' + (fny*lado*len*.6 + fty/fn*2) + ' ' + (fnx*lado*len + curl) + ',' + (fny*lado*len + curl));
        f.setAttribute('fill', 'none');
        f.setAttribute('stroke', o.color);
        f.setAttribute('stroke-width', .9);
        f.setAttribute('stroke-linecap', 'round');
        f.setAttribute('opacity', 0);
        f.dataset.en = (lf / L).toFixed(3);
        g.appendChild(f);
        fibrasEl.push(f);
      }
      var fin = spine.getPointAtLength(L);
      var remates = [];
      if (o.nudoFin){
        var k = document.createElementNS(NS, 'path');
        k.setAttribute('d', 'M' + (fin.x-6) + ',' + fin.y + ' a6,5 0 1,0 12,0 a6,5 0 1,0 -12,0 M' + (fin.x-3) + ',' + (fin.y-4) + ' a4,4 0 1,1 6,8');
        k.setAttribute('fill', 'none'); k.setAttribute('stroke', o.color);
        k.setAttribute('stroke-width', o.grosor); k.setAttribute('stroke-linecap', 'round');
        k.setAttribute('vector-effect', 'non-scaling-stroke');
        k.setAttribute('opacity', 0);
        g.appendChild(k); remates.push(k);
      }
      if (o.deshilachado){
        for (var j = 0; j < 4; j++){
          var a2 = -0.6 + j * 0.4, len2 = 12 + Math.random() * 10;
          var fd = document.createElementNS(NS, 'path');
          fd.setAttribute('d', 'M' + fin.x + ',' + fin.y + ' q' + (len2*.5) + ',' + (a2*len2*.4) + ' ' + len2 + ',' + (a2*len2));
          fd.setAttribute('fill', 'none'); fd.setAttribute('stroke', j % 2 ? o.colorClaro : o.color);
          fd.setAttribute('stroke-width', 1.1); fd.setAttribute('stroke-linecap', 'round');
          fd.setAttribute('opacity', 0);
          g.appendChild(fd); remates.push(fd);
        }
      }
      spine.remove();
      svg.appendChild(g);
      return {hebras: hebrasEl, fibras: fibrasEl, remates: remates};
    }

    /* Monta un hilo en su caja: viewBox 1:1 con los píxeles reales (sin
       distorsión del retorcido) y espina definida en fracciones de la caja. */
    function montarHilo(svg, espina, opts){
      if (!svg) return null;
      var r = svg.getBoundingClientRect();
      var W = Math.max(60, Math.round(r.width)), H = Math.max(60, Math.round(r.height));
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      svg.setAttribute('preserveAspectRatio', 'none');
      svg.innerHTML = '';
      return hiloDeLana(svg, espina(W, H), opts);
    }

    /* Cablea el draw-on al scrub: hebras por dashoffset, fibrillas por tramo
       ya dibujado, remates al llegar al final. */
    function dibujarHiloEnTimeline(tl, hilo, desde, dur){
      if (!hilo) return;
      // Las dos hebras avanzan JUNTAS (sin stagger): desincronizadas, la
      // punta se leía como hilo roto a trozos.
      hilo.hebras.forEach(function(h){
        var lh = h.getTotalLength();
        gsap.set(h, {strokeDasharray: lh, strokeDashoffset: lh});
        tl.to(h, {strokeDashoffset: 0, duration: dur, ease: 'none'}, desde);
      });
      // Las fibrillas asoman DESPUÉS de que el trazo pase por su tramo,
      // nunca por delante de la punta.
      hilo.fibras.forEach(function(f){
        tl.to(f, {opacity: .4, duration: 3, ease: 'none'}, desde + parseFloat(f.dataset.en) * dur + 2);
      });
      hilo.remates.forEach(function(rm, i){
        tl.to(rm, {opacity: .9, duration: 4, ease: 'power2.out'}, desde + dur - 2 + i * .5);
      });
    }

    /* ── E4/E8 · transiciones (mismo motor, distinto rumbo del hilo) ── */
    function transicion(id, tramoAlAcabar){
      var el = document.getElementById(id);
      if (!el) return;
      var q = function(sel){ return el.querySelector(sel); };
      // La escena entra ya teñida: sin este arranque, el tramo pre-pin
      // mostraba crema plano — el único frame vacío del barrido.
      gsap.set(q('.vj-tr-fondo--b'), {opacity: 0});
      gsap.set(q('.vj-tr-frase'), {autoAlpha: 0, y: 30});
      var hecho = false;
      gsap.set(q('.vj-tr-foto'), {opacity: .42});
      var tlT = gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: el, start: 'top top', end: '+=90%', pin: true, scrub: true,
          onUpdate: function(st){
            if (st.progress > 0.9 && !hecho){ hecho = true; completar(tramoAlAcabar); }
          }}});
      tlT.to(q('.vj-tr-fondo--b'), {opacity: 1, duration: 26}, 0)
         .to(q('.vj-tr-foto'), {opacity: .5, duration: 34}, 4)
         .fromTo(q('.vj-tr-foto img'), {yPercent: -4}, {yPercent: 4, duration: 100, ease: 'none'}, 0)
         .to(q('.vj-tr-frase'), {autoAlpha: 1, y: 0, duration: 14, ease: 'power2.out'}, 16);
      var subT = q('.vj-sub-trazo');
      if (subT){
        var slT = subT.getTotalLength();
        gsap.set(subT, {strokeDasharray: slT, strokeDashoffset: slT});
        tlT.to(subT, {strokeDashoffset: 0, duration: 8, ease: 'none'}, 34);
      }
    }
    transicion('se-va', 1);

    /* ── E5 · el puerto: pan lateral lento ── */
    var e5 = document.getElementById('puerto');
    if (e5){
      var q5 = function(sel){ return e5.querySelector(sel); };
      gsap.set(q5('.vj-e5-bg img'), {scale: 1.3, xPercent: 10});
      gsap.set(q5('.vj-e5-in'), {autoAlpha: 0, y: 14});
      gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e5, start: 'top top', end: '+=160%', pin: true, scrub: true}})
        .to(q5('.vj-e5-bg img'), {xPercent: -10, duration: 100}, 0)
        .to(q5('.vj-e5-in'), {autoAlpha: 1, y: 0, duration: 20, ease: 'power2.out'}, 8);
    }

    /* ── E6 · Ramón por pasos: beats de uno en uno, la cita queda ── */
    var e6 = document.getElementById('por-que-no-aqui');
    if (e6){
      var q6 = function(sel){ return e6.querySelector(sel); };
      var pasos6 = [q6('.vj-e6-cabecera'), q6('[data-beat="1"]'), q6('[data-beat="2"]'), q6('[data-beat="3"]'), q6('.vj-e6-cita')];
      pasos6.forEach(function(paso, i){ gsap.set(paso, {autoAlpha: i ? 0 : 1, y: i ? 14 : 0}); });
      /* Ventanas prietas: fundidos de 4, meseta de 12. En cada frame del pin
         hay SIEMPRE un paso legible — también recorriéndolo hacia arriba. */
      var marcas = [0, 20, 38, 56, 76];
      var beatsVistos = {};
      gsap.set(q6('.vj-e6-bg img'), {yPercent: -4});
      var tl6 = gsap.timeline({defaults: {ease: 'power2.out'},
        scrollTrigger: {trigger: e6, start: 'top top', end: '+=260%', pin: true, scrub: true,
          onUpdate: function(st){
            [1, 2, 3].forEach(function(bt){
              if (st.progress > (marcas[bt] + 3) / 100 && !beatsVistos[bt]){
                beatsVistos[bt] = 1;
                track('viaje_ramon_beat', {viaje: 'lana', beat: bt});
              }
            });
          }}});
      tl6.to(q6('.vj-e6-bg img'), {yPercent: 4, duration: 100, ease: 'none'}, 0);
      tl6.to(pasos6[0], {autoAlpha: 0, y: -14, duration: 4, ease: 'power2.in'}, 17);
      [1, 2, 3].forEach(function(i){
        tl6.to(pasos6[i], {autoAlpha: 1, y: 0, duration: 4}, marcas[i]);
        tl6.to(pasos6[i], {autoAlpha: 0, y: -14, duration: 4, ease: 'power2.in'}, marcas[i] + 15);
      });
      tl6.to(pasos6[4], {autoAlpha: 1, y: 0, duration: 6}, marcas[4]);
      tl6.set({}, {}, 100); // la cita se queda en meseta hasta el final del pin
    }

    /* ── E7 · la escalera se construye; el hilo trepa ── */
    var e7 = document.getElementById('escalera-1');
    if (e7){
      var q7 = function(sel){ return e7.querySelector(sel); };
      var pel1 = q7('[data-paso="1"]'), pel2 = q7('[data-paso="2"]');
      gsap.set([pel1, pel2], {autoAlpha: 0, y: 64});
      var pasosVistos7 = {};
      var tl7 = gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e7, start: 'top top', end: '+=170%', pin: true, scrub: true,
          onUpdate: function(st){
            if (st.progress > 0.25 && !pasosVistos7[1]){ pasosVistos7[1] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 1}); }
            if (st.progress > 0.55 && !pasosVistos7[2]){ pasosVistos7[2] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 2}); }
          }}});
      tl7.to(pel1, {autoAlpha: 1, y: 0, duration: 20, ease: 'power2.out'}, 5)
         .to(pel2, {autoAlpha: 1, y: 0, duration: 20, ease: 'power2.out'}, 32);
    }

    /* ── E8 se crea AQUÍ, en orden del documento: crearla antes que E5-E7
       dejaba su pin calculado con las posiciones viejas y se disparaba DENTRO
       del rango de E6, tapando el testimonio entero con sus capas crema. ── */
    transicion('regreso', 2);

    /* ── E9 · la vitrina se abre y el contador salta bajo el pulgar ── */
    var e9 = document.getElementById('vitrina');
    var contador = document.getElementById('vjContador');
    if (e9 && contador){
      mm.add({escritorio9: '(min-width: 900px)', movil9: '(max-width: 899.98px)'}, function(ctx){
        var desk = ctx.conditions.escritorio9;
        var q9 = function(sel){ return e9.querySelector(sel); };
        var pel3 = q9('[data-paso="3"]'), pel4 = q9('[data-paso="4"]');
        gsap.set(q9('.vj-e9-bg img'), {scale: 1.22});
        gsap.set(q9('.vj-e9-in'), {autoAlpha: 0, y: 14});
        gsap.set([q9('.vj-salto-q'), q9('.vj-salto-n')], {autoAlpha: 0, y: 12});
        gsap.set([pel3, pel4], {autoAlpha: 0, y: 64});
        pintarEuro(contador, '0,05 €');

        var A = 0.26, B = 0.60, saltoScrubHecho = false, pasosVistos9 = {};
        var tl9 = gsap.timeline({defaults: {ease: 'none'},
          scrollTrigger: {trigger: e9, start: 'top top', end: '+=280%', pin: true, scrub: true,
            onUpdate: function(st){
              var pr = st.progress;
              if (pr <= A){
                pintarEuro(contador, '0,05 €'); pintarEuro(kiloV, '0,05 €');
              } else if (pr < B){
                var k = (pr - A) / (B - A);
                // Rodillo de odómetro: barrido exponencial entre magnitudes con
                // frenada suave (smoothstep) — acelera a mitad, frena al final.
                var ss = k * k * (3 - 2 * k);
                var v = 0.05 * Math.pow(1500 / 0.05, ss);
                var txt = eurKilo(v);
                pintarEuro(contador, txt); pintarEuro(kiloV, txt);
                saltoHecho = true; // el auto-salto estático queda anulado
              } else {
                pintarEuro(contador, '1.500 €'); pintarEuro(kiloV, '1.500 €');
                if (!saltoScrubHecho){
                  saltoScrubHecho = true;
                  latido();
                  // el golpe: la cifra aterriza con peso
                  gsap.fromTo(contador, {scale: 1.06}, {scale: 1, duration: .12, ease: 'power2.out'});
                  track('viaje_marcador_salto', {viaje: 'lana'});
                  track('viaje_salto_scrub', {viaje: 'lana'});
                }
              }
              if (pr > 0.76 && !pasosVistos9[3]){ pasosVistos9[3] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 3}); }
              if (pr > 0.9 && !pasosVistos9[4]){ pasosVistos9[4] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 4}); }
            }}});
        tl9.to(q9('.vj-e9-puerta--izq'), {xPercent: -101, duration: 20}, 2)
           .to(q9('.vj-e9-puerta--dcha'), {xPercent: 101, duration: 20}, 2)
           .to(q9('.vj-e9-bg img'), {scale: 1.04, duration: 70}, 2)
           .to(q9('.vj-e9-in'), {autoAlpha: 1, y: 0, duration: 10}, 14)
           .to(q9('.vj-salto-q'), {autoAlpha: 1, y: 0, duration: 8}, 61)
           .to(q9('.vj-salto-n'), {autoAlpha: 1, y: 0, duration: 8}, 65)
           .to(pel3, {autoAlpha: 1, y: 0, duration: 11}, 74)
           .to(pel4, {autoAlpha: 1, y: 0, duration: 11}, 85);
        if (!desk){
          // en móvil el matiz cede el sitio a los peldaños
          tl9.to([q9('.vj-salto-q'), q9('.vj-salto-n')], {autoAlpha: 0, y: -14, duration: 8}, 72)
             .to(q9('.vj-e9-contador'), {scale: .8, y: -10, duration: 10}, 72);
        }
        return function(){ tl9.scrollTrigger && tl9.scrollTrigger.kill(); tl9.kill(); };
      });
    }

    /* ── Precarga por escena: las fotos llegan antes que el lector ── */
    setTimeout(function(){
      var sufijo = window.innerWidth > 900 ? '-1600' : '-900';
      ['nave-vellones', 'puerto-contenedores', 'puerto-bobinas', 'interludio-textura', 'escaparate-punto', 'taller-tejiendo', 'cierre-rebano'].forEach(function(nombre){
        var im = new Image();
        im.src = '/assets/images/viaje-lana/' + nombre + sufijo + '.webp';
      });
    }, 900);

    /* ── hilo-progreso del test (lo pinta el stepper con el estado) ── */
    if (window.__vjMontarHiloTest) window.__vjMontarHiloTest(montarHilo);

    /* ── E14 · la bifurcación: el hilo se parte en dos destinos ── */
    var e14 = document.getElementById('bifurcacion');
    if (e14){
      var svg14 = e14.querySelector('.vj-e14-hilo');
      var r14 = svg14.getBoundingClientRect();
      var W14 = Math.max(300, Math.round(r14.width)), H14 = Math.max(400, Math.round(r14.height));
      svg14.setAttribute('viewBox', '0 0 ' + W14 + ' ' + H14);
      svg14.setAttribute('preserveAspectRatio', 'none');
      var tronco = hiloDeLana(svg14, 'M' + (.5*W14) + ',0 C ' + (.52*W14) + ',' + (.16*H14) + ' ' + (.48*W14) + ',' + (.3*H14) + ' ' + (.5*W14) + ',' + (.4*H14), {fibras: .4, color: '#c96f2e', colorClaro: '#e8a76a'});
      var gris = hiloDeLana(svg14, 'M' + (.5*W14) + ',' + (.4*H14) + ' C ' + (.62*W14) + ',' + (.56*H14) + ' ' + (.76*W14) + ',' + (.68*H14) + ' ' + (.86*W14) + ',' + (.84*H14), {deshilachado: true, color: '#8a8a80', colorClaro: '#b0b0a6', fibras: .3});
      var vivo = hiloDeLana(svg14, 'M' + (.5*W14) + ',' + (.4*H14) + ' C ' + (.38*W14) + ',' + (.56*H14) + ' ' + (.26*W14) + ',' + (.72*H14) + ' ' + (.18*W14) + ',' + (.9*H14), {nudoFin: true, fibras: .5, color: '#c96f2e', colorClaro: '#e8a76a'});
      var hecho14 = false;
      var tl14 = gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e14, start: 'top top', end: '+=110%', pin: true, scrub: true,
          onUpdate: function(st){
            if (st.progress > 0.9 && !hecho14){ hecho14 = true; completar(3); }
          }}});
      gsap.set(e14.querySelector('.vj-e14-frase'), {autoAlpha: 0, y: 14});
      dibujarHiloEnTimeline(tl14, tronco, 2, 26);
      dibujarHiloEnTimeline(tl14, gris, 30, 34);
      dibujarHiloEnTimeline(tl14, vivo, 30, 34);
      // el ramal gris pierde fuelle: se va apagando
      gris.hebras.forEach(function(h){ tl14.to(h, {opacity: .3, duration: 18}, 70); });
      tl14.to(e14.querySelector('.vj-e14-frase'), {autoAlpha: 1, y: 0, duration: 12, ease: 'power2.out'}, 46);
    }

    /* ── E16 · el mismo kilo, dos destinos ── */
    var e16 = document.getElementById('final');
    if (e16){
      var q16 = function(sel){ return e16.querySelector(sel); };
      var svg16 = q16('.vj-e16-hilo');
      var r16 = svg16.getBoundingClientRect();
      var W16 = Math.max(90, Math.round(r16.width)), H16 = Math.max(90, Math.round(r16.height));
      svg16.setAttribute('viewBox', '0 0 ' + W16 + ' ' + H16);
      svg16.setAttribute('preserveAspectRatio', 'none');
      var biTronco = hiloDeLana(svg16, 'M' + (.5*W16) + ',2 C ' + (.5*W16) + ',' + (.2*H16) + ' ' + (.5*W16) + ',' + (.3*H16) + ' ' + (.5*W16) + ',' + (.42*H16), {fibras: 0, vueltas: 8, color: '#c96f2e', colorClaro: '#e8a76a'});
      var biGris = hiloDeLana(svg16, 'M' + (.5*W16) + ',' + (.42*H16) + ' C ' + (.32*W16) + ',' + (.6*H16) + ' ' + (.16*W16) + ',' + (.72*H16) + ' ' + (.06*W16) + ',' + (.86*H16), {deshilachado: true, color: '#8a8a80', colorClaro: '#b0b0a6', fibras: 0, vueltas: 8, grosor: 2.2});
      var biVivo = hiloDeLana(svg16, 'M' + (.5*W16) + ',' + (.42*H16) + ' C ' + (.68*W16) + ',' + (.6*H16) + ' ' + (.84*W16) + ',' + (.72*H16) + ' ' + (.94*W16) + ',' + (.86*H16), {nudoFin: true, fibras: 0, vueltas: 8, color: '#c96f2e', colorClaro: '#e8a76a'});
      var tl16 = gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e16, start: 'top top', end: '+=150%', pin: '.vj-e16-pin', scrub: true}});
      gsap.set(q16('.vj-e16-titulo'), {autoAlpha: 0, y: 14});
      gsap.set(q16('.vj-e16-destinos'), {autoAlpha: 0, y: 14});
      gsap.set(q16('.vj-e16-remate'), {autoAlpha: 0, y: 12});
      tl16.to(q16('.vj-e16-bg img'), {scale: 1.06, duration: 100}, 0)
          .to(q16('.vj-e16-titulo'), {autoAlpha: 1, y: 0, duration: 10, ease: 'power2.out'}, 4)
          .to(q16('.vj-e16-destinos'), {autoAlpha: 1, y: 0, duration: 10, ease: 'power2.out'}, 16);
      dibujarHiloEnTimeline(tl16, biTronco, 22, 10);
      dibujarHiloEnTimeline(tl16, biGris, 34, 20);
      dibujarHiloEnTimeline(tl16, biVivo, 34, 20);
      tl16.to(q16('.vj-e16-remate'), {autoAlpha: 1, y: 0, duration: 10, ease: 'power2.out'}, 62);
      gsap.set(q16('.vj-e16-bg img'), {scale: 1.0});
    }

    /* ── la onda final: el hilo entero se ilumina de abajo arriba ──
       Temporizadores puros, nada de rAF: debe funcionar hasta en pestaña
       de fondo. Es el fuego artificial del cierre. */
    window.__vjOnda = function(){
      var svgs = [].slice.call(document.querySelectorAll('.vj-e16-hilo, .vj-e14-hilo, .vj-e12-hilo, .vj-nudo, .vj-kilo'));
      svgs.forEach(function(sv, i){
        setTimeout(function(){
          sv.classList.add('vj-hilo-brilla');
          setTimeout(function(){ sv.classList.remove('vj-hilo-brilla'); }, 480);
        }, i * 130);
      });
      latido();
    };

    ScrollTrigger.sort();
    ScrollTrigger.refresh();
    // Las medidas se recalculan cuando llegan las fuentes y tras un respiro:
    // si los starts quedan viejos, los pins actúan en el sitio equivocado.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ ScrollTrigger.refresh(); });
    setTimeout(function(){ ScrollTrigger.refresh(); }, 1200);
  }

  if (!reduce){
    (function(){
      // Optimista: la escena se viste ya (sin destello estático→escena) y si
      // GSAP no ha llegado en 3,5 s se desviste — vuelta a la columna legible.
      root.classList.add('vj-gsap');
      setTimeout(function(){ if (!escenasListas) root.classList.remove('vj-gsap'); }, 3500);
      function carga(src, cb){
        var sc = document.createElement('script');
        sc.src = src; sc.async = true; sc.onload = cb;
        document.head.appendChild(sc);
      }
      carga('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js', function(){
        carga('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js', initScenes);
      });
    })();
  }

  pintarProgreso();
})();
</script>
</body>
</html>
