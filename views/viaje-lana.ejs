<script>
/* ===================================================================
   EL VIAJE DE LA LANA — lógica de la experiencia. Vanilla, sin librerías.
   Estado (progreso + checklist + test) en sessionStorage: sobrevive a un
   refresh pero no convierte el viaje en algo eterno.
   =================================================================== */
(function(){
  'use strict';

  var KEY = 'vjLana';
  var TOTAL = 4;
  var root = document.getElementById('vj');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Activa los estados ocultos de los reveals. Sin esta clase todo se ve:
  // si el script fallara, nadie se queda con bloques a medio pintar.
  root.classList.add('vj-js');

  /* ---------- "Cuando esto se vea, haz aquello" ----------
     IntersectionObserver como vía principal, pero con dos redes debajo: un
     repaso en cada scroll (pasivo, con rAF) y un plazo máximo. Depender solo
     del observer dejaba bloques semitransparentes si el callback no llegaba. */
  var pendientes = [];
  function visible(el, margen){
    var r = el.getBoundingClientRect();
    return r.top < window.innerHeight + (margen || 0) && r.bottom > -(margen || 0);
  }
  function cuandoSeVea(el, fn, opts){
    opts = opts || {};
    var hecho = false;
    function disparar(inmediato){
      if (hecho) return;
      hecho = true;
      fn(el, inmediato === true);
    }
    if (visible(el, opts.margen)) { disparar(true); return; }
    // sinPlazo: lo que mide (no lo que pinta) nunca debe dispararlo el
    // temporizador de seguridad — solo el haber estado de verdad en pantalla.
    pendientes.push({el:el, margen:opts.margen || 0, run:disparar, sinPlazo:!!opts.sinPlazo});
    if ('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(es){
        if (es[0].isIntersecting){ io.disconnect(); disparar(false); }
      }, {threshold:0, rootMargin:(opts.margen || 0) ? opts.margen+'px 0px' : '0px 0px -6% 0px'});
      io.observe(el);
    }
  }
  function repasar(){
    pendientes = pendientes.filter(function(p){
      if (!visible(p.el, p.margen)) return true;
      p.run(false);
      return false;
    });
  }
  // Estrangulado por reloj, no por requestAnimationFrame: con rAF, si el
  // callback no llegaba a ejecutarse (pestaña en segundo plano), el guardián
  // se quedaba pegado y la red de seguridad moría para el resto de la sesión.
  var ultimoRepaso = 0;
  window.addEventListener('scroll', function(){
    if (!pendientes.length) return;
    var ahora = +new Date();
    if (ahora - ultimoRepaso < 100) return;
    ultimoRepaso = ahora;
    repasar();
  }, {passive:true});
  window.addEventListener('resize', repasar, {passive:true});
  // Último recurso: a los 6 s no queda nada oculto, se vea o no. Lo marcado
  // como `sinPlazo` (medición) se queda esperando a verse de verdad.
  setTimeout(function(){
    pendientes = pendientes.filter(function(p){
      if (p.sinPlazo) return true;
      p.run(false);
      return false;
    });
  }, 6000);

  /* ---------- Estado ---------- */
  function load(){
    try{ return JSON.parse(sessionStorage.getItem(KEY)) || {}; }catch(e){ return {}; }
  }
  function save(s){
    try{ sessionStorage.setItem(KEY, JSON.stringify(s)); }catch(e){}
  }
  var state = load();
  state.done  = Array.isArray(state.done) ? state.done : [];
  state.check = state.check || {};
  state.test  = state.test  || {};

  /* ---------- Medición (GTM/GA4). El sitio empuja a dataLayer; gtag solo
       existe si el contenedor lo define, así que se cubren ambos. ---------- */
  function track(name, params){
    params = params || {};
    try{ if (typeof gtag === 'function') gtag('event', name, params); }catch(e){}
    try{
      if (window.dataLayer){
        var p = {event:name};
        for (var k in params){ if (Object.prototype.hasOwnProperty.call(params,k)) p[k] = params[k]; }
        window.dataLayer.push(p);
      }
    }catch(e){}
  }

  /* ---------- Progreso ---------- */
  var fill   = document.getElementById('vjFill');
  var progEl = document.getElementById('vjProg');
  var estEl  = document.getElementById('vjEst');
  var hitos  = [].slice.call(document.querySelectorAll('.vj-hito'));

  function pintarProgreso(){
    var n = state.done.length;
    fill.style.width = (n / TOTAL * 100) + '%';
    progEl.setAttribute('aria-valuenow', n);
    hitos.forEach(function(h){
      h.classList.toggle('vj-done', state.done.indexOf(+h.dataset.hito) !== -1);
    });
    document.querySelectorAll('.vj-next').forEach(function(b){
      var hecho = state.done.indexOf(+b.dataset.next) !== -1;
      b.classList.toggle('vj-hecho', hecho);
      if (hecho && !b.dataset.txtOriginal){
        b.dataset.txtOriginal = b.textContent;
        b.textContent = '✓ ' + b.textContent;
      }
    });
    if (n >= TOTAL) root.classList.add('vj-fin');
  }

  function completar(n, ir){
    if (state.done.indexOf(n) === -1){
      state.done.push(n);
      save(state);
      track('viaje_estacion_completada', {viaje:'lana', estacion:n});
      if (state.done.length >= TOTAL) track('viaje_completado', {viaje:'lana'});
    }
    pintarProgreso();
    var destino = ir && document.querySelector(ir);
    if (destino) destino.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block:'start'});
  }

  document.querySelectorAll('.vj-next').forEach(function(b){
    b.addEventListener('click', function(){ completar(+b.dataset.next, b.dataset.goto); });
  });

  /* ---------- La barra dice el LUGAR, y el marcador dice lo que vale ----------
     Un solo observador alimenta las dos cosas: dónde está el lector y cuánto
     vale su kilo en ese punto del mapa. */
  var kiloV = document.getElementById('vjKiloV');
  var kiloN = document.getElementById('vjKiloN');
  var kiloBox = document.getElementById('vjKilo');
  var VALOR = {
    1: {v:'0,05 €', n:''},
    2: {v:'0,05 €', n:'sale de España valiendo lo mismo'},
    3: {v:'1.500 €', n:'', salto:true},
    4: {v:'0,05 € si se va · 149 € si se queda', n:'el mismo kilo, dos destinos'}
  };
  var saltoHecho = false;

  /* Formato del contador: por debajo de 1 € se mantienen los dos decimales.
     Con Math.round() el arranque se veía como "0 €" — el kilo nunca vale 0. */
  function eurKilo(v){
    if (v < 1) return v.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
    return Math.round(v).toLocaleString('es-ES') + ' €';
  }

  function mostrarPildora(){
    if (!kiloBox.hidden) return;
    kiloBox.hidden = false;
    requestAnimationFrame(function(){ kiloBox.classList.add('vj-kilo--on'); });
    setTimeout(function(){ kiloBox.classList.add('vj-kilo--on'); }, 60);
  }
  function latido(){
    kiloBox.classList.add('vj-kilo--late');
    setTimeout(function(){ kiloBox.classList.remove('vj-kilo--late'); }, 320);
  }

  function pintarKilo(n){
    var d = VALOR[n];
    if (!d) return;
    mostrarPildora();
    kiloN.textContent = d.n;
    if (d.salto){
      // En modo escena el salto pertenece al scrub de E9: aquí no se anima.
      if (escenasListas) return;
      if (!saltoHecho){ saltoHecho = true; animarSalto(); return; }
    }
    kiloV.textContent = d.v;
    latido();
  }

  /* El salto 0,05 € → 1.500 € ocurre ante los ojos del lector, una sola vez. */
  function animarSalto(){
    track('viaje_marcador_salto', {viaje:'lana'});
    if (reduce){ kiloV.textContent = '1.500 €'; latido(); return; }
    // Red de seguridad: si el rAF no llega a correr (pestaña de fondo), el
    // marcador aterriza igual en su valor final. Nunca se queda a medias.
    setTimeout(function(){ kiloV.textContent = '1.500 €'; }, 1800);
    var t0 = null, DUR = 1400;
    function paso(ts){
      if (t0 === null) t0 = ts;
      var k = Math.min(1, (ts - t0) / DUR);
      // arranque lento y disparada final: se siente el salto, no una rampa
      var v = 0.05 + (1500 - 0.05) * Math.pow(k, 3.2);
      kiloV.textContent = k < 1 ? eurKilo(v) : '1.500 €';
      if (k < 1) requestAnimationFrame(paso); else latido();
    }
    requestAnimationFrame(paso);
  }

  /* El tramo activo se calcula del scroll, no de un IntersectionObserver: el
     marcador es la pieza central del viaje y no puede quedarse congelada si el
     callback del observer no llega (pestaña en segundo plano). */
  var secciones = [].slice.call(document.querySelectorAll('.vj-est'));
  var tramoActual = 0;
  function repasarTramo(){
    if (!secciones.length) return;
    var medio = window.innerHeight * 0.42, activo = null;
    for (var i = 0; i < secciones.length; i++){
      var r = secciones[i].getBoundingClientRect();
      if (r.top <= medio && r.bottom > medio){ activo = secciones[i]; break; }
      if (r.top > medio) break;          // aún no ha llegado: se queda el anterior
      activo = secciones[i];             // ya pasó del todo
    }
    if (!activo) return;
    var n = +activo.dataset.est;
    if (n === tramoActual) return;
    tramoActual = n;
    estEl.textContent = activo.dataset.lugar || '';
    pintarKilo(n);
  }
  var ultimoTramo = 0;
  window.addEventListener('scroll', function(){
    var ahora = +new Date();
    if (ahora - ultimoTramo < 120) return;
    ultimoTramo = ahora;
    repasarTramo();
  }, {passive:true});
  window.addEventListener('resize', repasarTramo, {passive:true});
  repasarTramo();

  /* ---------- El camino: la línea se dibuja al entrar en viewport ----------
     El trazo usa vector-effect:non-scaling-stroke, así que el patrón de
     guiones se mide en píxeles de pantalla: la longitud del tramo es la
     altura real del bloque, no las unidades del viewBox. */
  var caminos = [].slice.call(document.querySelectorAll('.vj-camino'));
  function medir(c){
    var p = c.querySelector('.vj-linea-draw');
    var h = Math.round(c.getBoundingClientRect().height);
    p.style.strokeDasharray = h + 'px';
    p.style.strokeDashoffset = (c.classList.contains('vj-drawn') ? 0 : h) + 'px';
  }
  function dibujar(c){
    c.classList.add('vj-drawn');
    c.querySelector('.vj-linea-draw').style.strokeDashoffset = '0px';
  }
  caminos.forEach(medir);
  if (reduce) caminos.forEach(dibujar);
  else caminos.forEach(function(c){ cuandoSeVea(c, dibujar); });
  var reMedir;
  window.addEventListener('resize', function(){
    clearTimeout(reMedir);
    reMedir = setTimeout(function(){ caminos.forEach(medir); }, 180);
  });

  /* ---------- Reveals: en cuanto asoma el bloque, legible ---------- */
  document.querySelectorAll('.vj-rev').forEach(function(el){
    cuandoSeVea(el, function(e, inmediato){
      // Lo que ya se ve al cargar entra directo, sin fundido de entrada.
      e.classList.add('vj-in');
      if (inmediato) e.classList.add('vj-in--now');
    });
  });

  /* ---------- Estación 1: embed de Instagram ----------
     El cartel del reel es el ESTADO NORMAL. El embed solo le quita el sitio
     si cumple las dos condiciones: su iframe ha disparado `load` Y mide de
     verdad. Que el iframe exista, o que tenga alto reservado, no basta:
     Instagram fija la altura antes de pintar nada, y en localhost el embed
     falla casi siempre — con eso se veía una caja oscura vacía.
     Después del cambio se sigue vigilando: si el iframe se cae o se queda
     sin altura, vuelve el cartel. Nunca debe verse un hueco. */
  var igWrap  = document.getElementById('vjIg');
  var igEmbed = document.getElementById('vjIgEmbed');
  var ALTO_MINIMO = 200;

  function altoReal(){
    var f = igEmbed && igEmbed.querySelector('iframe');
    return f ? f.getBoundingClientRect().height : 0;
  }
  var ro = null;
  function mostrarEmbed(){
    if (igWrap.classList.contains('vj-ig-ok')) return;
    if (altoReal() <= ALTO_MINIMO) return;
    igWrap.classList.add('vj-ig-ok');
    vigilar();
  }
  function volverAlCartel(){
    igWrap.classList.remove('vj-ig-ok');
  }
  // Vigilancia permanente, no un sondeo con caducidad: si el embed se queda
  // sin altura o desaparece en cualquier momento, vuelve el cartel.
  function vigilar(){
    var f = igEmbed.querySelector('iframe');
    if (!f || !('ResizeObserver' in window)) return;
    if (ro) ro.disconnect();
    ro = new ResizeObserver(function(){
      if (igWrap.classList.contains('vj-ig-ok') && altoReal() <= ALTO_MINIMO) volverAlCartel();
    });
    ro.observe(f);
  }

  function cargarIG(){
    if (!igWrap || igWrap.dataset.cargado) return;
    igWrap.dataset.cargado = '1';

    // El iframe lo inserta embed.js: se engancha su `load` en cuanto aparece.
    function engancharIframe(f){
      if (!f || f.dataset.enganchado) return;
      f.dataset.enganchado = '1';
      f.addEventListener('load', function(){
        // El alto definitivo llega por postMessage justo después del load.
        setTimeout(mostrarEmbed, 400);
        setTimeout(mostrarEmbed, 1200);
      });
    }
    if ('MutationObserver' in window){
      // Observador permanente y sin desconectar al primer iframe: embed.js
      // puede reemplazarlo (el sustituto necesita su propio `load`) o
      // retirarlo (entonces hay que recuperar el cartel al vuelo).
      var mo = new MutationObserver(function(){
        var f = igEmbed.querySelector('iframe');
        if (f){ engancharIframe(f); vigilar(); }
        else if (igWrap.classList.contains('vj-ig-ok')) volverAlCartel();
      });
      mo.observe(igEmbed, {childList:true, subtree:true});
      // Si el iframe ya estuviera puesto antes de observar.
      engancharIframe(igEmbed.querySelector('iframe'));
    }

    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.instagram.com/embed.js';
    document.body.appendChild(s);
  }
  if (igWrap) cuandoSeVea(igWrap, cargarIG, {margen:400});

  /* ---------- Estación 1: el documental, solo al desplegar ----------
     YouTube no se toca hasta que el lector abre el bloque. */
  var det = document.getElementById('vjDoc');
  if (det){
    det.addEventListener('toggle', function(){
      var caja = det.querySelector('.vj-yt');
      if (!det.open || !caja || caja.dataset.cargado) return;
      caja.dataset.cargado = '1';
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + caja.dataset.yt + '?rel=0';
      f.title = caja.dataset.titulo;
      f.loading = 'lazy';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      caja.appendChild(f);
      track('viaje_documental_abierto', {viaje:'lana', video:caja.dataset.yt});
    });
  }
  var monesma = document.getElementById('vjMonesma');
  if (monesma) monesma.addEventListener('click', function(){
    track('viaje_click_monesma', {viaje:'lana'});
  });

  /* ---------- Estación 2: enlaces a las marcas de lujo ---------- */
  document.querySelectorAll('[data-lujo]').forEach(function(a){
    a.addEventListener('click', function(){
      track('viaje_click_lujo', {viaje:'lana', marca:a.dataset.lujo});
    });
  });

  /* ---------- Estación 2: checklist persistente ---------- */
  document.querySelectorAll('[data-check]').forEach(function(c){
    if (state.check[c.dataset.check]) c.checked = true;
    c.addEventListener('change', function(){
      state.check[c.dataset.check] = c.checked;
      save(state);
    });
  });

  /* ---------- Estación 3: el test ---------- */
  var ELOGIO = 'Lo clavaste';
  var SORPRESA = 'Ahí está la sorpresa';

  function resolver(q, elegida, nueva){
    var ok = q.dataset.ok;
    var acertado = elegida === ok;
    q.querySelectorAll('.vj-opt').forEach(function(o){
      o.disabled = true;
      if (o.dataset.o === ok){
        o.classList.add('vj-ok');
        o.insertAdjacentHTML('beforeend', '<span class="vj-mark" aria-hidden="true">✓</span>');
      } else if (o.dataset.o === elegida){
        o.classList.add('vj-ko');
      }
      if (o.dataset.o === elegida) o.setAttribute('aria-pressed','true');
    });
    var r = q.querySelector('.vj-r');
    r.querySelector('.vj-r-badge').textContent = acertado ? ELOGIO : SORPRESA;
    r.hidden = false;
    if (nueva){
      state.test[q.dataset.q] = elegida;
      save(state);
      track('viaje_test_respuesta', {viaje:'lana', pregunta:+q.dataset.q, acierto:acertado});
    }
  }

  document.querySelectorAll('.vj-q').forEach(function(q){
    q.querySelectorAll('.vj-opt').forEach(function(o){
      o.addEventListener('click', function(){ resolver(q, o.dataset.o, true); });
    });
    if (state.test[q.dataset.q]) resolver(q, state.test[q.dataset.q], false);
  });

  /* ---------- Interludio: la cascada del precio ---------- */
  document.querySelectorAll('.vj-esc-item').forEach(function(item){
    var btn = item.querySelector('.vj-esc-btn');
    var pan = item.querySelector('.vj-esc-p');
    btn.addEventListener('click', function(){
      var abierto = item.hasAttribute('data-abierto');
      if (abierto){ item.removeAttribute('data-abierto'); pan.hidden = true; }
      else {
        item.setAttribute('data-abierto','');
        pan.hidden = false;
        // Solo se mide la primera apertura de cada escalón.
        if (!item.dataset.visto){
          item.dataset.visto = '1';
          track('viaje_cascada_paso', {viaje:'lana', paso:+item.dataset.paso});
        }
      }
      btn.setAttribute('aria-expanded', abierto ? 'false' : 'true');
    });
  });

  /* ---------- Bloque "¿Y por qué no se hace aquí?" (Ramón) ---------- */
  var dosEsc = document.getElementById('vjDosEscaparates');
  if (dosEsc) cuandoSeVea(dosEsc, function(){ track('viaje_dos_escaparates', {viaje:'lana'}); }, {sinPlazo:true});

  var ramon = document.getElementById('por-que-no-aqui');
  if (ramon) cuandoSeVea(ramon, function(){ track('viaje_bloque_ramon', {viaje:'lana'}); }, {sinPlazo:true});
  document.querySelectorAll('.vj-beat').forEach(function(beat){
    var btn = beat.querySelector('.vj-beat-btn');
    var pan = beat.querySelector('.vj-beat-p');
    btn.addEventListener('click', function(){
      var abierto = beat.hasAttribute('data-abierto');
      if (abierto){ beat.removeAttribute('data-abierto'); pan.hidden = true; }
      else {
        beat.setAttribute('data-abierto','');
        pan.hidden = false;
        if (!beat.dataset.visto){
          beat.dataset.visto = '1';
          track('viaje_ramon_beat', {viaje:'lana', beat:+beat.dataset.beat});
        }
      }
      btn.setAttribute('aria-expanded', abierto ? 'false' : 'true');
    });
  });

  /* ---------- Calculadora de coste por uso ----------
     Supuesto declarado: ~50 usos al año. Con 50 € y 4 años → 0,25 €/uso;
     con 20 € y 1 año → 0,40 €/uso. */
  var USOS_ANO = 50;
  var cPrecio = document.getElementById('vjCalcPrecio');
  var cAnos   = document.getElementById('vjCalcAnos');
  if (cPrecio && cAnos){
    var cPrecioV = document.getElementById('vjCalcPrecioV');
    var cAnosV   = document.getElementById('vjCalcAnosV');
    var cRes     = document.getElementById('vjCalcRes');
    var cDetalle = document.getElementById('vjCalcDetalle');
    var medido   = false;
    function eur(n){ return n.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
    function calcular(){
      var precio = +cPrecio.value, anos = +cAnos.value, usos = anos * USOS_ANO;
      cPrecioV.textContent = precio + ' €';
      cAnosV.textContent   = anos + (anos === 1 ? ' año' : ' años');
      cRes.textContent     = eur(precio / usos);
      cDetalle.textContent = precio + ' € entre ' + usos + ' usos (unos ' + USOS_ANO + ' al año durante ' + anos + (anos === 1 ? ' año).' : ' años).');
    }
    function medir(){
      if (medido) return;
      medido = true;
      track('viaje_calculadora_uso', {viaje:'lana'});
    }
    [cPrecio, cAnos].forEach(function(c){
      c.addEventListener('input', calcular);
      c.addEventListener('change', medir);
    });
    calcular();
  }

  /* ---------- Frases copiables (estación 4) ---------- */
  document.querySelectorAll('.vj-copiar').forEach(function(b){
    b.addEventListener('click', function(){
      var texto = b.parentElement.querySelector('q').textContent.trim();
      function ok(){
        b.textContent = '¡Copiada!';
        b.classList.add('vj-copiado');
        setTimeout(function(){ b.textContent = 'Copiar'; b.classList.remove('vj-copiado'); }, 2200);
        track('viaje_frase_copiada', {viaje:'lana', frase:+b.dataset.frase});
      }
      if (navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(texto).then(ok, copiaManual);
      } else copiaManual();
      // Navegadores sin Clipboard API (o sin permiso): textarea + execCommand.
      function copiaManual(){
        try{
          var t = document.createElement('textarea');
          t.value = texto;
          t.setAttribute('readonly','');
          t.style.cssText = 'position:absolute;left:-9999px';
          document.body.appendChild(t);
          t.select();
          document.execCommand('copy');
          document.body.removeChild(t);
          ok();
        }catch(e){
          b.textContent = 'Selecciónala';
        }
      }
    });
  });

  /* ---------- CTAs finales ---------- */
  document.querySelectorAll('[data-cta]').forEach(function(a){
    a.addEventListener('click', function(){
      track('viaje_cta_' + a.dataset.cta, {viaje:'lana'});
    });
  });

  /* ═══════════ ESCENAS E1-E3: GSAP + ScrollTrigger ═══════════
     Progresivo de verdad: la página nace estática y legible; solo cuando GSAP
     ha cargado se añade .vj-gsap y las escenas toman el mando. Si el CDN no
     llega, no pasa nada: columna estática. reduced-motion: ni se intenta. */
  var escenasListas = false;
  function initScenes(){
    if (escenasListas || !window.gsap || !window.ScrollTrigger) return;
    escenasListas = true;
    gsap.registerPlugin(ScrollTrigger);
    root.classList.add('vj-gsap');

    /* ── E1 · Apertura ── */
    var e1 = document.getElementById('apertura');
    var q1 = function(sel){ return e1.querySelector(sel); };
    var hilo = q1('.vj-hilo-draw');
    var hiloL = hilo.getTotalLength();
    gsap.set(hilo, {strokeDasharray: hiloL, strokeDashoffset: hiloL});
    gsap.set(q1('.vj-e1-foto'), {opacity: 0, scale: 1.15});
    gsap.set([q1('[data-e1="2"]'), q1('[data-e1="3"]'), q1('.vj-e1-titulo')], {autoAlpha: 0, y: 28});

    var tl1 = gsap.timeline({
      defaults: {ease: 'none'},
      scrollTrigger: {
        trigger: e1, start: 'top top', end: '+=250%', pin: true, scrub: true,
        onUpdate: function(st){
          // la píldora del kilo nace con el título, una sola vez
          if (st.progress > 0.72 && !e1.dataset.pill){ e1.dataset.pill = '1'; pintarKilo(1); }
        }
      }
    });
    tl1.to(q1('.vj-e1-foto'), {opacity: 1, scale: 1, duration: 38}, 0)
       .to(q1('[data-e1="1"]'), {autoAlpha: 0, y: -26, duration: 7}, 16)
       .to(q1('[data-e1="2"]'), {autoAlpha: 1, y: 0, duration: 7}, 22)
       .to(q1('[data-e1="2"]'), {autoAlpha: 0, y: -26, duration: 7}, 40)
       .to(q1('[data-e1="3"]'), {autoAlpha: 1, y: 0, duration: 7}, 46)
       .to(q1('[data-e1="3"]'), {autoAlpha: 0, y: -26, duration: 7}, 64)
       .to(q1('.vj-e1-titulo'), {autoAlpha: 1, y: 0, duration: 10}, 71)
       .to(hilo, {strokeDashoffset: 0, duration: 22}, 76);

    /* ── E2 · La nave ── */
    var e2 = document.getElementById('nave');
    var mm = gsap.matchMedia();
    mm.add({escritorio: '(min-width: 1024px)', movil: '(max-width: 1023.98px)'}, function(ctx){
      var desk = ctx.conditions.escritorio;
      var q2 = function(sel){ return e2.querySelector(sel); };
      gsap.set(q2('.vj-e2-cinewrap'), {autoAlpha: 0, y: '14vh'});
      gsap.set(q2('.vj-e2-nota'), desk ? {autoAlpha: 0, x: 70} : {autoAlpha: 0, y: 46});
      gsap.set(q2('.vj-e2-bg img'), {yPercent: -6, scale: 1.06});

      var tl2 = gsap.timeline({
        defaults: {ease: 'none'},
        scrollTrigger: {trigger: e2, start: 'top top', end: '+=170%', pin: true, scrub: true}
      });
      tl2.to(q2('.vj-e2-bg img'), {yPercent: 6, duration: 100}, 0)          // parallax lento
         .to(q2('.vj-e2-cinewrap'), {autoAlpha: 1, y: 0, duration: 22}, 4)  // el cine sube
         .to(q2('#vjBadge'), {scale: 1.12, duration: 5}, 30)                // el rótulo late una vez
         .to(q2('#vjBadge'), {scale: 1, duration: 5}, 35);
      if (desk){
        tl2.to(q2('.vj-e2-cinewrap'), {xPercent: -14, scale: .95, duration: 18}, 58)
           .to(q2('.vj-e2-nota'), {autoAlpha: 1, x: 0, duration: 16}, 62);
      } else {
        tl2.to(q2('.vj-cine-lead'), {autoAlpha: 0, y: -20, duration: 10}, 56)
           .to(q2('.vj-e2-cinewrap'), {y: '-9vh', scale: .97, duration: 18}, 58)
           .to(q2('.vj-e2-nota'), {autoAlpha: 1, y: 0, duration: 16}, 64);
      }
      return function(){ tl2.scrollTrigger && tl2.scrollTrigger.kill(); tl2.kill(); };
    });

    /* ── E4/E8 · transiciones (mismo motor, distinto rumbo del hilo) ── */
    function transicion(id, tramoAlAcabar){
      var el = document.getElementById(id);
      if (!el) return;
      var q = function(sel){ return el.querySelector(sel); };
      var hiloT = q('.vj-hilo-draw');
      var LT = hiloT.getTotalLength();
      gsap.set(hiloT, {strokeDasharray: LT, strokeDashoffset: LT});
      gsap.set(q('.vj-tr-fondo--b'), {opacity: 0});
      gsap.set(q('.vj-tr-frase'), {autoAlpha: 0, y: 30});
      var hecho = false;
      gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: el, start: 'top top', end: '+=120%', pin: true, scrub: true,
          onUpdate: function(st){
            if (st.progress > 0.9 && !hecho){ hecho = true; completar(tramoAlAcabar); }
          }}})
        .to(hiloT, {strokeDashoffset: 0, duration: 45}, 0)
        .to(q('.vj-tr-hilo'), {rotation: id === 'se-va' ? 13 : -13, xPercent: id === 'se-va' ? 15 : -15, transformOrigin: '50% 0%', duration: 60}, 15)
        .to(q('.vj-tr-fondo--b'), {opacity: 1, duration: 40}, 8)
        .to(q('.vj-tr-frase'), {autoAlpha: 1, y: 0, duration: 22}, 42);
    }
    transicion('se-va', 1);
    transicion('regreso', 2);

    /* ── E5 · el puerto: pan lateral lento ── */
    var e5 = document.getElementById('puerto');
    if (e5){
      var q5 = function(sel){ return e5.querySelector(sel); };
      gsap.set(q5('.vj-e5-bg img'), {scale: 1.16, xPercent: 6});
      gsap.set(q5('.vj-e5-in'), {autoAlpha: 0, y: 26});
      gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e5, start: 'top top', end: '+=160%', pin: true, scrub: true}})
        .to(q5('.vj-e5-bg img'), {xPercent: -6, duration: 100}, 0)
        .to(q5('.vj-e5-in'), {autoAlpha: 1, y: 0, duration: 20}, 8);
    }

    /* ── E6 · Ramón por pasos: beats de uno en uno, la cita queda ── */
    var e6 = document.getElementById('por-que-no-aqui');
    if (e6){
      var q6 = function(sel){ return e6.querySelector(sel); };
      var pasos6 = [q6('.vj-e6-cabecera'), q6('[data-beat="1"]'), q6('[data-beat="2"]'), q6('[data-beat="3"]'), q6('.vj-e6-cita')];
      pasos6.forEach(function(paso, i){ gsap.set(paso, {autoAlpha: i ? 0 : 1, y: i ? 26 : 0}); });
      var marcas = [0, 26, 44, 62, 82];
      var beatsVistos = {};
      var tl6 = gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e6, start: 'top top', end: '+=260%', pin: true, scrub: true,
          onUpdate: function(st){
            [1, 2, 3].forEach(function(bt){
              if (st.progress > (marcas[bt] + 4) / 100 && !beatsVistos[bt]){
                beatsVistos[bt] = 1;
                track('viaje_ramon_beat', {viaje: 'lana', beat: bt});
              }
            });
          }}});
      tl6.to(pasos6[0], {autoAlpha: 0, y: -26, duration: 6}, 20);
      [1, 2, 3].forEach(function(i){
        tl6.to(pasos6[i], {autoAlpha: 1, y: 0, duration: 7}, marcas[i]);
        tl6.to(pasos6[i], {autoAlpha: 0, y: -26, duration: 6}, marcas[i] + 16);
      });
      tl6.to(pasos6[4], {autoAlpha: 1, y: 0, duration: 10}, marcas[4]);
    }

    /* ── E7 · la escalera se construye; el hilo trepa ── */
    var e7 = document.getElementById('escalera-1');
    if (e7){
      var q7 = function(sel){ return e7.querySelector(sel); };
      var pel1 = q7('[data-paso="1"]'), pel2 = q7('[data-paso="2"]');
      var hilo7 = q7('.vj-hilo-draw');
      var L7 = hilo7.getTotalLength();
      gsap.set([pel1, pel2], {autoAlpha: 0, y: 120});
      gsap.set(hilo7, {strokeDasharray: L7, strokeDashoffset: L7});
      var pasosVistos7 = {};
      gsap.timeline({defaults: {ease: 'none'},
        scrollTrigger: {trigger: e7, start: 'top top', end: '+=170%', pin: true, scrub: true,
          onUpdate: function(st){
            if (st.progress > 0.25 && !pasosVistos7[1]){ pasosVistos7[1] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 1}); }
            if (st.progress > 0.55 && !pasosVistos7[2]){ pasosVistos7[2] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 2}); }
          }}})
        .to(pel1, {autoAlpha: 1, y: 0, duration: 20}, 5)
        .to(pel2, {autoAlpha: 1, y: 0, duration: 20}, 32)
        .to(hilo7, {strokeDashoffset: 0, duration: 32}, 55);
    }

    /* ── E9 · la vitrina se abre y el contador salta bajo el pulgar ── */
    var e9 = document.getElementById('vitrina');
    var contador = document.getElementById('vjContador');
    if (e9 && contador){
      mm.add({escritorio9: '(min-width: 900px)', movil9: '(max-width: 899.98px)'}, function(ctx){
        var desk = ctx.conditions.escritorio9;
        var q9 = function(sel){ return e9.querySelector(sel); };
        var pel3 = q9('[data-paso="3"]'), pel4 = q9('[data-paso="4"]');
        gsap.set(q9('.vj-e9-bg img'), {scale: 1.22});
        gsap.set(q9('.vj-e9-in'), {autoAlpha: 0, y: 20});
        gsap.set([q9('.vj-salto-q'), q9('.vj-salto-n')], {autoAlpha: 0, y: 16});
        gsap.set([pel3, pel4], {autoAlpha: 0, y: 110});
        contador.textContent = '0,05 €';

        var A = 0.26, B = 0.60, saltoScrubHecho = false, pasosVistos9 = {};
        var tl9 = gsap.timeline({defaults: {ease: 'none'},
          scrollTrigger: {trigger: e9, start: 'top top', end: '+=280%', pin: true, scrub: true,
            onUpdate: function(st){
              var pr = st.progress;
              if (pr <= A){
                contador.textContent = '0,05 €'; kiloV.textContent = '0,05 €';
              } else if (pr < B){
                var k = (pr - A) / (B - A);
                var v = 0.05 + (1500 - 0.05) * Math.pow(k, 3.2);
                var txt = eurKilo(v);
                contador.textContent = txt; kiloV.textContent = txt;
                saltoHecho = true; // el auto-salto estático queda anulado
              } else {
                contador.textContent = '1.500 €'; kiloV.textContent = '1.500 €';
                if (!saltoScrubHecho){
                  saltoScrubHecho = true;
                  latido();
                  track('viaje_marcador_salto', {viaje: 'lana'});
                  track('viaje_salto_scrub', {viaje: 'lana'});
                }
              }
              if (pr > 0.76 && !pasosVistos9[3]){ pasosVistos9[3] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 3}); }
              if (pr > 0.9 && !pasosVistos9[4]){ pasosVistos9[4] = 1; track('viaje_cascada_paso', {viaje: 'lana', paso: 4}); }
            }}});
        tl9.to(q9('.vj-e9-puerta--izq'), {xPercent: -101, duration: 20}, 2)
           .to(q9('.vj-e9-puerta--dcha'), {xPercent: 101, duration: 20}, 2)
           .to(q9('.vj-e9-bg img'), {scale: 1.04, duration: 70}, 2)
           .to(q9('.vj-e9-in'), {autoAlpha: 1, y: 0, duration: 10}, 14)
           .to(q9('.vj-salto-q'), {autoAlpha: 1, y: 0, duration: 8}, 61)
           .to(q9('.vj-salto-n'), {autoAlpha: 1, y: 0, duration: 8}, 65)
           .to(pel3, {autoAlpha: 1, y: 0, duration: 11}, 74)
           .to(pel4, {autoAlpha: 1, y: 0, duration: 11}, 85);
        if (!desk){
          // en móvil el matiz cede el sitio a los peldaños
          tl9.to([q9('.vj-salto-q'), q9('.vj-salto-n')], {autoAlpha: 0, y: -14, duration: 8}, 72)
             .to(q9('.vj-e9-contador'), {scale: .8, y: -10, duration: 10}, 72);
        }
        return function(){ tl9.scrollTrigger && tl9.scrollTrigger.kill(); tl9.kill(); };
      });
    }

    /* ── Precarga por escena: las fotos llegan antes que el lector ── */
    setTimeout(function(){
      var sufijo = window.innerWidth > 900 ? '-1600' : '-900';
      ['nave-vellones', 'puerto-contenedores', 'puerto-bobinas', 'interludio-textura', 'escaparate-punto', 'taller-tejiendo', 'cierre-rebano'].forEach(function(nombre){
        var im = new Image();
        im.src = '/assets/images/viaje-lana/' + nombre + sufijo + '.webp';
      });
    }, 900);

    ScrollTrigger.refresh();
    // Las medidas se recalculan cuando llegan las fuentes y tras un respiro:
    // si los starts quedan viejos, los pins actúan en el sitio equivocado.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ ScrollTrigger.refresh(); });
    setTimeout(function(){ ScrollTrigger.refresh(); }, 1200);
  }

  if (!reduce){
    (function(){
      // Optimista: la escena se viste ya (sin destello estático→escena) y si
      // GSAP no ha llegado en 3,5 s se desviste — vuelta a la columna legible.
      root.classList.add('vj-gsap');
      setTimeout(function(){ if (!escenasListas) root.classList.remove('vj-gsap'); }, 3500);
      function carga(src, cb){
        var sc = document.createElement('script');
        sc.src = src; sc.async = true; sc.onload = cb;
        document.head.appendChild(sc);
      }
      carga('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js', function(){
        carga('https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js', initScenes);
      });
    })();
  }

  pintarProgreso();
})();
</script>
</body>
</html>
