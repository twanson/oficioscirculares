<%
/* ===================================================================
   EL VIAJE DE LA LANA — página-hub de la experiencia guiada (/viaje/lana)
   Copys aprobados: Redes/Instagram/Carruseles/2026-08_viaje-de-la-lana/
                    guion_viaje-de-la-lana_v01.md
   Patrón visual: views/conecta-lana.ejs (foto a sangre + degradado teñido)
                  views/club.ejs (reveals al scroll)
   =================================================================== */

// URL del post de Instagram del viaje. PENDIENTE: pegarla aquí al publicar.
// Mientras esté vacía, el CTA "Vuelve al post" no se renderiza.
const POST_URL = '';

// Newsletter "La Carta Circular". El sitio no tiene todavía página propia de
// suscripción: apuntamos al formulario de alta que ya usan la home y las
// verticales. Si La Carta Circular estrena formulario propio, se cambia aquí.
const CARTA_URL = 'https://tally.so/r/mOyV98?utm_source=viaje-lana&utm_medium=web&utm_content=carta-circular';
%>
<%- include('partials/head-meta', {
    title: 'El Viaje de la Lana | Oficios Circulares',
    description: 'Una experiencia guiada de 15-20 minutos: de la mejor lana de Europa malvendida a céntimos al jersey de lujo de 1.500 €. Descubre qué pasa por el camino.',
    canonical: '/viaje/lana',
    ogImage: 'https://www.oficioscirculares.com/assets/images/viaje-lana/og-viaje-lana.jpg',
    ogImageAlt: 'Esquila a tijera de una oveja — El Viaje de la Lana, Oficios Circulares'
}) %>
<style>
/* ===================================================================
   EL VIAJE DE LA LANA — v12: el target visual es public/mockup-viaje-v12
   (aprobado por Jose pantalla a pantalla). Este CSS porta ese código;
   donde haya duda, gana el mockup. Grid 12 col / gap 32 / margen 96.
   =================================================================== */
html,body{overflow-x:clip}
body{background:#fbf6ec}

.vj{
  --primary:#023429;--verde-2:#06241c;--navy:#0a1220;--verde-hoja:#3E7C59;
  --terra:#b45817;--terra-claro:#d98a4f;--oro:#f6c98a;
  --crema:#fbf6ec;--ambar:#f5ecdd;
  --tinta:#1b1c1c;--tinta-2:#5c6360;
  --hair:rgba(2,52,41,.16);--hair-luz:rgba(251,246,236,.16);
  --f-head:'Newsreader',Georgia,serif;--f-body:'Manrope',sans-serif;--f-ui:'Nunito',sans-serif;
  --bar:56px;
  font-family:var(--f-body);color:var(--tinta);line-height:1.62;-webkit-font-smoothing:antialiased;background:var(--crema)
}
.vj :where(h1,h2,h3,h4,p){margin:0}
.vj a{text-decoration:none}
.vj a:not([class]){color:inherit}
.vj img{display:block}
.vj :focus-visible{outline:3px solid var(--oro);outline-offset:3px;border-radius:6px}

/* ── el grid del mockup: 12 col, gap 32, margen 96 ── */
.vj-grid{position:relative;z-index:3;max-width:1440px;margin:0 auto;padding:0 22px}
@media(min-width:980px){.vj-grid{display:grid;grid-template-columns:repeat(12,1fr);column-gap:32px;padding:0 96px}}

/* kicker de línea (el del mockup: guion + versalitas) */
.vj-kick{display:inline-flex;align-items:center;gap:10px;font-family:var(--f-body);font-weight:800;font-size:12px;letter-spacing:.2em;text-transform:uppercase}
.vj-kick::before{content:"";width:26px;height:1px;background:currentColor;opacity:.6;flex:0 0 auto}

/* subrayado a mano */
.vj-sub-mano{position:relative;white-space:nowrap}
.vj-sub-mano svg{position:absolute;left:0;bottom:-6px;width:100%;height:8px;overflow:visible;pointer-events:none}
.vj-sub-mano svg path{fill:none;stroke:var(--terra-claro);stroke-width:2.6;stroke-linecap:round;vector-effect:non-scaling-stroke}

.vj-eur{font-size:.6em;vertical-align:top;margin-left:.05em;letter-spacing:0}

/* ── barra sticky + progreso ── */
.vj-bar{position:sticky;top:0;z-index:100;background:#03231b;border-bottom:1px solid rgba(246,201,138,.2);box-shadow:0 6px 22px rgba(2,32,25,.34)}
.vj-main{position:relative;z-index:0}
.vj-bar-in{display:flex;align-items:center;justify-content:space-between;gap:12px;height:var(--bar);padding:0 14px;max-width:1100px;margin:0 auto}
.vj-brand{display:flex;align-items:center;gap:9px;min-width:0}
.vj-brand img{height:26px;width:auto;filter:drop-shadow(0 2px 8px rgba(0,0,0,.5))}
.vj-brand b{font-family:var(--f-ui);font-weight:800;font-size:.8rem;color:var(--crema);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vj-bar-est{font-family:var(--f-ui);font-weight:800;font-size:.72rem;letter-spacing:.04em;color:var(--oro);white-space:nowrap}
.vj-track{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(246,201,138,.16)}
.vj-fill{height:100%;width:0;background:linear-gradient(90deg,#3E7C59,#f6c98a);transition:width .55s cubic-bezier(.4,0,.2,1)}
@media(max-width:359px){.vj-brand b{display:none}}
@media(min-width:640px){.vj-bar-in{padding:0 24px}.vj-brand img{height:32px}.vj-brand b{font-size:.94rem}.vj-bar-est{font-size:.84rem}}

/* ── la píldora del kilo (estilo del board 1, +15% en v13) ──
   Al cambiar de valor se expande ~2,2s mostrando el salto viejo → nuevo y
   luego se recoge. Anclada abajo-izquierda: al crecer sube, nunca tapa. ── */
.vj-kilo{position:fixed;left:16px;bottom:16px;z-index:80;display:flex;align-items:baseline;gap:11px;padding:12px 21px;border-radius:100px;background:rgba(2,30,23,.94);border:1px solid rgba(246,201,138,.45);box-shadow:0 12px 32px rgba(0,0,0,.28);opacity:0;transform:translateY(10px);transform-origin:left bottom;transition:opacity .35s ease,transform .35s ease;max-width:calc(100vw - 32px)}
.vj-kilo.vj-kilo--on{opacity:1;transform:none}
.vj-kilo[hidden]{display:none}
.vj-kilo-txt{display:flex;align-items:baseline;gap:11px;white-space:nowrap;min-height:34px}
.vj-kilo-k{font-weight:800;font-size:12.5px;letter-spacing:.18em;text-transform:uppercase;color:rgba(251,246,236,.75);flex:0 0 auto}
.vj-kilo-v{font-family:var(--f-head);font-weight:600;font-size:21px;color:var(--oro);font-feature-settings:"tnum";letter-spacing:-.01em;transition:opacity .2s ease}
.vj-kilo-v.vj-fundido{opacity:0}
.vj-kilo-v.vj-kilo-v--larga{font-size:16px}
.vj-kilo-n{display:none}
/* el salto: solo visible mientras la píldora está expandida */
.vj-kilo-salto{display:none;align-items:baseline;gap:9px;font-family:var(--f-head);font-weight:600;font-size:19px;line-height:1.25;color:rgba(251,246,236,.62);font-feature-settings:"tnum"}
.vj-kilo-salto b{color:var(--oro);font-weight:600}
.vj-kilo-salto i{font-style:normal;opacity:.7;font-size:.86em}
.vj-kilo-salto u{text-decoration:none;font-family:var(--f-body);font-weight:700;font-size:.62em;letter-spacing:.02em;color:rgba(251,246,236,.7)}
.vj-kilo--salto .vj-kilo-v{display:none}
.vj-kilo--salto .vj-kilo-salto{display:flex;flex-wrap:wrap;animation:vj-kilo-entra .3s ease-out}
@keyframes vj-kilo-entra{from{opacity:0}to{opacity:1}}
.vj-kilo.vj-kilo--pulso{animation:vj-kilo-pulso .55s cubic-bezier(.22,1,.36,1)}
@keyframes vj-kilo-pulso{0%{transform:scale(1)}45%{transform:scale(1.06)}100%{transform:scale(1)}}
@media(prefers-reduced-motion:reduce){
  .vj-kilo.vj-kilo--pulso{animation:none}
  .vj-kilo--salto .vj-kilo-salto{animation:none}
}
@media(min-width:980px){
  .vj-kilo{left:40px;bottom:36px;padding:14px 25px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);max-width:none}
  .vj-kilo-txt{min-height:41px}
  .vj-kilo-v{font-size:25px}
  .vj-kilo-v.vj-kilo-v--larga{font-size:18px}
  .vj-kilo-salto{font-size:22px;flex-wrap:nowrap;white-space:nowrap}
}

/* ══ BOARD 1 · APERTURA ══ */
.vj-hero{position:relative;min-height:calc(100svh - var(--bar));background:var(--verde-2);overflow:hidden;display:flex;flex-direction:column}
.vj-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 40%}
.vj-hero-velo{position:absolute;inset:0;background:linear-gradient(100deg,rgba(4,26,20,.93) 22%,rgba(4,26,20,.55) 52%,rgba(4,26,20,.18) 78%)}
.vj-hero .vj-grid{padding-top:72px;width:100%}
.vj-hero .vj-kick{color:var(--oro)}
.vj-hero h1{margin-top:22px;font-family:var(--f-head);font-weight:600;font-size:clamp(52px,7.23vw,104px);line-height:.96;letter-spacing:-.02em;color:#fff}
.vj-hero h1 em{font-style:italic;color:var(--terra-claro)}
.vj-hero-hist{margin-top:36px;display:flex;flex-direction:column;gap:16px}
.vj-hero-hist p{font-family:var(--f-head);font-size:clamp(19px,1.74vw,25px);line-height:1.34;color:rgba(255,255,255,.94);font-weight:500;max-width:30ch}
.vj-hero-hist p b{color:var(--oro);font-weight:600}
.vj-desliza{position:relative;margin:34px auto 0;display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(251,246,236,.65);font-family:var(--f-body);font-weight:700;font-size:10px;letter-spacing:.28em;text-transform:uppercase;z-index:4}
.vj-desliza::before{content:"";width:1px;height:30px;background:linear-gradient(180deg,transparent,var(--oro));animation:vj-pulso 1.8s ease-in-out infinite}
@keyframes vj-pulso{0%,100%{opacity:.5;transform:translateY(0)}50%{opacity:1;transform:translateY(5px)}}
@media(prefers-reduced-motion:reduce){.vj-desliza::before{animation:none}}
.vj-abajo{position:relative;z-index:4;margin:26px 22px 0;padding:18px 0 26px;display:flex;flex-direction:column;gap:16px;border-top:1px solid rgba(251,246,236,.22)}
.vj-hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;color:rgba(251,246,236,.85);font-size:14px;letter-spacing:.06em}
.vj-hero-meta i{font-style:normal;opacity:.5}
.vj-cta-terra{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--terra);color:#fff;border-radius:100px;padding:17px 34px;font-family:var(--f-body);font-weight:800;font-size:16px;box-shadow:0 14px 34px rgba(0,0,0,.35);transition:transform .22s ease,filter .22s ease}
.vj-cta-terra:hover{transform:translateY(-2px);filter:brightness(1.06)}
@media(min-width:980px){
  .vj-hero .vj-grid{padding-top:132px}
  .vj-hero .vj-kick{grid-column:1/7}
  .vj-hero h1{grid-column:1/9}
  .vj-hero-hist{grid-column:1/7;margin-top:44px;gap:18px}
  .vj-desliza{position:absolute;left:50%;bottom:110px;transform:translateX(-50%);margin:0}
  .vj-abajo{flex-direction:row;align-items:center;justify-content:space-between;margin:80px 96px 0;padding:22px 0 44px}
  .vj-hero-meta{gap:8px 26px}
}

/* ══ BOARD 2 · PARADAS: foto-banda + tarjeta glass + cuerpo 5/6 ══ */
.vj-pfoto{position:relative;height:clamp(400px,62vh,520px);overflow:hidden}
.vj-pfoto>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.vj-velo{position:absolute;inset:0;background:linear-gradient(12deg,var(--va) 8%,var(--vb) 45%,var(--vc) 75%)}
.vj-pcard{position:absolute;left:22px;right:22px;bottom:26px;z-index:3;max-width:460px;background:rgba(251,249,246,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:22px;padding:28px 28px;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.vj-pcard .vj-kick{color:var(--terra)}
.vj-pcard h2{font-family:var(--f-head);font-size:clamp(42px,4.45vw,64px);font-weight:600;line-height:1;color:var(--primary);margin-top:10px}
.vj-pcard h2 em{font-style:italic;color:var(--terra)}
.vj-pcard p{margin-top:12px;font-size:16px;font-weight:600;color:var(--tinta-2);letter-spacing:.01em}
@media(min-width:980px){
  .vj-pfoto{height:600px}
  .vj-pcard{left:96px;right:auto;bottom:56px;padding:38px 42px}
}
.vj-pcuerpo{background:var(--crema);padding:52px 0 56px}
.vj-plead .vj-kick{color:var(--terra)}
.vj-lead2{margin-top:18px;font-family:var(--f-head);font-size:clamp(22px,2.09vw,30px);line-height:1.4;font-weight:500;color:var(--tinta)}
.vj-lead2 em{font-style:italic;color:var(--terra)}
.vj-plado{margin-top:44px}
.vj-pfig{margin:0}
.vj-pfig img{width:100%;height:clamp(280px,40vw,420px);object-fit:cover;border-radius:18px;box-shadow:0 18px 44px rgba(2,52,41,.18)}
.vj-pfig figcaption,.vj-pfigpie{margin-top:14px;font-size:14.5px;line-height:1.55;color:var(--tinta-2);font-style:italic}
.vj-dato{margin-top:34px;border-top:1px solid var(--hair);padding-top:22px;display:flex;gap:18px;align-items:baseline}
.vj-dato b{font-family:var(--f-head);font-size:clamp(34px,3.06vw,44px);color:var(--primary);font-weight:600;white-space:nowrap;line-height:1}
.vj-dato b small{font-size:.45em;opacity:.85}
.vj-dato b i{font-style:italic}
.vj-dato span{font-size:15.5px;line-height:1.5;color:var(--tinta-2);max-width:34ch}
.vj-dato span strong{color:var(--tinta)}
.vj-dato .vj-fuente-c{display:block;margin-top:8px;font-size:12px;color:#8a8070}
@media(min-width:980px){
  .vj-pcuerpo{padding:88px 0 96px}
  .vj-plead{grid-column:1/6}
  .vj-plado{grid-column:7/13;margin-top:0}
}

/* la tarjeta-cine ocupa el slot de la figura en La nave */
.vj-media{max-width:420px}
.vj-ig{position:relative;display:grid;border-radius:22px;box-shadow:0 18px 44px rgba(2,52,41,.28)}
.vj-ig-card{grid-area:1/1;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;aspect-ratio:9/16;padding:28px 22px;border-radius:22px;overflow:hidden;background:#06251c;cursor:pointer;text-align:center}
.vj-ig-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5}
.vj-ig-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,25,19,.6),rgba(3,25,19,.9))}
.vj-ig-card>*{position:relative;z-index:2}
.vj-ig-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:100px;background:rgba(246,201,138,.14);border:1px solid rgba(246,201,138,.42);color:var(--oro);font-weight:800;font-size:11px;letter-spacing:.18em;text-transform:uppercase}
.vj-ig-play{flex:0 0 auto;width:72px;height:72px;border-radius:50%;background:var(--terra);color:#fff!important;display:flex;align-items:center;justify-content:center;font-size:1.6rem;box-shadow:0 14px 34px rgba(0,0,0,.45);border:0;cursor:pointer;font-family:inherit}
.vj-ig-card b{font-family:var(--f-head);font-size:clamp(1.15rem,4.4vw,1.5rem);font-weight:600;color:#fff;line-height:1.2;max-width:16ch}
.vj-ig-card small{color:rgba(251,246,236,.76);font-size:.9rem;line-height:1.45;max-width:26ch}
.vj .vj-ig-card a{display:inline-flex;align-items:center;gap:8px;margin-top:2px;padding:13px 22px;border-radius:100px;background:var(--terra);color:#fff;font-weight:800;font-size:.95rem;white-space:nowrap}

/* documental */
.vj-det{margin-top:34px;border:1px solid var(--hair);border-radius:18px;background:#fff;overflow:hidden;box-shadow:0 14px 36px rgba(2,52,41,.1)}
.vj-det summary{cursor:pointer;list-style:none;padding:19px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-weight:800;font-size:1.05rem;color:var(--primary)}
.vj-det summary::-webkit-details-marker{display:none}
.vj-det summary::after{content:"↓";color:var(--terra);font-size:1.1rem;transition:transform .25s ease;flex:0 0 auto}
.vj-det[open] summary::after{transform:rotate(180deg)}
.vj-det-in{padding:0 16px 18px}
.vj-yt{position:relative;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#0d0d0d}
.vj-yt iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vj-det-in p{font-size:.98rem!important;color:var(--tinta-2);margin-top:14px!important;line-height:1.6}
.vj .vj-det-link{display:inline-block;margin-top:12px;font-weight:700;font-size:.94rem;line-height:1.45;color:var(--terra);text-decoration:underline;text-underline-offset:3px}
.vj .vj-det-link:hover{color:var(--primary)}

/* ── interludios: banda sólida con el tinte del tramo al que se entra.
   Sin foto: ninguna imagen debe tocar a otra imagen. ── */
.vj-inter{position:relative;min-height:46vh;display:flex;align-items:center;justify-content:center;padding:clamp(56px,9vh,88px) 22px;text-align:center;background:var(--fondo)}
.vj-inter-nudo{width:24px;height:auto;margin:0 auto 22px;display:block;overflow:visible}
/* a 24px el trazo escalado se quedaba en 1,3px y el nudo era un borrón */
.vj-inter-nudo path{fill:none;stroke:var(--terra-claro);stroke-width:1.7;vector-effect:non-scaling-stroke;stroke-linejoin:round}
.vj-luz2{position:absolute;inset:0;pointer-events:none;background:
  radial-gradient(140% 120% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,.25) 100%),
  linear-gradient(165deg, var(--ta), var(--tb))}
.vj-luz2--pie{background:
  linear-gradient(180deg, rgba(0,0,0,0) 50%, var(--tb) 100%),
  radial-gradient(140% 120% at 50% 50%, rgba(0,0,0,0) 55%, rgba(0,0,0,.25) 100%),
  linear-gradient(165deg, var(--ta), var(--tb))}
.vj-inter-in{position:relative;z-index:2}
.vj-tr-frase{max-width:17ch;margin:0 auto;font-family:var(--f-head);font-weight:600;font-size:clamp(1.9rem,7vw,3rem);line-height:1.2;color:#fff;letter-spacing:-.015em}
.vj-tr-frase em{font-style:italic;color:var(--terra-claro)}

/* ══ BOARD 3 · RAMÓN ══ */
.vj-ramon{background:var(--navy);padding:56px 0 48px}
.vj-ramon .vj-kick{color:var(--oro)}
.vj-rcab h2{margin-top:18px;font-family:var(--f-head);font-size:clamp(38px,5vw,72px);font-weight:600;line-height:1;color:#fff;max-width:14ch}
.vj-rcab h2 em{font-style:italic;color:var(--terra-claro)}
.vj-rmargen{margin-top:34px;border-left:2px solid rgba(246,201,138,.5);padding-left:22px}
.vj-rmargen p{font-size:15px;line-height:1.6;color:rgba(251,246,236,.8)}
.vj-rmargen b{color:var(--oro);font-weight:700}
.vj-rquien{margin-top:14px!important;font-size:13px!important;letter-spacing:.06em;color:rgba(251,246,236,.55)!important;text-transform:uppercase}
.vj-avatar{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid rgba(246,201,138,.5);margin-bottom:14px;display:block}
.vj-beats{display:grid;grid-template-columns:1fr;gap:34px;margin-top:44px;border-top:1px solid var(--hair-luz);padding-top:38px}
.vj-beat i{font-family:var(--f-head);font-style:italic;font-size:15px;color:var(--terra-claro);display:inline-flex;width:28px;height:28px;border:1px solid rgba(217,138,79,.55);border-radius:50%;align-items:center;justify-content:center}
.vj-beat h3{margin:14px 0 10px;font-size:18.5px;font-weight:800;line-height:1.35;color:#fff}
.vj-beat p{font-size:15.5px;line-height:1.62;color:rgba(251,246,236,.78)}
.vj-matriz{margin-top:16px;display:grid;grid-template-columns:repeat(13,12px);gap:6px}
.vj-matriz i{width:9px;height:9px;border-radius:50%;background:rgba(251,246,236,.14)}
.vj-matriz i.vj-on{background:var(--oro);box-shadow:0 0 8px rgba(246,201,138,.5)}
.vj-matriz-nota{margin-top:10px!important;font-size:12px!important;letter-spacing:.06em;color:rgba(251,246,236,.5)!important}
.vj-citaz{margin-top:44px;position:relative;border-radius:20px;overflow:hidden;padding:48px 26px;text-align:center}
.vj-citaz>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 45%}
.vj-citaz-velo{position:absolute;inset:0;background:linear-gradient(120deg,rgba(6,14,26,.94),rgba(6,14,26,.72))}
.vj-citaz-in{position:relative;z-index:2}
.vj-citaz blockquote{font-family:var(--f-head);font-style:italic;font-weight:500;font-size:clamp(26px,2.92vw,42px);line-height:1.28;color:#fff;max-width:26ch;margin:0 auto}
.vj-citaz blockquote .vj-oro{color:var(--oro)}
