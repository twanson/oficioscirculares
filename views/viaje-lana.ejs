<script>
/* ===================================================================
   EL VIAJE DE LA LANA — lógica de la experiencia. Vanilla, sin librerías.
   Estado (progreso + checklist + test) en sessionStorage: sobrevive a un
   refresh pero no convierte el viaje en algo eterno.
   =================================================================== */
(function(){
  'use strict';

  var KEY = 'vjLana';
  var TOTAL = 4;
  var root = document.getElementById('vj');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Activa los estados ocultos de los reveals. Sin esta clase todo se ve:
  // si el script fallara, nadie se queda con bloques a medio pintar.
  root.classList.add('vj-js');

  /* ---------- "Cuando esto se vea, haz aquello" ----------
     IntersectionObserver como vía principal, pero con dos redes debajo: un
     repaso en cada scroll (pasivo, con rAF) y un plazo máximo. Depender solo
     del observer dejaba bloques semitransparentes si el callback no llegaba. */
  var pendientes = [];
  function visible(el, margen){
    var r = el.getBoundingClientRect();
    return r.top < window.innerHeight + (margen || 0) && r.bottom > -(margen || 0);
  }
  function cuandoSeVea(el, fn, opts){
    opts = opts || {};
    var hecho = false;
    function disparar(inmediato){
      if (hecho) return;
      hecho = true;
      fn(el, inmediato === true);
    }
    if (visible(el, opts.margen)) { disparar(true); return; }
    // sinPlazo: lo que mide (no lo que pinta) nunca debe dispararlo el
    // temporizador de seguridad — solo el haber estado de verdad en pantalla.
    pendientes.push({el:el, margen:opts.margen || 0, run:disparar, sinPlazo:!!opts.sinPlazo});
    if ('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(es){
        if (es[0].isIntersecting){ io.disconnect(); disparar(false); }
      }, {threshold:0, rootMargin:(opts.margen || 0) ? opts.margen+'px 0px' : '0px 0px -6% 0px'});
      io.observe(el);
    }
  }
  function repasar(){
    pendientes = pendientes.filter(function(p){
      if (!visible(p.el, p.margen)) return true;
      p.run(false);
      return false;
    });
  }
  // Estrangulado por reloj, no por requestAnimationFrame: con rAF, si el
  // callback no llegaba a ejecutarse (pestaña en segundo plano), el guardián
  // se quedaba pegado y la red de seguridad moría para el resto de la sesión.
  var ultimoRepaso = 0;
  window.addEventListener('scroll', function(){
    if (!pendientes.length) return;
    var ahora = +new Date();
    if (ahora - ultimoRepaso < 100) return;
    ultimoRepaso = ahora;
    repasar();
  }, {passive:true});
  window.addEventListener('resize', repasar, {passive:true});
  // Último recurso: a los 6 s no queda nada oculto, se vea o no. Lo marcado
  // como `sinPlazo` (medición) se queda esperando a verse de verdad.
  setTimeout(function(){
    pendientes = pendientes.filter(function(p){
      if (p.sinPlazo) return true;
      p.run(false);
      return false;
    });
  }, 6000);

  /* ---------- Estado ---------- */
  function load(){
    try{ return JSON.parse(sessionStorage.getItem(KEY)) || {}; }catch(e){ return {}; }
  }
  function save(s){
    try{ sessionStorage.setItem(KEY, JSON.stringify(s)); }catch(e){}
  }
  var state = load();
  state.done  = Array.isArray(state.done) ? state.done : [];
  state.check = state.check || {};
  state.test  = state.test  || {};

  /* ---------- Medición (GTM/GA4). El sitio empuja a dataLayer; gtag solo
       existe si el contenedor lo define, así que se cubren ambos. ---------- */
  function track(name, params){
    params = params || {};
    try{ if (typeof gtag === 'function') gtag('event', name, params); }catch(e){}
    try{
      if (window.dataLayer){
        var p = {event:name};
        for (var k in params){ if (Object.prototype.hasOwnProperty.call(params,k)) p[k] = params[k]; }
        window.dataLayer.push(p);
      }
    }catch(e){}
  }

  /* ---------- Progreso ---------- */
  var fill   = document.getElementById('vjFill');
  var progEl = document.getElementById('vjProg');
  var estEl  = document.getElementById('vjEst');
  var hitos  = [].slice.call(document.querySelectorAll('.vj-hito'));

  function pintarProgreso(){
    var n = state.done.length;
    fill.style.width = (n / TOTAL * 100) + '%';
    progEl.setAttribute('aria-valuenow', n);
    hitos.forEach(function(h){
      h.classList.toggle('vj-done', state.done.indexOf(+h.dataset.hito) !== -1);
    });
    document.querySelectorAll('.vj-next').forEach(function(b){
      var hecho = state.done.indexOf(+b.dataset.next) !== -1;
      b.classList.toggle('vj-hecho', hecho);
      if (hecho && !b.dataset.txtOriginal){
        b.dataset.txtOriginal = b.textContent;
        b.textContent = '✓ ' + b.textContent;
      }
    });
    if (n >= TOTAL) root.classList.add('vj-fin');
  }

  function completar(n, ir){
    if (state.done.indexOf(n) === -1){
      state.done.push(n);
      save(state);
      track('viaje_estacion_completada', {viaje:'lana', estacion:n});
      if (state.done.length >= TOTAL) track('viaje_completado', {viaje:'lana'});
    }
    pintarProgreso();
    var destino = ir && document.querySelector(ir);
    if (destino) destino.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block:'start'});
  }

  document.querySelectorAll('.vj-next').forEach(function(b){
    b.addEventListener('click', function(){
      if (+b.dataset.next === 4 && window.__vjOnda) window.__vjOnda();
      completar(+b.dataset.next, b.dataset.goto);
    });
  });

  /* ---------- La barra dice el LUGAR, y el marcador dice lo que vale ----------
     Un solo observador alimenta las dos cosas: dónde está el lector y cuánto
     vale su kilo en ese punto del mapa. */
  var kiloV = document.getElementById('vjKiloV');
  var kiloN = document.getElementById('vjKiloN');
  var kiloBox = document.getElementById('vjKilo');
  var VALOR = {
    1: {v:'0,05 €', n:''},
    2: {v:'0,05 €', n:'sale valiendo lo mismo'},
    3: {v:'1.500 €', n:'', salto:true},
    4: {v:'149 €', n:'el kilo que se quedó'}
  };
  var saltoHecho = false;

  /* Formato del contador: por debajo de 1 € se mantienen los dos decimales.
     Con Math.round() el arranque se veía como "0 €" — el kilo nunca vale 0. */
  function eurKilo(v){
    if (v < 1) return v.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €';
    return Math.round(v).toLocaleString('es-ES') + ' €';
  }
  // Pinta una cifra con el € al 60% (v8·4). Solo recibe strings propios.
  function pintarEuro(el, txt){
    el.innerHTML = txt.replace(/€/g, '<span class="vj-eur">€</span>');
  }

  function mostrarPildora(){
    if (!kiloBox.hidden) return;
    kiloBox.hidden = false;
    requestAnimationFrame(function(){ kiloBox.classList.add('vj-kilo--on'); });
    setTimeout(function(){ kiloBox.classList.add('vj-kilo--on'); }, 60);
  }
  function latido(){
    kiloBox.classList.add('vj-kilo--late');
    setTimeout(function(){ kiloBox.classList.remove('vj-kilo--late'); }, 320);
  }

  function pintarKilo(n){
    var d = VALOR[n];
    if (!d) return;
    mostrarPildora();
    if (kiloN.textContent !== d.n) kiloN.textContent = d.n;
    if (d.salto){
      if (escenasListas){
        // El scrub de E9 es el dueño del salto — pero si el lector ATERRIZA
        // aquí (anchor, back/forward), el valor sale de la posición real.
        var stE9 = window.ScrollTrigger && ScrollTrigger.getAll().find(function(t){ return t.trigger.id === 'vitrina'; });
        if (stE9){
          if (window.scrollY >= stE9.end - 10){ saltoHecho = true; pintarEuro(kiloV, '1.500 €'); }
          else if (window.scrollY <= stE9.start + 10 && kiloV.textContent.indexOf('0,05') < 0) pintarEuro(kiloV, '0,05 €');
        }
        return;
      }
      if (!saltoHecho){ saltoHecho = true; animarSalto(); return; }
    }
    if (kiloV.textContent !== d.v){
      pintarEuro(kiloV, d.v);
      latido();
    }
  }

  /* El salto 0,05 € → 1.500 € ocurre ante los ojos del lector, una sola vez. */
  function animarSalto(){
    track('viaje_marcador_salto', {viaje:'lana'});
    if (reduce){ kiloV.textContent = '1.500 €'; latido(); return; }
    // Red de seguridad: si el rAF no llega a correr (pestaña de fondo), el
    // marcador aterriza igual en su valor final. Nunca se queda a medias.
    setTimeout(function(){ kiloV.textContent = '1.500 €'; }, 1800);
    var t0 = null, DUR = 1400;
    function paso(ts){
      if (t0 === null) t0 = ts;
      var k = Math.min(1, (ts - t0) / DUR);
      // arranque lento y disparada final: se siente el salto, no una rampa
      var v = 0.05 + (1500 - 0.05) * Math.pow(k, 3.2);
      kiloV.textContent = k < 1 ? eurKilo(v) : '1.500 €';
      if (k < 1) requestAnimationFrame(paso); else latido();
    }
    requestAnimationFrame(paso);
  }

  /* El tramo activo se calcula del scroll, no de un IntersectionObserver: el
     marcador es la pieza central del viaje y no puede quedarse congelada si el
     callback del observer no llega (pestaña en segundo plano). */
  var secciones = [].slice.call(document.querySelectorAll('.vj-est'));
  var tramoActual = 0;
  function repasarTramo(){
    if (!secciones.length) return;
    var medio = window.innerHeight * 0.42, activo = null;
    for (var i = 0; i < secciones.length; i++){
      var r = secciones[i].getBoundingClientRect();
      if (r.top <= medio && r.bottom > medio){ activo = secciones[i]; break; }
      if (r.top > medio) break;          // aún no ha llegado: se queda el anterior
      activo = secciones[i];             // ya pasó del todo
    }
    if (!activo){
      // Por encima de la primera parada: estado de arranque. Solo si la
      // píldora ya nació (su nacimiento narrativo es del título de E1).
      if (!kiloBox.hidden && kiloV.textContent.indexOf('0,05') < 0){
        pintarEuro(kiloV, '0,05 €');
        kiloN.textContent = '';
        estEl.textContent = 'La nave';
      }
      return;
    }
    var n = +activo.dataset.est;
    tramoActual = n;
    if (estEl.textContent !== (activo.dataset.lugar || '')) estEl.textContent = activo.dataset.lugar || '';
    pintarKilo(n);
  }
  var ultimoTramo = 0, colaTramo = null;
  window.addEventListener('scroll', function(){
    var ahora = +new Date();
    if (ahora - ultimoTramo >= 120){ ultimoTramo = ahora; repasarTramo(); }
    // pasada de scroll-end (v9·4): con anchors o saltos bruscos, el estado
    // final se recoge siempre
    clearTimeout(colaTramo);
    colaTramo = setTimeout(repasarTramo, 180);
  }, {passive:true});
  window.addEventListener('resize', repasarTramo, {passive:true});
  repasarTramo();

  /* ── Indicador "Desliza" (v9·3): fuera al primer scroll; vuelve tras 5 s
     quietos, solo mientras el lector siga en E1-E2. ── */
  var desliza = document.getElementById('vjDesliza');
  if (desliza){
    var quietoT = null;
    window.addEventListener('scroll', function(){
      desliza.classList.add('vj-oculto');
      clearTimeout(quietoT);
      quietoT = setTimeout(function(){
        if (window.scrollY < window.innerHeight * 5) desliza.classList.remove('vj-oculto');
      }, 5000);
    }, {passive:true});
  }

  /* ---------- El camino: la línea se dibuja al entrar en viewport ----------
     El trazo usa vector-effect:non-scaling-stroke, así que el patrón de
     guiones se mide en píxeles de pantalla: la longitud del tramo es la
     altura real del bloque, no las unidades del viewBox. */
  var caminos = [].slice.call(document.querySelectorAll('.vj-camino'));
  function medir(c){
    var p = c.querySelector('.vj-linea-draw');
    var h = Math.round(c.getBoundingClientRect().height);
    p.style.strokeDasharray = h + 'px';
    p.style.strokeDashoffset = (c.classList.contains('vj-drawn') ? 0 : h) + 'px';
  }
  function dibujar(c){
    c.classList.add('vj-drawn');
    c.querySelector('.vj-linea-draw').style.strokeDashoffset = '0px';
  }
  caminos.forEach(medir);
  if (reduce) caminos.forEach(dibujar);
  else caminos.forEach(function(c){ cuandoSeVea(c, dibujar); });
  var reMedir;
  window.addEventListener('resize', function(){
    clearTimeout(reMedir);
    reMedir = setTimeout(function(){ caminos.forEach(medir); }, 180);
  });

  /* ---------- Reveals: en cuanto asoma el bloque, legible ---------- */
  document.querySelectorAll('.vj-rev').forEach(function(el){
    cuandoSeVea(el, function(e, inmediato){
      // Lo que ya se ve al cargar entra directo, sin fundido de entrada.
      e.classList.add('vj-in');
      if (inmediato) e.classList.add('vj-in--now');
    });
  });

  /* ---------- El reel: tarjeta-cine siempre visible, embed en lightbox ----------
     El embed de Instagram (chrome blanco incluido) rompía la escena. Ahora la
     cara visible es nuestra tarjeta y el embed se abre encima al pulsar play.
     Sin JS, el enlace de la tarjeta sigue llevando a Instagram. */
  var igCard = document.getElementById('vjIgCard');
  var lbReel = document.getElementById('vjLightbox');
  if (igCard && lbReel){
    var embedPedido = false;
    function abrirReel(){
      lbReel.hidden = false;
      document.documentElement.classList.add('vj-lb-abierta');
      if (!embedPedido){
        embedPedido = true;
        var sc = document.createElement('script');
        sc.async = true;
        sc.src = 'https://www.instagram.com/embed.js';
        document.body.appendChild(sc);
      }
      try{ if (window.instgrm) instgrm.Embeds.process(); }catch(e){}
      track('viaje_reel_abierto', {viaje:'lana'});
    }
    function cerrarReel(){
      lbReel.hidden = true;
      document.documentElement.classList.remove('vj-lb-abierta');
    }
    igCard.addEventListener('click', function(ev){
      if (ev.target.closest('a')) return;   // el enlace explícito sigue a Instagram
      ev.preventDefault();
      abrirReel();
    });
    lbReel.addEventListener('click', function(ev){
      if (ev.target === lbReel || ev.target.closest('.vj-lb-cerrar')) cerrarReel();
    });
    window.addEventListener('keydown', function(ev){
      if (ev.key === 'Escape' && !lbReel.hidden) cerrarReel();
    });
  }

  /* ---------- Estación 1: el documental, solo al desplegar ----------
     YouTube no se toca hasta que el lector abre el bloque. */
  var det = document.getElementById('vjDoc');
  if (det){
    det.addEventListener('toggle', function(){
      var caja = det.querySelector('.vj-yt');
      if (!det.open || !caja || caja.dataset.cargado) return;
      caja.dataset.cargado = '1';
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + caja.dataset.yt + '?rel=0';
      f.title = caja.dataset.titulo;
      f.loading = 'lazy';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      f.allowFullscreen = true;
      caja.appendChild(f);
      track('viaje_documental_abierto', {viaje:'lana', video:caja.dataset.yt});
    });
  }
  var monesma = document.getElementById('vjMonesma');
  if (monesma) monesma.addEventListener('click', function(){
    track('viaje_click_monesma', {viaje:'lana'});
  });

  /* ---------- Estación 2: enlaces a las marcas de lujo ---------- */
  document.querySelectorAll('[data-lujo]').forEach(function(a){
    a.addEventListener('click', function(){
      track('viaje_click_lujo', {viaje:'lana', marca:a.dataset.lujo});
    });
  });

  /* ---------- Estación 2: checklist persistente ---------- */
  document.querySelectorAll('[data-check]').forEach(function(c){
    if (state.check[c.dataset.check]) c.checked = true;
    c.addEventListener('change', function(){
      state.check[c.dataset.check] = c.checked;
      save(state);
    });
  });

  /* ---------- Estación 3: el test ---------- */
  var ELOGIO = 'Lo clavaste';
  var SORPRESA = 'Ahí está la sorpresa';

  function resolver(q, elegida, nueva){
    var ok = q.dataset.ok;
    var acertado = elegida === ok;
    q.querySelectorAll('.vj-opt').forEach(function(o){
      o.disabled = true;
      if (o.dataset.o === ok){
        o.classList.add('vj-ok');
        o.insertAdjacentHTML('beforeend', '<span class="vj-mark" aria-hidden="true">✓</span>');
      } else if (o.dataset.o === elegida){
        o.classList.add('vj-ko');
      }
      if (o.dataset.o === elegida) o.setAttribute('aria-pressed','true');
    });
    var r = q.querySelector('.vj-r');
    r.querySelector('.vj-r-badge').textContent = acertado ? ELOGIO : SORPRESA;
    r.hidden = false;
    // setTimeout y no rAF: con la pestaña en segundo plano el rAF se congela
    setTimeout(function(){ r.classList.add('vj-r-on'); }, 30);
    if (nueva){
      state.test[q.dataset.q] = elegida;
      save(state);
      track('viaje_test_respuesta', {viaje:'lana', pregunta:+q.dataset.q, acierto:acertado});
    }
  }

  document.querySelectorAll('.vj-q').forEach(function(q){
    q.querySelectorAll('.vj-opt').forEach(function(o){
      o.addEventListener('click', function(){ resolver(q, o.dataset.o, true); if (window.__vjAlResponder) window.__vjAlResponder(q); });
    });
    if (state.test[q.dataset.q]) resolver(q, state.test[q.dataset.q], false);
  });

  /* ---------- Interludio: la cascada del precio ---------- */
  document.querySelectorAll('.vj-esc-item').forEach(function(item){
    var btn = item.querySelector('.vj-esc-btn');
    var pan = item.querySelector('.vj-esc-p');
    btn.addEventListener('click', function(){
      var abierto = item.hasAttribute('data-abierto');
      if (abierto){ item.removeAttribute('data-abierto'); pan.hidden = true; }
      else {
        item.setAttribute('data-abierto','');
        pan.hidden = false;
        // Solo se mide la primera apertura de cada escalón.
        if (!item.dataset.visto){
          item.dataset.visto = '1';
          track('viaje_cascada_paso', {viaje:'lana', paso:+item.dataset.paso});
        }
      }
      btn.setAttribute('aria-expanded', abierto ? 'false' : 'true');
    });
  });

  /* ---------- Bloque "¿Y por qué no se hace aquí?" (Ramón) ---------- */
  var dosEsc = document.getElementById('vjDosEscaparates');
  if (dosEsc) cuandoSeVea(dosEsc, function(){ track('viaje_dos_escaparates', {viaje:'lana'}); }, {sinPlazo:true});

  var ramon = document.getElementById('por-que-no-aqui');
  if (ramon) cuandoSeVea(ramon, function(){ track('viaje_bloque_ramon', {viaje:'lana'}); }, {sinPlazo:true});
  document.querySelectorAll('.vj-beat').forEach(function(beat){
    var btn = beat.querySelector('.vj-beat-btn');
    var pan = beat.querySelector('.vj-beat-p');
    btn.addEventListener('click', function(){
      var abierto = beat.hasAttribute('data-abierto');
      if (abierto){ beat.removeAttribute('data-abierto'); pan.hidden = true; }
      else {
        beat.setAttribute('data-abierto','');
        pan.hidden = false;
        if (!beat.dataset.visto){
          beat.dataset.visto = '1';
          track('viaje_ramon_beat', {viaje:'lana', beat:+beat.dataset.beat});
        }
      }
      btn.setAttribute('aria-expanded', abierto ? 'false' : 'true');
    });
  });

  /* ---------- Calculadora de coste por uso ----------
     Supuesto declarado: ~50 usos al año. Con 50 € y 4 años → 0,25 €/uso;
     con 20 € y 1 año → 0,40 €/uso. */
  var USOS_ANO = 50;
  var cPrecio = document.getElementById('vjCalcPrecio');
  var cAnos   = document.getElementById('vjCalcAnos');
  if (cPrecio && cAnos){
    var cPrecioV = document.getElementById('vjCalcPrecioV');
    var cAnosV   = document.getElementById('vjCalcAnosV');
    var cRes     = document.getElementById('vjCalcRes');
    var cDetalle = document.getElementById('vjCalcDetalle');
    var medido   = false;
    function eur(n){ return n.toLocaleString('es-ES', {minimumFractionDigits:2, maximumFractionDigits:2}) + ' €'; }
    function pintaTrack(c){
      var pc = (c.value - c.min) / (c.max - c.min) * 100;
      c.style.background = 'linear-gradient(90deg, #b45817 ' + pc + '%, rgba(251,246,236,.18) ' + pc + '%)';
    }
    function calcular(){
      var precio = +cPrecio.value, anos = +cAnos.value, usos = anos * USOS_ANO;
      cPrecioV.textContent = precio + ' €';
      cAnosV.textContent   = anos + (anos === 1 ? ' año' : ' años');
      cRes.textContent     = eur(precio / usos);
      cDetalle.textContent = precio + ' € entre ' + usos + ' usos (unos ' + USOS_ANO + ' al año durante ' + anos + (anos === 1 ? ' año).' : ' años).');
      pintaTrack(cPrecio); pintaTrack(cAnos);
      if (window.gsap) gsap.fromTo(cRes, {scale: 1.05}, {scale: 1, duration: .18, ease: 'power2.out'});
    }
    function medir(){
      if (medido) return;
      medido = true;
      track('viaje_calculadora_uso', {viaje:'lana'});
    }
    [cPrecio, cAnos].forEach(function(c){
      c.addEventListener('input', calcular);
      c.addEventListener('change', medir);
    });
    calcular();
  }

  /* ---------- Frases copiables (estación 4) ---------- */
  document.querySelectorAll('.vj-copiar').forEach(function(b){
    b.addEventListener('click', function(){
      var texto = b.parentElement.querySelector('q').textContent.trim();
      function ok(){
        b.textContent = '¡Copiada!';
        b.classList.add('vj-copiado');
        setTimeout(function(){ b.textContent = 'Copiar'; b.classList.remove('vj-copiado'); }, 2200);
        track('viaje_frase_copiada', {viaje:'lana', frase:+b.dataset.frase});
      }
      if (navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(texto).then(ok, copiaManual);
      } else copiaManual();
      // Navegadores sin Clipboard API (o sin permiso): textarea + execCommand.
      function copiaManual(){
        try{
          var t = document.createElement('textarea');
          t.value = texto;
          t.setAttribute('readonly','');
          t.style.cssText = 'position:absolute;left:-9999px';
          document.body.appendChild(t);
          t.select();
          document.execCommand('copy');
          document.body.removeChild(t);
          ok();
        }catch(e){
          b.textContent = 'Selecciónala';
        }
      }
    });
  });

  /* ---------- E12 · el test como stepper ---------- */
  var stage = document.getElementById('vjStage');
  var pasoActivo = 0;
  if (stage){
    var preguntas = [].slice.call(stage.querySelectorAll('.vj-q'));
    var progTxt = document.getElementById('vjTestProg');
    var navTest = document.getElementById('vjTestNav');
    var btnPrev = document.getElementById('vjTestPrev');
    var btnSig  = document.getElementById('vjTestNext');
    if (navTest) navTest.hidden = false;
    window.__vjIrPregunta = function(i){
      pasoActivo = Math.max(0, Math.min(preguntas.length - 1, i));
      preguntas.forEach(function(qq, k){ qq.classList.toggle('vj-q--activa', k === pasoActivo); });
      if (progTxt) progTxt.textContent = (pasoActivo + 1) + '/5';
      if (btnPrev) btnPrev.disabled = pasoActivo === 0;
      if (btnSig)  btnSig.disabled  = pasoActivo === preguntas.length - 1;
      pintarHiloTest();
    };
    function contestadas(){
      return preguntas.filter(function(qq){ return state.test[qq.dataset.q]; }).length;
    }
    // la barra de progreso es un hilo que se va dibujando (1/5 → 5/5)
    var hiloTest = null;
    function pintarHiloTest(){
      if (!hiloTest || !hiloTest.hebras) return;
      var frac = contestadas() / preguntas.length;
      hiloTest.hebras.forEach(function(h){
        var lh = h.getTotalLength();
        h.style.strokeDasharray = lh;
        h.style.strokeDashoffset = lh * (1 - frac);
        h.style.transition = 'stroke-dashoffset .5s cubic-bezier(.4,0,.2,1)';
      });
      hiloTest.fibras.forEach(function(f){
        f.setAttribute('opacity', parseFloat(f.dataset.en) < frac ? .4 : 0);
      });
    }
    window.__vjMontarHiloTest = function(montar){
      hiloTest = montar(document.getElementById('vjTestHilo'), function(W, H){
        return 'M2,' + (H * .6) + ' C ' + (W * .3) + ',' + (H * .2) + ' ' + (W * .7) + ',' + (H * .9) + ' ' + (W - 2) + ',' + (H * .4);
      }, {fibras: .4, vueltas: 14});
      pintarHiloTest();
    };
    window.__vjAlResponder = function(qq){
      pintarHiloTest();
      var idx = preguntas.indexOf(qq);
      if (idx === pasoActivo && idx < preguntas.length - 1){
        setTimeout(function(){ if (pasoActivo === idx) window.__vjIrPregunta(idx + 1); }, 2100);
      }
    };
    if (btnPrev) btnPrev.addEventListener('click', function(){ window.__vjIrPregunta(pasoActivo - 1); });
    if (btnSig)  btnSig.addEventListener('click', function(){ window.__vjIrPregunta(pasoActivo + 1); });
    // arranca en la primera sin contestar (persistencia del estado)
    var primera = -1;
    preguntas.some(function(qq, k){ if (!state.test[qq.dataset.q]){ primera = k; return true; } return false; });
    window.__vjIrPregunta(primera < 0 ? preguntas.length - 1 : primera);
  }

  /* ---------- E13b · la historia: 25 € tachado y 149 € contando ---------- */
  var hist149 = document.getElementById('vjHist149');
  var hist25c = document.querySelector('.vj-hist-cifra--merc');
