    <!-- ═══════════════════════════════════
         COMUNIDAD — tarjetas con retrato. Testimonios de data/testimonios.json (portada):
         los autorizados con nombre primero y después el mensaje sin nombre (permiso
         pendiente). Sin foto: el sello de la marca, con el mismo tamaño que el retrato.
         Se ven seis; «Ver más» enseña el resto (sin JavaScript se ven todos).
         ═══════════════════════════════════ -->
    <% const comunidad = testimoniosLib.paraPagina('portada'); %>
    <section class="comunidad-v2" id="comunidad">
        <div class="container">
            <div class="comunidad-v2-header">
                <h2>Comunidad</h2>
                <p class="comunidad-v2-sub">Lo que cuentan quienes ya forman parte de la red.</p>
            </div>
            <div class="comunidad-v2-grid oc-comunidad-grid" id="comunidad-grid">
                <% comunidad.forEach(function (t, i) {
                     const nombre = t.nombre || t.firma;
                     let rol = t.nombre ? t.firma : '';
                     if (t.nombre && t.contexto && rol.indexOf('Conecta Lana') === -1) rol += ' · ' + t.contexto; %>
                <div class="testimonio-v2<%= i >= 6 ? ' oc-comunidad-mas' : '' %>">
                    <div class="testimonio-v2-img<%= t.avatar === 'foto' && t.foto ? '' : ' oc-sello-retrato' %>">
                        <% if (t.avatar === 'foto' && t.foto) { %><img src="<%= t.foto %>" alt="<%= t.foto_alt || '' %>" loading="lazy" width="600" height="450"><% } else { %><img src="/assets/images/brand/oc-sello-verde-400.webp" alt="" loading="lazy" width="560" height="560"><% } %>
                    </div>
                    <h4><%= nombre %></h4>
                    <% if (rol) { %><span class="testimonio-role"><% if (t.enlace) { %><a href="<%= t.enlace %>" target="_blank" rel="noopener"><%= rol %></a><% } else { %><%= rol %><% } %></span><% } %>
                    <p class="testimonio-quote">&ldquo;<%= t.texto %>&rdquo;</p>
                </div>
                <% }) %>
            </div>
            <% if (comunidad.length > 6) { %>
            <div class="oc-comunidad-ver"><button type="button" class="btn-ghost" id="comunidad-ver-mas" aria-controls="comunidad-grid" aria-expanded="false" hidden>Ver más mensajes</button></div>
            <% } %>
            <p class="comunidad-v2-disclaimer"><%= testimoniosLib.nota(comunidad) %></p>
        </div>
    </section>
    <script>
    (function () {
        var b = document.getElementById('comunidad-ver-mas'), g = document.getElementById('comunidad-grid');
        if (!b || !g) return;
        g.classList.add('oc-comunidad-plegada'); b.hidden = false;
        b.addEventListener('click', function () {
            var plegada = g.classList.toggle('oc-comunidad-plegada');
            b.setAttribute('aria-expanded', String(!plegada));
            b.textContent = plegada ? 'Ver más mensajes' : 'Ver menos';
        });
    })();
    </script>

