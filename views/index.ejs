    <script>
        // Scroll al top en carga
        document.addEventListener('DOMContentLoaded', function() {
            window.scrollTo(0, 0);

            // ── Hero Image Slider (fading) ──
            const slides = document.querySelectorAll('.hero-slide');
            if (slides.length > 1) {
                let current = 0;
                // Las fotos 2 a 6 se piden de una en una, cuando la anterior ya está en pantalla.
                const cargar = function(img) {
                    if (img && img.dataset.foto) {
                        img.srcset = img.dataset.fotoSrcset;
                        img.src = img.dataset.foto;
                        delete img.dataset.foto;
                        delete img.dataset.fotoSrcset;
                    }
                };
                const preparar = function() { cargar(slides[(current + 1) % slides.length]); };
                if (document.readyState === 'complete') preparar();
                else window.addEventListener('load', preparar);
                setInterval(function() {
                    const siguiente = (current + 1) % slides.length;
                    cargar(slides[siguiente]);
                    if (!slides[siguiente].complete || !slides[siguiente].naturalWidth) return;
                    slides[current].classList.remove('active');
                    current = siguiente;
                    slides[current].classList.add('active');
                    preparar();
                }, 5000);
            }

            // ── Intersection Observer for scroll animations ──
            const animatedEls = document.querySelectorAll('.card-v2, .testimonio-v2, .servicio-featured, .servicio-impulso, .servicio-comunidad');
            if ('IntersectionObserver' in window && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
                animatedEls.forEach(function(el) {
                    el.classList.add('anim-hidden');
                });

                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.remove('anim-hidden');
                            entry.target.classList.add('anim-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });

                animatedEls.forEach(function(el) { observer.observe(el); });
            }
        });

        if (window.history.scrollRestoration) {
            window.history.scrollRestoration = 'manual';
        }

        // GA4 Event Tracking
        function trackCTAClick(service) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
                event: 'click_cta',
                cta_offer: service,
                cta_location: 'home-v2'
            });
        }
    </script>

    <!-- ===== Blog post slide-in card (Artesanía de lujo) ===== -->
    <style>
      .blog-popup{position:fixed;right:24px;bottom:24px;width:340px;max-width:calc(100vw - 32px);background:#fff;border-radius:14px;box-shadow:0 18px 50px rgba(20,20,20,.22),0 4px 14px rgba(20,20,20,.08);overflow:hidden;z-index:9990;font-family:'Manrope',sans-serif;transform:translateY(20px) scale(.96);opacity:0;pointer-events:none;transition:opacity .45s ease,transform .45s ease;border:1px solid rgba(201,168,76,.25)}
      .blog-popup.is-visible{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
      .blog-popup__close{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;border:0;cursor:pointer;font-size:16px;line-height:1;display:flex;align-items:center;justify-content:center;z-index:2;transition:background .2s}
      .blog-popup__close:hover{background:rgba(0,0,0,.8)}
      .blog-popup__link{display:block;text-decoration:none;color:inherit}
      .blog-popup__media{position:relative;height:150px;overflow:hidden;background:#1f1c16}
      .blog-popup__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}
      .blog-popup__link:hover .blog-popup__img{transform:scale(1.05)}
      .blog-popup__badge{position:absolute;top:12px;left:12px;background:rgba(201,168,76,.95);color:#1f1c16;font-size:10px;font-weight:700;letter-spacing:1.5px;padding:5px 10px;border-radius:4px;text-transform:uppercase}
      .blog-popup__body{padding:16px 18px 18px}
      .blog-popup__eyebrow{font-size:11px;color:#8a6f2b;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;margin:0 0 6px}
      .blog-popup__title{font-family:'Newsreader',Georgia,serif;font-size:17px;line-height:1.3;color:#1f1c16;margin:0 0 8px;font-weight:600}
      .blog-popup__excerpt{font-size:13px;color:#5a544a;line-height:1.45;margin:0 0 8px}
      .blog-popup__audio{font-size:12px;color:#8a6f2b;font-weight:600;margin:0 0 12px;padding:6px 10px;background:rgba(201,168,76,.12);border-radius:6px;display:inline-block}
      .blog-popup__cta{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#1F4B3F}
      .blog-popup__cta::after{content:'→';transition:transform .2s}
      .blog-popup__link:hover .blog-popup__cta::after{transform:translateX(4px)}
      @media (max-width:480px){.blog-popup{right:12px;bottom:12px;width:calc(100vw - 24px);border-radius:10px}.blog-popup__media{height:90px}.blog-popup__badge{top:8px;left:8px;font-size:9px;padding:3px 7px}.blog-popup__body{padding:10px 14px 12px}.blog-popup__title{font-size:14px;margin:0 0 4px}.blog-popup__excerpt{display:none}.blog-popup__audio{font-size:11px;margin:0 0 8px;padding:4px 8px}.blog-popup__cta{font-size:12px}.blog-popup__close{width:24px;height:24px;font-size:14px;top:6px;right:6px}}
    </style>
    <div class="blog-popup" id="blog-popup" role="dialog" aria-label="Conecta Lana" aria-hidden="true">
      <button class="blog-popup__close" id="blog-popup-close" aria-label="Cerrar">×</button>
      <a class="blog-popup__link" href="/conecta-lana?oc_source=home&amp;oc_medium=popup&amp;oc_campaign=conecta-lana">
        <div class="blog-popup__media">
          <img class="blog-popup__img" src="/assets/images/portada/conecta-lana-720.webp" alt="Rebaño de ovejas en una dehesa española al atardecer" loading="lazy">
          <span class="blog-popup__badge">Nuevo</span>
        </div>
        <div class="blog-popup__body">
          <p class="blog-popup__eyebrow">Conecta Lana · Lana española</p>
          <h3 class="blog-popup__title">El punto de encuentro de la lana española</h3>
          <p class="blog-popup__excerpt">¿Tienes lana o la buscas? Te ponemos en contacto con la otra parte —para textil o para el campo—. Gratis, sin comisión por la lana.</p>
          <span class="blog-popup__cta">Entrar en Conecta Lana</span>
        </div>
      </a>
    </div>
    <script>
      (function(){
        var KEY='oc_popup_conecta_lana_dismissed';
        try{ if(sessionStorage.getItem(KEY)) return; }catch(e){}
        var el=document.getElementById('blog-popup');
        var btn=document.getElementById('blog-popup-close');
        if(!el||!btn) return;
        function dismiss(){ el.classList.remove('is-visible'); el.setAttribute('aria-hidden','true'); try{sessionStorage.setItem(KEY,'1');}catch(e){} }
        btn.addEventListener('click',function(ev){ ev.preventDefault(); ev.stopPropagation(); dismiss(); });
        el.querySelector('.blog-popup__link').addEventListener('click',function(){ try{sessionStorage.setItem(KEY,'1');}catch(e){} });
        setTimeout(function(){ el.classList.add('is-visible'); el.setAttribute('aria-hidden','false'); }, 4000);
      })();
    </script>
</body>
</html>
