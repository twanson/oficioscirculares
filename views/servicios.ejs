<%
// Una vista para tres páginas: /servicios (las dos puertas), /servicios/talleres y /servicios/empresas.
// Cada puerta muestra SOLO sus servicios y sus precios (data/precios.json).
// Componentes de Impulso 3D (impulso-3d.css) y de la portada (home-v2.css); ajustes mínimos en oc-puertas.css.
const P = precios;
const meta = {
  index:    { title: 'Servicios | Oficios Circulares', canonical: '/servicios',
              description: 'Dos entradas: si eres un taller o una marca artesana, o si eres una empresa con materiales y procesos que quieres hacer circulares.' },
  talleres: { title: 'Servicios para talleres y marcas artesanas | Oficios Circulares', canonical: '/servicios/talleres',
              description: 'El Club de Oficios Circulares, el Diagnóstico 3D para talleres y el Impulso 3D. Precio único para cada servicio.' },
  empresas: { title: 'Servicios para empresas | Oficios Circulares', canonical: '/servicios/empresas',
              description: 'Diagnóstico 3D para empresas, Roadmap 3D y Sprint 3D: de detectar una mejora circular a ponerla en marcha y contarla.' }
}[puerta];

// Precio con jerarquía: cifra grande, € y periodo; si aún no hay precio, el texto público.
function precio(clave) {
  const s = P.get(clave);
  if (s.importe == null) return '<span class="value value--texto">' + P.texto(clave) + '</span>';
  let h = '<span class="value">' + Number(s.importe).toLocaleString('es-ES') + '</span><span class="currency">&euro;</span>';
  if (s.periodo) h += '<span class="price-periodo">/' + s.periodo + '</span>';
  if (s.iva) h += ' <span class="precio-iva">+ IVA</span>';
  return h;
}
const ICONOS = {
  club: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  lupa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  megafono: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 13v-2z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>',
  mapa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>',
  rayo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>'
};
%>
<%- include('partials/head-meta', Object.assign({ cssPrevios: ['/assets/css/impulso-3d.css?v=20260320b'] }, meta)) %>
<link rel="stylesheet" href="/assets/css/home-v2.css?v=V2_20260628b">
<link rel="stylesheet" href="/assets/css/oc-puertas.css?v=20261122a">
<%- include('partials/header') %>

<main class="main-content impulso-3d oc-pagina" id="maincontent">
<% if (puerta === 'index') { %>
    <%- include('partials/oc-hero', {
        badge: 'Servicios',
        titulo: '&iquest;Por d&oacute;nde entras?',
        subtitulo: 'Oficios Circulares conecta a quien tiene materiales de oficio sin salida con los talleres que pueden usarlos. Los servicios acompa&ntilde;an a esa red: elige la puerta que te corresponde.',
        ctas: [
            { href: '/servicios/talleres', texto: 'Soy un taller &rarr;', clase: 'btn-coral', label: 'servicios-hero-talleres' },
            { href: '/servicios/empresas', texto: 'Soy una empresa', clase: 'btn-outline-white', label: 'servicios-hero-empresas' }
        ],
        img: '/assets/images/artesanos en taller.jpg',
        alt: 'Dos artesanos trabajando en su taller'
    }) %>

    <section class="impulso-section impulso-section-cream" id="puertas">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Dos puertas</span>
                <h2>Elige c&oacute;mo vienes</h2>
                <p>La red es la base. Los servicios la complementan, con un camino para talleres y otro para empresas.</p>
            </div>
            <%- include('partials/puertas') %>
        </div>
    </section>

    <%- include('partials/metodo-3d', { fondo: 'white' }) %>

    <%- include('partials/oc-cta-band', {
        titulo: 'Tu oficio tiene valor,<br><em>vamos a contarlo</em>',
        texto: 'Empieza por la puerta que te corresponde. Si dudas, escr&iacute;benos y te decimos cu&aacute;l.',
        primario: { href: '/servicios/talleres', texto: 'Servicios para talleres' },
        secundario: { href: '/servicios/empresas', texto: 'Servicios para empresas' }
    }) %>

<% } else if (puerta === 'talleres') { %>
    <%- include('partials/oc-hero', {
        badge: 'Soy un taller o una marca artesana',
        titulo: 'Que tu oficio se entienda y se venda',
        subtitulo: 'Tres formas de trabajar con nosotros, de la m&aacute;s ligera a la m&aacute;s completa. Cada una tiene un precio cerrado.',
        ctas: [
            { href: '#servicios', texto: 'Ver los servicios &rarr;', clase: 'btn-coral' },
            { href: '/servicios/empresas', texto: '&iquest;Eres una empresa?', clase: 'btn-outline-white', label: 'talleres-hero-empresas' }
        ],
        img: '/assets/images/alfarero.jpg',
        alt: 'Alfarero modelando una pieza en su taller'
    }) %>

    <section class="impulso-section impulso-section-cream" id="servicios">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Servicios para talleres</span>
                <h2>Tu camino con Oficios Circulares</h2>
                <p>Empieza por donde te haga falta. Cada servicio funciona por s&iacute; solo y se puede sumar al siguiente.</p>
            </div>
            <div class="pricing-grid">
                <div class="price-card">
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.club %></div>
                        <h3>Club de Oficios Circulares</h3>
                        <p class="subtitle">Comunidad y m&eacute;todo</p>
                        <div class="price-amount"><%- precio('club_mensual') %></div>
                        <p class="price-duration">o <%= P.texto('club_anual') %>. Fundadores: <%= P.texto('club_fundador_mensual') %> o <%= P.texto('club_fundador_anual') %>, con <%= P.plazasFundador() %> plazas.</p>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>Lecciones pr&aacute;cticas para mostrar y vender tu trabajo</li>
                            <li>Un directo al mes con revisiones en vivo</li>
                            <li>Radar de ayudas y biblioteca de plantillas</li>
                        </ul>
                        <a class="btn btn-coral" href="/club">Conocer el Club</a>
                    </div>
                </div>
                <div class="price-card featured">
                    <span class="price-badge">Por d&oacute;nde empezar</span>
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.lupa %></div>
                        <h3>Diagn&oacute;stico 3D para talleres</h3>
                        <p class="subtitle">Sin llamadas</p>
                        <div class="price-amount"><%- precio('diagnostico_talleres') %></div>
                        <p class="price-duration">Respondes un cuestionario y recibes el informe y un v&iacute;deo que te lo explica.</p>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>El mapa de tu taller y de su entorno</li>
                            <li>Lo que ya comunicas y c&oacute;mo est&aacute; tu presencia en internet</li>
                            <li>Tres prioridades ordenadas</li>
                        </ul>
                        <a class="btn btn-coral" href="/servicios/diagnostico-3d">Ver el Diagn&oacute;stico</a>
                    </div>
                </div>
                <div class="price-card">
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.megafono %></div>
                        <h3>Impulso 3D</h3>
                        <p class="subtitle">Tu sistema de comunicaci&oacute;n</p>
                        <div class="price-amount"><%- precio('impulso_3d') %></div>
                        <p class="price-duration">Impulso 3D Completo: <%= P.texto('impulso_3d_completo') %> + IVA</p>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>Tu manual de marca y tus f&oacute;rmulas de contenido</li>
                            <li>Plantillas listas para tu Instagram</li>
                            <li>Sesi&oacute;n de trabajo para que lo uses desde el primer d&iacute;a</li>
                        </ul>
                        <a class="btn btn-coral" href="/impulso-3d">Ver el Impulso 3D</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/metodo-3d', {
        fondo: 'white',
        titulo: 'El M&eacute;todo 3D adaptado a tu taller',
        intro: 'Lo que hay detr&aacute;s de cada servicio: tres pasos, siempre en el mismo orden.',
        fases: [
            { t: 'Diagnosticar', p: 'Miramos tu taller, tus materiales y lo que ya comunicas, y detectamos todo el valor que no est&aacute;s contando.' },
            { t: 'Dise&ntilde;ar', p: 'Lo convertimos en un plan realista: qu&eacute; contar y d&oacute;nde, qu&eacute; mejorar y con qu&eacute; herramientas.' },
            { t: 'Difundir', p: 'Te dejamos un sistema para contarlo con tu voz, de forma constante y sin pasarte el d&iacute;a en redes.' }
        ]
    }) %>

    <section class="impulso-section impulso-section-cream" aria-label="Testimonio">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Experiencias</span>
                <h2>Lo que cuentan quienes ya lo usan</h2>
            </div>
            <%- include('partials/testimonio-blanca') %>
        </div>
    </section>

    <%- include('partials/oc-cta-band', {
        titulo: 'Empieza por saber<br><em>qu&eacute; tienes</em>',
        texto: 'El Diagn&oacute;stico 3D te dice por d&oacute;nde empezar, sin llamadas y con tres prioridades ordenadas.',
        primario: { href: '/servicios/diagnostico-3d', texto: 'Quiero mi Diagn&oacute;stico' },
        secundario: { href: '/club', texto: 'Conocer el Club' }
    }) %>

<% } else { %>
    <%- include('partials/oc-hero', {
        badge: 'Soy una empresa',
        titulo: 'De la idea circular al caso que puedes contar',
        subtitulo: 'Para empresas que fabrican o transforman materiales y quieren detectar una mejora circular, planificarla y ponerla en marcha.',
        ctas: [
            { href: '#servicios', texto: 'Ver los servicios &rarr;', clase: 'btn-coral' },
            { href: '/servicios/talleres', texto: '&iquest;Eres un taller?', clase: 'btn-outline-white', label: 'empresas-hero-talleres' }
        ],
        img: '/assets/images/taller clasico metal.jpg',
        alt: 'Operario trabajando el metal en un taller'
    }) %>

    <section class="impulso-section impulso-section-cream" id="servicios">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Servicios para empresas</span>
                <h2>De detectar a poner en marcha</h2>
                <p>Tres servicios encadenados. Puedes quedarte en el primero o seguir hasta el piloto.</p>
            </div>
            <div class="pricing-grid">
                <div class="price-card featured">
                    <span class="price-badge">Por d&oacute;nde empezar</span>
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.lupa %></div>
                        <h3>Diagn&oacute;stico 3D para empresas</h3>
                        <p class="subtitle">Detectar</p>
                        <div class="price-amount"><%- precio('diagnostico_empresas') %></div>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>Repaso de tus materiales, tu proceso y lo que desechas</li>
                            <li>Oportunidades de mejora y de comunicaci&oacute;n</li>
                            <li>Informe con las oportunidades ordenadas por prioridad</li>
                        </ul>
                        <a class="btn btn-coral" href="/contacto?service=diagnostico-3d-empresas&oc_source=site&oc_medium=internal&oc_campaign=oc-empresas&oc_content=diagnostico&page_path=/servicios/empresas">Solicitar el Diagn&oacute;stico</a>
                    </div>
                </div>
                <div class="price-card">
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.mapa %></div>
                        <h3>Roadmap 3D</h3>
                        <p class="subtitle">Planificar</p>
                        <div class="price-amount"><%- precio('roadmap_3d') %></div>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>Un plan de 90 d&iacute;as para tu primera mejora circular</li>
                            <li>Proveedores, materiales y recursos identificados</li>
                            <li>Plan de comunicaci&oacute;n para contar el proceso</li>
                        </ul>
                        <a class="btn btn-coral" href="/servicios/roadmap-3d">Ver el Roadmap 3D</a>
                    </div>
                </div>
                <div class="price-card">
                    <div class="price-card-header">
                        <div class="problem-icon price-icon"><%- ICONOS.rayo %></div>
                        <h3>Sprint 3D</h3>
                        <p class="subtitle">Poner en marcha</p>
                        <div class="price-amount"><%- precio('sprint_3d') %></div>
                    </div>
                    <div class="price-card-body">
                        <ul class="price-features">
                            <li>Implementamos el piloto contigo</li>
                            <li>Lo documentamos con datos medidos</li>
                            <li>Preparamos los materiales para contarlo</li>
                        </ul>
                        <a class="btn btn-coral" href="/servicios/sprint-3d">Ver el Sprint 3D</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/metodo-3d', {
        fondo: 'white',
        titulo: 'El M&eacute;todo 3D aplicado a tu empresa',
        intro: 'Cada servicio es un paso del m&eacute;todo. Se hacen en orden y cada uno se apoya en el anterior.',
        fases: [
            { t: 'Diagnosticar', p: 'Con el Diagn&oacute;stico 3D repasamos materiales, proceso y residuos, y ordenamos las oportunidades por prioridad.' },
            { t: 'Dise&ntilde;ar', p: 'Con el Roadmap 3D convertimos la oportunidad elegida en un plan de 90 d&iacute;as, con proveedores y recursos.' },
            { t: 'Difundir', p: 'Con el Sprint 3D ponemos en marcha el piloto, lo medimos y preparamos los materiales para contarlo.' }
        ]
    }) %>

    <%- include('partials/oc-cta-band', {
        titulo: 'Convierte una mejora circular<br><em>en un caso que puedes contar</em>',
        texto: 'Empieza por el Diagn&oacute;stico: te decimos qu&eacute; oportunidades tienes y cu&aacute;l conviene hacer primero.',
        primario: { href: '/contacto?service=diagnostico-3d-empresas&oc_source=site&oc_medium=internal&oc_campaign=oc-empresas&oc_content=cta-band&page_path=/servicios/empresas', texto: 'Solicitar el Diagn&oacute;stico' },
        secundario: { href: 'mailto:hola@oficioscirculares.com', texto: 'Prefiero escribir primero' }
    }) %>
<% } %>
</main>

<%- include('partials/footer') %>
<script src="/assets/js/script.js"></script>
</body>
</html>
