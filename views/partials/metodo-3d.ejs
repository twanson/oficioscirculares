<%#
  El Método 3D en tres pasos numerados: componente «El Método 3D» de Impulso 3D (method-phases).
  Parámetros opcionales: label, titulo, intro, fases [{t, p}], fondo ('white' | 'cream').
%>
<%
  var _fases = locals.fases || [
    { t: 'Diagnosticar', p: 'Miramos tu proceso, tus materiales y lo que ya comunicas, y detectamos lo que tiene valor y no se est&aacute; contando.' },
    { t: 'Dise&ntilde;ar', p: 'Convertimos lo que sale del diagn&oacute;stico en un plan realista: qu&eacute; contar, qu&eacute; mejorar y con qu&eacute; herramientas.' },
    { t: 'Difundir', p: 'Lo ponemos en marcha y te dejamos un sistema para contarlo con pruebas, sin exagerar y sin perder horas de trabajo.' }
  ];
%>
<section class="impulso-section impulso-section-<%= locals.fondo || 'white' %>" id="metodo">
    <div class="container">
        <div class="section-header">
            <span class="section-label"><%- locals.label || 'C&oacute;mo trabajamos' %></span>
            <h2><%- locals.titulo || 'El M&eacute;todo 3D' %></h2>
            <% if (locals.intro !== false) { %><p><%- locals.intro || 'Tres pasos, siempre en el mismo orden. Cada uno se apoya en el anterior.' %></p><% } %>
        </div>
        <div class="method-phases">
            <% _fases.forEach(function (f, i) { %>
            <div class="phase-card">
                <div class="phase-number"><%= i + 1 %></div>
                <h3><%- f.t %></h3>
                <p><%- f.p %></p>
            </div>
            <% }) %>
        </div>
    </div>
</section>
