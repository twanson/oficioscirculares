<%#
  Banda final de llamada a la acción: el componente «Transforma tu proyecto» de la portada (cta-v2).
  Parámetros: titulo (HTML), texto, primario {href, texto}, secundario {href, texto} opcional.
  Requiere /assets/css/home-v2.css.
%>
<section class="cta-v2" aria-labelledby="cta-band-title">
    <div class="cta-v2-bg">
        <img src="/assets/images/workshop_tools.jpg" alt="" loading="lazy">
        <div class="cta-v2-overlay"></div>
    </div>
    <div class="cta-v2-content">
        <h2 id="cta-band-title"><%- titulo %></h2>
        <p><%- texto %></p>
        <div class="cta-v2-buttons">
            <a href="<%= primario.href %>" class="btn-cta-primary"><%- primario.texto %></a>
            <% if (locals.secundario) { %><a href="<%= secundario.href %>" class="btn-cta-secondary"><%- secundario.texto %></a><% } %>
        </div>
    </div>
</section>
